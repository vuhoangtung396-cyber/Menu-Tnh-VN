-- SPEED & JUMP
-- ============================================================
local SpeedWalk = { active = false, value = CONFIG.WalkSpeed.Default }
local HighJump  = { active = false, value = CONFIG.Jump.Default }

local function getHumanoid()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function applySpeed()
    local h = getHumanoid()
    if not h or not SpeedWalk.active then return end
    h.WalkSpeed = SpeedWalk.value
    task.delay(0.5, function()
        local hh = getHumanoid()
        if SpeedWalk.active and hh and math.abs(hh.WalkSpeed - SpeedWalk.value) > 0.5 then
            notify("Server đang ghi đè WalkSpeed!", true)
        end
    end)
end

local function applyJump()
    local h = getHumanoid()
