    return nil
end

local function TP(eggPart)
    if not eggPart or not eggPart.Parent then return false end
    local prompt = FindPromptRecursive(eggPart)
    if not prompt and eggPart.Parent then
        prompt = FindPromptRecursive(eggPart.Parent)
    end
    if not prompt and eggPart.Parent and eggPart.Parent.Parent then
        prompt = FindPromptRecursive(eggPart.Parent.Parent)
    end
    if prompt then
        local success = false
        pcall(function()
            if fireproximityprompt then
                fireproximityprompt(prompt, 0)
                success = true
            end
        end)
        if not success then
            pcall(function()
                if fireproximityprompt then
                    fireproximityprompt(prompt, prompt.HoldDuration or 0)
                    success = true
                end
            end)
        end
        if not success then
            pcall(function()
                prompt:InputHoldBegin()
                task.wait(math.max((prompt.HoldDuration or 0.1), 0.1) + 0.05)
                prompt:InputHoldEnd()
                success = true
            end)
        end
        return success
    end
    local cd = eggPart:FindFirstChildOfClass("ClickDetector")
        or (eggPart.Parent and eggPart.Parent:FindFirstChildOfClass("ClickDetector"))
    if not cd and eggPart.Parent then
        for _, d in ipairs(eggPart.Parent:GetDescendants()) do
            if d:IsA("ClickDetector") then cd = d break end
        end
    end
    if cd and fireclickdetector then
        pcall(function() fireclickdetector(cd, 0) end)
        return true
    end
    local c = LP.Character
    if c and firetouchinterest then
        local touched = false
        for _, partName in ipairs({"HumanoidRootPart","Head","UpperTorso","Torso","LeftHand","RightHand","LeftFoot","RightFoot"}) do
            local bp = c:FindFirstChild(partName)
            if bp then
                pcall(function()
                    firetouchinterest(bp, eggPart, 0)
                    task.wait(0.03)
                    firetouchinterest(bp, eggPart, 1)
                end)
                touched = true
            end
        end
        if touched then return true end
    end
    return false
end

