    local function ApplyFixLag()

        for _,obj in ipairs(Workspace:GetDescendants()) do

            pcall(function()

                if obj:IsA("ParticleEmitter")
                or obj:IsA("Trail")
                or obj:IsA("Beam") then

                    if Config.FixLag then

                        if Config.OriginalEffects[obj] == nil then
                            Config.OriginalEffects[obj] = obj.Enabled
                        end

                        obj.Enabled = false

                    else

                        if Config.OriginalEffects[obj] ~= nil then
                            obj.Enabled = Config.OriginalEffects[obj]
                        end

                    end

                elseif obj:IsA("PostEffect") then

                    obj.Enabled = not Config.FixLag

                end

            end)

        end
    end

    task.spawn(function()

        while Gui.Parent do

            if Config.FixLag then
                ApplyFixLag()
            end

            task.wait(2)
        end

    end)

    --------------------------------------------------
    -- AUTO STEAL ENGINE
    --------------------------------------------------

    local function GetPromptPosition(prompt)

        local parent = prompt.Parent

        if parent:IsA("BasePart") then
            return parent.Position
        end

        if parent:IsA("Attachment") then
            return parent.WorldPosition
        end

        if parent:IsA("Model") then

            local pp = parent.PrimaryPart

            if pp then
                return pp.Position
            end

            local part = parent:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

            if part then
                return part.Position
            end
        end

        return nil
    end

    local function IsEggPrompt(prompt)

        local text = string.lower(
            tostring(prompt.ActionText).." "
            ..tostring(prompt.ObjectText).." "
            ..tostring(prompt.Name)
        )

        return
            string.find(text,"steal")
            or string.find(text,"egg")
            or string.find(text,"grab")
            or string.find(text,"take")
    end

    local function FindEggPrompts()

        local results = {}

        for _,obj in ipairs(Workspace:GetDescendants()) do

            if obj:IsA("ProximityPrompt") then

                if IsEggPrompt(obj) then

                    local pos = GetPromptPosition(obj)

                    if pos then

                        table.insert(results,{
                            Prompt = obj,
                            Position = pos
                        })

                    end
                end
            end
        end

        return results
    end

    local function GetNearestEgg()

        if not Root then
            return nil
        end

        local list = FindEggPrompts()

        local nearest
        local distance = math.huge

        for _,egg in ipairs(list) do

            if egg.Prompt.Enabled then

                local d = (
                    Root.Position-egg.Position
                ).Magnitude

                if d < distance then

                    distance = d
                    nearest = egg

                end
            end
        end

        return nearest
    end

    local function StealEgg(egg)

        if not egg or not egg.Prompt then
            return
        end

        if not Root then
            return
        end

        local prompt = egg.Prompt

        if not prompt.Enabled then
            return
        end

        local target = egg.Position

        -- move near egg
        Root.CFrame = CFrame.new(
            target + Vector3.new(0,2.5,0)
        )

        task.wait(.15)

        -- ProximityPrompt
        pcall(function()
            fireproximityprompt(prompt)
        end)

        task.wait(.35)

        pcall(function()
            fireproximityprompt(
                prompt,
                prompt.HoldDuration + .1
            )
        end)

    end

    task.spawn(function()

        while Gui.Parent do

            if Config.AutoSteal then

                local egg = GetNearestEgg()

                if egg then
                    StealEgg(egg)
                end

                task.wait(.5)

            else

                task.wait(.5)

            end

        end

    end)

