-- Update box mỗi frame
Connect(RunService.RenderStepped,function()
    if not State.ESP then
        for _,d in pairs(ESPData) do
            if d.Box then d.Box.Visible=false end
            if d.Name then d.Name.Visible=false end
        end
        return
    end
    local cam=WS.CurrentCamera
    if not cam then return end
    local myChar=LP.Character
    local myRoot=myChar and myChar:FindFirstChild("HumanoidRootPart")
    for p,d in pairs(ESPData) do
        local c=p.Character
        local show=false
        if c and p~=LP then
            local head=c:FindFirstChild("Head")
            local root=c:FindFirstChild("HumanoidRootPart")
            local hum=c:FindFirstChildOfClass("Humanoid")
            if head and root and hum and hum.Health>0 then
                local top=cam:WorldToViewportPoint(head.Position+Vector3.new(0,0.6,0))
                local bot=cam:WorldToViewportPoint(root.Position-Vector3.new(0,2.8,0))
                if top.Z>0 and bot.Z>0 then
                    local h=math.abs(bot.Y-top.Y)
                    local w=math.min(h*0.62,300)
                    local cx=(top.X+bot.X)/2
                    local ty=math.min(top.Y,bot.Y)
                    if w>4 and h>4 then
                        d.Box.Visible=true
                        d.Box.Position=UDim2.new(0,cx-w/2,0,ty)
                        d.Box.Size=UDim2.new(0,w,0,h)
                        d.Stroke.Color=State.ESPColor
                        if State.ESPShowName then
                            d.Name.Visible=true
                            d.Name.TextColor3=State.ESPColor
                            local dist=myRoot and math.floor((root.Position-myRoot.Position).Magnitude) or 0
                            if State.ESPShowDist then
                                d.Name.Text=p.Name.." ["..dist.."m]"
                            else
                                d.Name.Text=p.Name
                            end
                            d.Name.Position=UDim2.new(0,cx-w/2-60,0,ty-20)
                            d.Name.Size=UDim2.new(0,w+120,0,18)
                        else
                            d.Name.Visible=false
                        end
                        show=true
                    end
                end
            end
        end
        if not show then
            if d.Box then d.Box.Visible=false end
            if d.Name then d.Name.Visible=false end
        end
    end
end)

