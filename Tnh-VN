local function copyText(text)
    if setclipboard then
        setclipboard(text or "")
    else
        warn("Executor hiện tại không hỗ trợ setclipboard.")
    end
end

local function askAI(question)
    if AI_ENDPOINT == "" then
        return "Demo: Bạn vừa hỏi:\n\n" .. question ..
               "\n\nĐể AI trả lời thật, hãy cấu hình AI_ENDPOINT trên server/backend của bạn."
    end

    local requestFunc = (syn and syn.request) or (http and http.request) or request or http_request
    if not requestFunc then
        return "Executor không có HTTP request function."
    end

    local ok, result = pcall(function()
        return requestFunc({
            Url = AI_ENDPOINT,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                model = selectedModel,
                message = question
            })
        })
    end)

    if not ok then
        return "Không thể kết nối backend: " .. tostring(result)
    end

    if result and result.Body then
        local decodedOk, data = pcall(function()
            return HttpService:JSONDecode(result.Body)
        end)
        if decodedOk and data then
            return tostring(data.reply or data.message or data.content or result.Body)
        end
        return tostring(result.Body)
    end

    return "Backend không trả về dữ liệu."
end

