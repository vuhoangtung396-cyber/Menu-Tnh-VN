--========================================================--
-- FIX LAG
--========================================================--

local LagCache = {}
local OriginalGlobalShadows = Lighting.GlobalShadows

local function FixLag()

    if Config.FixLag then

        pcall(function()
            Lighting.GlobalShadows = false
        end)

        local Terrain = Workspace:FindFirstChildOfClass("Terrain")

        if Terrain then
            pcall(function()
                Terrain.WaterWaveSize = 0
                Terrain.WaterWaveSpeed = 0
                Terrain.WaterReflectance = 0
                Terrain.WaterTransparency = 1
            end)
        end

        for _, Obj in ipairs(Workspace:GetDescendants()) do

            if Obj:IsA("ParticleEmitter")
                or Obj:IsA("Trail")
                or Obj:IsA("Beam")
                or Obj:IsA("Smoke")
                or Obj:IsA("Fire")
                or Obj:IsA("Sparkles") then

                if LagCache[Obj] == nil then
                    LagCache[Obj] = {
                        Type = "Enabled",
                        Value = Obj.Enabled
                    }
                end

                pcall(function()
                    Obj.Enabled = false
                end)
            end

            if Obj:IsA("BasePart") then

                if LagCache[Obj] == nil then
                    LagCache[Obj] = {
                        Type = "Shadow",
                        Value = Obj.CastShadow
                    }
                end

                pcall(function()
                    Obj.CastShadow = false
                end)
            end
        end

        for _, Obj in ipairs(Lighting:GetDescendants()) do

            if Obj:IsA("PostEffect") then

                if LagCache[Obj] == nil then
                    LagCache[Obj] = {
                        Type = "Enabled",
                        Value = Obj.Enabled
                    }
                end

                pcall(function()
                    Obj.Enabled = false
                end)
            end
        end

        -- Thử giảm chất lượng đồ họa
        pcall(function()
            settings().Rendering.QualityLevel =
                Enum.QualityLevel.Level01
        end)

    else

        pcall(function()
            Lighting.GlobalShadows = OriginalGlobalShadows
        end)

        for Obj, Data in pairs(LagCache) do

            if Obj and Obj.Parent then

                pcall(function()

                    if Data.Type == "Shadow" then
                        Obj.CastShadow = Data.Value
                    else
                        Obj.Enabled = Data.Value
                    end

                end)
            end
        end

        table.clear(LagCache)
    end
end

