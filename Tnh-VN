        for _, name in ipairs(items) do
            if f == "" or string.find(string.lower(name), f, 1, true) then
                local o = Instance.new("TextButton")
                o.Size = UDim2.new(1, 0, 0, 24)
                o.BackgroundColor3 = selected[name] and C.Accent or C.Panel
                o.Text = name .. (selected[name] and "  ✓" or "")
