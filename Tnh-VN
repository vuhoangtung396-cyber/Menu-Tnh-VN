		Size = UDim2.new(1, 0, 0, 14),
		TextColor3 = THEME.Muted,
		LayoutOrder = nextOrder(),
	})
end

local function createSlider(parent, config)
	local slider = {}
	local min, max, current = config.min, config.max, config.initial
	local container = create("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 1, LayoutOrder = nextOrder() }, parent)
	local label = createText(container, config.label, 12, { Size = UDim2.new(1, -66, 0, 18), TextColor3 = THEME.Muted })
	local valueBox = create("TextBox", {
		Size = UDim2.fromOffset(60, 18), Position = UDim2.new(1, -60, 0, 0),
		BackgroundColor3 = THEME.Panel, TextColor3 = THEME.Text, Font = Enum.Font.GothamMedium,
		TextSize = 12, ClearTextOnFocus = false, Text = "",
	}, container)
	addCorner(valueBox, 4)
	local hit = create("Frame", { Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1 }, container)
	local track = create("Frame", { Position = UDim2.new(0, 0, 0.5, -3), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = THEME.Off, BorderSizePixel = 0 }, hit)
	addCorner(track, 3)
	local fill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = THEME.Accent, BorderSizePixel = 0 }, track)
	addCorner(fill, 3)
	local knob = create("Frame", { Size = UDim2.fromOffset(14, 14), BackgroundColor3 = THEME.Text, BorderSizePixel = 0 }, track)
	addCorner(knob, 7)

	local function round(value)
		local factor = 10 ^ config.decimals
		return math.floor(value * factor + 0.5) / factor
	end

	local function render()
		local alpha = (current - min) / (max - min)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.new(alpha, -7, 0.5, -7)
		valueBox.Text = tostring(current)
	end

	function slider.set(value, silent)
		current = round(math.clamp(value, min, max))
		render()
		if not silent then
			config.onChange(current)
		end
	end

	function slider.setRange(newMin, newMax, newValue)
		min, max = newMin, newMax
		slider.set(newValue, true)
	end

	function slider.setLabel(text)
		label.Text = text
	end

	local function setFromPointer(x)
		local alpha = math.clamp((x - hit.AbsolutePosition.X) / math.max(1, hit.AbsoluteSize.X), 0, 1)
		slider.set(min + (max - min) * alpha)
	end

	hit.InputBegan:Connect(function(input)
		if isPointerPress(input) then
			setFromPointer(input.Position.X)
			activeDrag = function(position)
				setFromPointer(position.X)
			end
		end
	end)

	valueBox.FocusLost:Connect(function()
		local number = tonumber(valueBox.Text)
		if not number then
			ui.notify(config.label .. ": enter a number", "error")
			render()
			return
		end
		if number < min or number > max then
			ui.notify(string.format("%s limited to %s - %s", config.label, min, max), "warn")
		end
		slider.set(number)
	end)

	slider.set(current, true)
	return slider
end

local function createDropdown(parent, config)
	local dropdown = { selected = {}, options = {} }
	local container = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, LayoutOrder = nextOrder(),
	}, parent)
	create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, container)
	local header = createButton(container, "", { Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 1, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd })
	local panel = create("Frame", { Size = UDim2.new(1, 0, 0, 140), BackgroundColor3 = THEME.Background, Visible = false, LayoutOrder = 2 }, container)
	addCorner(panel, 6)
	local search = create("TextBox", {
		Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -66, 0, 24), Text = "", PlaceholderText = "Search...",
		ClearTextOnFocus = false, BackgroundColor3 = THEME.Panel, TextColor3 = THEME.Text,
		Font = Enum.Font.GothamMedium, TextSize = 12,
	}, panel)
	addCorner(search, 4)
	local refreshButton = createButton(panel, "Refresh", { Size = UDim2.fromOffset(54, 24), Position = UDim2.new(1, -58, 0, 4), TextSize = 11 })
	local list = create("ScrollingFrame", {
		Position = UDim2.fromOffset(4, 32), Size = UDim2.new(1, -8, 1, -36), BackgroundTransparency = 1,
		BorderSizePixel = 0, ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
	}, panel)
	create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, list)

	local rebuild

	local function updateHeader()
		local names = {}
		for name in pairs(dropdown.selected) do
			names[#names + 1] = name
		end
		table.sort(names)
		local summary = #names == 0 and "none" or table.concat(names, ", ")
		header.Text = config.label .. ": " .. summary .. (panel.Visible and "  ^" or "  v")
	end

	local function choose(option)
		if config.multi then
			dropdown.selected[option] = if dropdown.selected[option] then nil else true
		else
			dropdown.selected = { [option] = true }
			panel.Visible = false
		end
		updateHeader()
		rebuild()
		config.onChange(dropdown.selected)
	end

	rebuild = function()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		local query = search.Text:lower()
		for index, option in ipairs(dropdown.options) do
			if query == "" or option:lower():find(query, 1, true) then
				local mark = dropdown.selected[option] and "[x] " or "[ ] "
				local button = createButton(list, mark .. option, { Size = UDim2.new(1, -4, 0, 22), LayoutOrder = index, TextXAlignment = Enum.TextXAlignment.Left })
				button.BackgroundColor3 = dropdown.selected[option] and THEME.Accent or THEME.Panel
				button.Activated:Connect(function()
					choose(option)
				end)
			end
		end
	end

	function dropdown.refresh()
		dropdown.options = config.getOptions()
		rebuild()
	end

	header.Activated:Connect(function()
		panel.Visible = not panel.Visible
		if panel.Visible then
			dropdown.refresh()
		end
		updateHeader()
	end)
	refreshButton.Activated:Connect(dropdown.refresh)
	search:GetPropertyChangedSignal("Text"):Connect(rebuild)
	updateHeader()
	return dropdown
end

