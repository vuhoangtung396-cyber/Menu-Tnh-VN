--==================================================
-- AUTO FARM LOOP
--==================================================

local function stopAutoFarm()
	State.AutoFarm = false
	State.CurrentFarmTarget = nil

	cancelTween()
	releaseNoclip("AutoFarm")
end

local function autoFarmLoop()
	requestNoclip("AutoFarm")

	while State.AutoFarm do
		if not getRoot() or not isAlive(getCharacter()) then
			task.wait(0.5)
			continue
		end

		local target = State.CurrentFarmTarget

		if not validEnemy(target)
			or getEnemyName(target) ~= State.SelectedEnemy then

			target =
				findNearestEnemy(State.SelectedEnemy)

			State.CurrentFarmTarget = target
		end

		if not target then
			notify("Waiting for enemy to spawn")
			task.wait(CONFIG.Farm.SearchInterval)
			continue
		end

		moveAboveEnemy(target)
		attackTarget(target)

		task.wait(CONFIG.Farm.SearchInterval)
	end

	cancelTween()
	releaseNoclip("AutoFarm")
end

local function setAutoFarm(enabled)
	if enabled then
		if State.SelectedEnemy == nil then
			notify("Hãy chọn enemy trước khi bật Auto Farm.")
			return false
		end

		stopAutoLoot()

		State.AutoFarm = true
		State.CurrentFarmTarget = nil

		task.spawn(autoFarmLoop)

		return true
	end

	stopAutoFarm()

	return true
end

--==================================================
-- LOOT DISCOVERY
--==================================================

local function getLootParts(item)
	local parts = {}

	if item:IsA("BasePart") then
		table.insert(parts, item)
	elseif item:IsA("Model") then
		if item.PrimaryPart then
			table.insert(parts, item.PrimaryPart)
		else
			local part =
				item:FindFirstChildWhichIsA("BasePart")

			if part then
				table.insert(parts, part)
			end
		end
	end

	return parts
end

local function getLootPosition(item)
	local parts = getLootParts(item)

	if #parts == 0 then
		return nil
	end

	return parts[1].Position
end

local function lootSelected(item)
	local name = item.Name

	if State.SelectedLoot[name] then
		return true
	end

	for _, tag in ipairs(CONFIG.Loot.Tags) do
		if CollectionService:HasTag(item, tag)
			and State.SelectedLoot[tag] then

			return true
		end
	end

	return false
end

local function getLootItems()
	local result = {}
	local seen = {}

	for _, tag in ipairs(CONFIG.Loot.Tags) do
		for _, item in ipairs(
			CollectionService:GetTagged(tag)
		) do

			if item:IsDescendantOf(workspace)
				and not seen[item] then

				seen[item] = true
				table.insert(result, item)
			end
		end
	end

	return result
end

local function findNearestLoot()
	local root = getRoot()

	if not root then
		return nil
	end

	local nearest = nil
	local nearestDistance = math.huge

	for _, item in ipairs(getLootItems()) do
		local position = getLootPosition(item)

		if position and lootSelected(item) then
			local distance =
				(root.Position - position).Magnitude

			if distance < nearestDistance then
				nearest = item
				nearestDistance = distance
			end
		end
	end

	return nearest
end

--==================================================
-- LOOT INTERACTION
--==================================================

local function collectLoot(item)
	if not item or not item.Parent then
		return
	end

	local prompt =
		item:FindFirstChildWhichIsA(
			"ProximityPrompt",
			true
		)

	if prompt and prompt.Enabled then
		-- Chỉ sử dụng cơ chế interaction có sẵn.
		-- Không tạo RemoteEvent.
		notify("Loot có ProximityPrompt: " .. item.Name)
		return
	end

	local clickDetector =
		item:FindFirstChildWhichIsA(
			"ClickDetector",
			true
		)

	if clickDetector then
		notify("Loot có ClickDetector: " .. item.Name)
		return
	end

	-- Không có interaction hợp lệ thì không tự giả lập collection.
end

--==================================================
-- AUTO LOOT LOOP
--==================================================

local function stopAutoLoot()
	State.AutoLoot = false
	State.CurrentLootTarget = nil

	cancelTween()
	releaseNoclip("AutoLoot")
end

local function autoLootLoop()
	requestNoclip("AutoLoot")

	while State.AutoLoot do
		if not getRoot() or not isAlive(getCharacter()) then
			task.wait(0.5)
			continue
		end

		local item = State.CurrentLootTarget

		if not item
			or not item.Parent
			or not item:IsDescendantOf(workspace) then

			item = findNearestLoot()
			State.CurrentLootTarget = item
		end

		if not item then
			notify("Waiting for loot to spawn")
			task.wait(CONFIG.Loot.SearchInterval)
			continue
		end

		local position = getLootPosition(item)

		if not position then
			State.CurrentLootTarget = nil
			task.wait()
			continue
		end

		local root = getRoot()

		if not root then
			task.wait()
			continue
		end

		local distance =
			(root.Position - position).Magnitude

		if distance > CONFIG.Loot.StopDistance then
			tweenTo(
				position,
				CONFIG.Loot.TweenSpeed
			)
		end

		collectLoot(item)

		if not item.Parent
			or not item:IsDescendantOf(workspace) then

			State.CurrentLootTarget = nil
		end

		task.wait(CONFIG.Loot.SearchInterval)
	end

	cancelTween()
	releaseNoclip("AutoLoot")
end

local function setAutoLoot(enabled)
	if enabled then
		if next(State.SelectedLoot) == nil then
			notify("Hãy chọn ít nhất một loại loot.")
			return false
		end

		stopAutoFarm()

		State.AutoLoot = true
		State.CurrentLootTarget = nil

		task.spawn(autoLootLoop)

		return true
	end

	stopAutoLoot()

	return true
end

--==================================================
-- ESP
--==================================================

local function clearESP(player)
	local data = State.ESPObjects[player]

	if not data then
		return
	end

	for _, connection in ipairs(data.Connections) do
		connection:Disconnect()
	end

	for _, object in ipairs(data.Objects) do
		object:Destroy()
	end

	State.ESPObjects[player] = nil
end

local function shouldESPPlayer(player)
	if player == LocalPlayer then
		return false
	end

	if CONFIG.ESP.HideSameTeam
		and LocalPlayer.Team ~= nil
		and player.Team == LocalPlayer.Team then

		return false
	end

	return true
end

local function createESP(player)
	if not State.ESP or not shouldESPPlayer(player) then
		return
	end

	clearESP(player)

	local character = player.Character
	local humanoid =
		character and character:FindFirstChildOfClass(
			"Humanoid"
		)

	local root =
		character and character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not character or not humanoid or not root then
		return
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "ClientPlayerESP"
	highlight.Adornee = character
	highlight.FillColor = CONFIG.ESP.FillColor
	highlight.OutlineColor = CONFIG.ESP.OutlineColor
	highlight.FillTransparency = 0.75
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = character

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ClientPlayerESPInfo"
	billboard.Adornee = root
	billboard.Size = UDim2.fromOffset(190, 60)
	billboard.StudsOffset = Vector3.new(0, 3.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = root

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.5
	label.TextSize = 12
	label.Font = Enum.Font.GothamBold
	label.Parent = billboard

	State.ESPObjects[player] = {
		Objects = {
			highlight,
			billboard,
		},

		Connections = {},

		Label = label,
		Humanoid = humanoid,
		Root = root,
	}
end

local function updateESP()
	local localRoot = getRoot()

	if not localRoot then
		return
	end

	for player, data in pairs(State.ESPObjects) do
		local root = data.Root
		local humanoid = data.Humanoid

		if not root
			or not root.Parent
			or not humanoid
			or not humanoid.Parent then

			clearESP(player)
			continue
		end

		local distance =
			(root.Position - localRoot.Position).Magnitude

		local health =
			math.max(0, humanoid.Health)

		local maxHealth =
			math.max(1, humanoid.MaxHealth)

		local text = {}

		if CONFIG.ESP.ShowNames then
			table.insert(
				text,
				player.DisplayName
			)
		end

		if CONFIG.ESP.ShowDistance then
			table.insert(
				text,
				string.format(
					"%.0f studs",
					distance
				)
			)
		end

		if CONFIG.ESP.ShowHealth then
			table.insert(
				text,
				string.format(
					"HP %.0f/%.0f",
					health,
					maxHealth
				)
			)
		end

		data.Label.Text =
			table.concat(text, " | ")
	end
end

local function setESP(enabled)
	State.ESP = enabled

	if not enabled then
		disconnect(State.Connections.ESPPlayerAdded)
		disconnect(State.Connections.ESPPlayerRemoving)
		disconnect(State.Connections.ESPCharacter)

		for player in pairs(State.ESPObjects) do
			clearESP(player)
		end

		return
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			createESP(player)
		end
	end

	State.Connections.ESPPlayerAdded =
		Players.PlayerAdded:Connect(function(player)
			player.CharacterAdded:Connect(function()
				task.wait(0.4)
				createESP(player)
			end)
		end)

	State.Connections.ESPPlayerRemoving =
		Players.PlayerRemoving:Connect(clearESP)
end

