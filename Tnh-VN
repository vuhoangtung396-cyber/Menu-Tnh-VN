-- =====================================================================
local menuMaid = createMaid()
local layoutCounter = 0
local activeDrag = nil

local function nextOrder()
	layoutCounter += 1
	return layoutCounter
end

local function isPointerPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function connectDragEvents()
	menuMaid.add(UserInputService.InputChanged:Connect(function(input)
		local isMove = input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		if activeDrag and isMove then
			activeDrag(Vector2.new(input.Position.X, input.Position.Y))
		end
	end))
	menuMaid.add(UserInputService.InputEnded:Connect(function(input)
		if isPointerPress(input) then
			activeDrag = nil
		end
	end))
end

local function makeDraggable(handle, target)
	handle.InputBegan:Connect(function(input)
		if not isPointerPress(input) then
			return
		end
		local startPointer = Vector2.new(input.Position.X, input.Position.Y)
		local startX, startY = target.Position.X.Offset, target.Position.Y.Offset
		activeDrag = function(position)
			local screen = ui.gui.AbsoluteSize
			local delta = position - startPointer
			local x = math.clamp(startX + delta.X, 0, math.max(0, screen.X - target.AbsoluteSize.X))
			local y = math.clamp(startY + delta.Y, 0, math.max(0, screen.Y - 32))
			target.Position = UDim2.fromOffset(x, y)
		end
	end)
end

local function createSection(parent, text)
	createText(parent, string.upper(text), 11, {
		Size = UDim2.new(1, 0, 0, 18),
		TextColor3 = THEME.Accent,
		LayoutOrder = nextOrder(),
	})
end

local function createToggleRow(parent, labelText, onClick)
	local row = create("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, LayoutOrder = nextOrder() }, parent)
	createText(row, labelText, 13, { Size = UDim2.new(1, -54, 1, 0) })
