		Position = UDim2.new(1, -46, 0.5, -11),
	})
	button.Activated:Connect(onClick)
	local toggle = {}
	function toggle.set(isOn)
		button.Text = isOn and "ON" or "OFF"
		button.BackgroundColor3 = isOn and THEME.On or THEME.Off
