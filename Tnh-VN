local PBtns={}
local function RPL()
    for _,d in pairs(PBtns) do if d.Button then d.Button:Destroy() end end
    PBtns={}
    local all=Scan()
    local uq={}
    for _,e in ipairs(all) do
        local k=e.real or e.name
        if not uq[k] and GI(k) then uq[k]=GI(k) end
    end
    if not next(uq) then
        local nl=Instance.new("TextLabel")
        nl.Size=UDim2.new(1,-10,0,28);nl.BackgroundTransparency=1
        nl.Text="Không có trứng trong server";nl.TextColor3=P.Danger
        nl.TextSize=11;nl.Parent=PS
        PBtns["__empty"]={Button=nl}
        RB.Text="🔄 Loading Egg";return
    end
    local srt={}
    for n,i in pairs(uq) do table.insert(srt,{name=n,info=i}) end
    table.sort(srt,function(a,b) return PI(a.info.income)>PI(b.info.income) end)
    for _,en in ipairs(srt) do
        local bn=en.name;local inf=en.info
        local b=Instance.new("TextButton")
        b.Size=UDim2.new(1,-8,0,26);b.BackgroundColor3=P.CardHi
        b.BorderSizePixel=0;b.Text="  ☐  "..bn.."   "..(inf.income or "?")
        b.TextColor3=P.TextSec;b.TextSize=11
        b.Font=Enum.Font.Gotham;b.TextXAlignment=Enum.TextXAlignment.Left
        b.AutoButtonColor=false;b.Parent=PS
        Corner(b,6)
        local sel=S.PriorityEggs[bn] and true or false
        if sel then b.BackgroundColor3=P.Yellow;b.TextColor3=Color3.fromRGB(30,25,45)
        b.Text="  ☑  "..bn.."   "..(inf.income or "?") end
        local function SS(v)
            sel=v
            if v then
                S.PriorityEggs[bn]=true
                b.BackgroundColor3=P.Yellow;b.TextColor3=Color3.fromRGB(30,25,45)
                b.Text="  ☑  "..bn.."   "..(inf.income or "?")
            else
                S.PriorityEggs[bn]=nil
                b.BackgroundColor3=P.CardHi;b.TextColor3=P.TextSec
                b.Text="  ☐  "..bn.."   "..(inf.income or "?")
            end
        end
        b.MouseButton1Click:Connect(function() SS(not sel) end)
        PBtns[bn]={Button=b,SetState=SS}
    end
    RB.Text="🔄 Loading Egg ("..#srt..")"
end
RB.MouseButton1Click:Connect(function()
