-- EGG HELPERS
local function PI(s)
if not s then return 0 end
local n=tonumber((s:gsub("[^%d%.]",""))) or 0
local u=s:upper()
if u:find("K") then n=n*1e3 end
if u:find("M") then n=n*1e6 end
if u:find("B") then n=n*1e9 end
return n end
local function GI(name)
if not name or name=="" then return nil end
if EggData[name] then return EggData[name] end
if EggData[name.." Egg"] then return EggData[name.." Egg"] end
local low=name:lower()
for k,v in pairs(EggData) do if k:lower()==low then return v end end
for k,v in pairs(EggData) do if v.pet and v.pet:lower()==low then return v end end
local ne=low:gsub("%s*egg%s*$","")
for k,v in pairs(EggData) do
if k:lower():gsub("%s*egg%s*$","")==ne then return v end end
for k,v in pairs(EggData) do
if #low>3 and low:find(k:lower(),1,true) then return v end
if v.pet and #low>3 and low:find(v.pet:lower(),1,true) then return v end end
return nil end
local function RGN(p)
for depth=1,5 do
if not p then break end
for _,d in ipairs(p:GetDescendants()) do
if d:IsA("BillboardGui") and d.Name~="TnhVN_EggESP" then
for _,t in ipairs(d:GetDescendants()) do
if t:IsA("TextLabel") and t.Text~="" then
local n,pr=t.Text:match("^(.-)%s*[—%-–]%s*(%$[%d%.,]+[KMB]?/?s?)$")
if n and pr then return n:gsub("^%s+",""):gsub("%s+$",""),pr end
local pn=t.Text:match("^(.-)%s*[—%-–]")
if pn and #pn>1 and #pn<40 then return pn:gsub("^%s+",""):gsub("%s+$",""),t.Text end
end end end end
p=p.Parent end
return nil,nil end
local function RAN(p)
for depth=1,3 do
if not p then break end
for _,an in ipairs({"EggName","PetName","EggType","PetType","Name","Type","Pet"}) do
local ok,v=pcall(function() return p:GetAttribute(an) end)
if ok and typeof(v)=="string" and #v>1 and #v<40 then return v end end
for _,c in ipairs(p:GetChildren()) do
if c:IsA("StringValue") and #c.Value>1 and #c.Value<40 then return c.Value end end
p=p.Parent end
return nil end
local function Scan(radius)
local eggs,seen={},{}
local c=LP.Character
local r=c and c:FindFirstChild("HumanoidRootPart")
local pos=r and r.Position
local cands={}
if radius and pos then
local params=OverlapParams.new()
params.FilterType=Enum.RaycastFilterType.Exclude
params.FilterDescendantsInstances=c and {c} or {}
local ok,p=pcall(function() return WS:GetPartBoundsInRadius(pos,radius,params) end)
if ok and p then cands=p end
else cands=WS:GetDescendants() end
for _,o in ipairs(cands) do
if o:IsA("BasePart") and not seen[o] then
local n=o.Name:lower()
local isEgg=(n:find("egg") or n:find("trứng"))
and not n:find("machine") and not n:find("fuse") and not n:find("zone")
and not n:find("shop") and not n:find("display") and not n:find("decor")
and not n:find("sign") and not n:find("label") and not n:find("billboard")
if isEgg then
local a,ic=o.Parent,false
for _=1,5 do
if not a or a==WS then break end
if a:FindFirstChildOfClass("Humanoid") then ic=true;break end
a=a.Parent end
if not ic then
local hP=o:FindFirstChildOfClass("ProximityPrompt") or (o.Parent and o.Parent:FindFirstChildOfClass("ProximityPrompt"))
local hC=o:FindFirstChildOfClass("ClickDetector") or (o.Parent and o.Parent:FindFirstChildOfClass("ClickDetector"))
local hB=false
for _,dd in ipairs(o:GetDescendants()) do
if dd:IsA("BillboardGui") and dd.Name~="TnhVN_EggESP" then hB=true;break end end
if hP or hC or hB then
seen[o]=true
local rn,gt=RGN(o)
if not rn then rn=RAN(o) end
if not rn or rn=="" then rn=o.Name end
table.insert(eggs,{name=o.Name,real=rn,part=o,info=GI(rn),gameText=gt}) end end end end end end
return eggs end

