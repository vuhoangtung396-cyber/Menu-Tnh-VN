    local function Lower(str)
        return string.lower(tostring(str or ""))
    end

    local function IsEggObject(obj)

        local n = Lower(obj.Name)

        return
            n:find("egg") ~= nil
            or n:find("trung") ~= nil
            or n:find("carryareaegg") ~= nil
    end

    local function PromptLooksLikeEgg(prompt)

        local s =
            Lower(prompt.Name).." "
            ..Lower(prompt.ActionText).." "
            ..Lower(prompt.ObjectText)

        return
            s:find("egg") ~= nil
            or s:find("trung") ~= nil
            or s:find("steal") ~= nil
            or s:find("take") ~= nil
            or s:find("grab") ~= nil
            or s:find("carry") ~= nil
    end

    local function GetPart(obj)

        if not obj then
            return nil
        end

        if obj:IsA("BasePart") then
            return obj
        end

        if obj:IsA("Attachment") then
            return obj.Parent
        end

        if obj:IsA("Model") then

            return
                obj.PrimaryPart
                or obj:FindFirstChildWhichIsA(
                    "BasePart",
                    true
                )
        end

        local model =
            obj:FindFirstAncestorOfClass("Model")

        if model then

            return
                model.PrimaryPart
                or model:FindFirstChildWhichIsA(
                    "BasePart",
                    true
                )
        end

        return nil
    end

    local function FindEgg()

        local char = LP.Character
        local root =
            char and
            char:FindFirstChild(
                "HumanoidRootPart"
            )

        if not root then
            return nil
        end

        local best
        local bestDistance = math.huge

        for _,obj in ipairs(
            Workspace:GetDescendants()
        ) do

            -- ProximityPrompt
            if obj:IsA("ProximityPrompt")
            and obj.Enabled
            and PromptLooksLikeEgg(obj) then

                local part = GetPart(obj)

                if part then

                    local d =
                        (root.Position -
                        part.Position).Magnitude

                    if d < bestDistance then

                        bestDistance = d

                        best = {
                            Type = "Prompt",
                            Object = obj,
                            Part = part
                        }
                    end
                end
            end
        end

        -- Egg model without prompt
        if not best then

            for _,obj in ipairs(
                Workspace:GetDescendants()
            ) do

                if obj:IsA("Model")
                and IsEggObject(obj) then

                    local prompt =
                        obj:FindFirstChildWhichIsA(
                            "ProximityPrompt",
                            true
                        )

                    local part = GetPart(obj)

                    if prompt
                    and prompt.Enabled
                    and part then

                        local d =
                            (root.Position -
                            part.Position).Magnitude

                        if d < bestDistance then

                            bestDistance = d

                            best = {
                                Type = "Prompt",
                                Object = prompt,
                                Part = part
                            }
                        end
                    end
                end
            end
        end

        return best
    end

    local function FireEgg(target)

        if not target then
            return false
        end

        local prompt = target.Object

        if prompt:IsA("ProximityPrompt") then

            pcall(function()
                prompt.HoldDuration = 0
            end)

            if typeof(fireproximityprompt)
                == "function" then

                local ok =
                    pcall(function()
                        fireproximityprompt(prompt)
                    end)

                if ok then
                    return true
                end
            end
        end

        return false
    end

    --====================================================
    -- BASE FINDER
    --====================================================

    local function FindBase()

        local possible = {
            "MyBase",
            "PlayerBase",
            "Base",
            "Home",
            "Plot",
            "Nest",
            "SafeZone",
            "Safe"
        }

        -- First search exact player name
        for _,obj in ipairs(
            Workspace:GetDescendants()
        ) do

            local n = Lower(obj.Name)

            if n == Lower(LP.Name)
            or n == Lower(LP.DisplayName)
            or n:find(Lower(LP.Name),1,true) then

                if obj:IsA("Model")
                or obj:IsA("BasePart") then

                    local p = GetPart(obj)

                    if p then
                        return p
                    end
                end
            end
        end

        -- Then common base names
        for _,name in ipairs(possible) do

            for _,obj in ipairs(
                Workspace:GetDescendants()
            ) do

                if Lower(obj.Name) ==
                    Lower(name) then

                    local p = GetPart(obj)

                    if p then
                        return p
                    end
                end
            end
        end

        return nil
    end

    --====================================================
    -- MOVEMENT
    --====================================================

    local function StopVelocity()

        local char = LP.Character

        if not char then
            return
        end

        local root =
            char:FindFirstChild(
                "HumanoidRootPart"
            )

        if root then

            pcall(function()
                root.AssemblyLinearVelocity =
                    Vector3.zero
            end)
        end
    end

    local function TweenTo(position)

        local char = LP.Character

        if not char then
            return false
        end

        local root =
            char:FindFirstChild(
                "HumanoidRootPart"
            )

        if not root then
            return false
        end

        local distance =
            (root.Position-position).Magnitude

        -- movement speed used by Auto Steal
        local speed = 120

        local duration =
            math.clamp(
                distance/speed,
                .12,
                2.5
            )

        local tween =
            TweenService:Create(
                root,
                TweenInfo.new(
                    duration,
                    Enum.EasingStyle.Linear
                ),
                {
                    CFrame =
                        CFrame.new(
                            position +
                            Vector3.new(0,2.5,0)
                        )
                }
            )

        local done = false

        tween.Completed:Connect(function()
            done = true
        end)

        tween:Play()

        local timeout =
            tick()+duration+.5

        while not done
        and tick()<timeout
        and AUTO_STEAL do

            task.wait()
        end

        pcall(function()
            tween:Cancel()
        end)

        StopVelocity()

        return AUTO_STEAL
    end

    --====================================================
    -- AUTO STEAL LOOP
    --====================================================

    local StealThread = nil

    local function StartAutoSteal()

        if StealThread then
            return
        end

        StealThread = true

        task.spawn(function()

            while AUTO_STEAL do

                local char = LP.Character
                local root =
                    char and
                    char:FindFirstChild(
                        "HumanoidRootPart"
                    )

                if root then

                    -- 1. FIND EGG
                    local target =
                        FindEgg()

                    if target
                    and target.Part
                    and target.Part.Parent then

                        -- 2. GO TO EGG
                        TweenTo(
                            target.Part.Position
                        )

                        if not AUTO_STEAL then
                            break
                        end

                        task.wait(.08)

                        -- 3. STEAL
                        FireEgg(target)

                        task.wait(.35)

                        if not AUTO_STEAL then
                            break
                        end

                        -- 4. FIND BASE
                        local base =
                            FindBase()

                        if base then

                            -- 5. RETURN BASE
                            TweenTo(base.Position)

                            task.wait(.35)
                        end

                    else

                        task.wait(.25)
                    end
                end

                task.wait(.12)
            end

            StealThread = nil
        end)
    end

