function OpenPg(n)
    for x,p in pairs(Pages) do p.Visible=(x==n) end
    for x,d in pairs(Btns) do
        if x==n then
            d.Btn.BackgroundColor3=P.CardHi;d.Icon.TextColor3=P.Gold;d.Text.TextColor3=P.Gold
            d.Text.Font=Enum.Font.GothamBold;d.Ind.Size=UDim2.new(0,3,0,20)
        else
            d.Btn.BackgroundColor3=P.Sidebar;d.Icon.TextColor3=P.TextSec;d.Text.TextColor3=P.TextSec
            d.Text.Font=Enum.Font.GothamMedium;d.Ind.Size=UDim2.new(0,3,0,0)
        end
    end
end
