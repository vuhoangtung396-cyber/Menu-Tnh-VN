LC=LG.DescendantAdded:Connect(function(o) if S.FixLag then task.defer(function() DE(o) end) end end) end
local function SPF()
if not S.FixLag then return end
S.FixLag=false
if XC then XC:Disconnect();XC=nil end
if LC then LC:Disconnect();LC=nil end
for o,v in pairs(Saved) do
if typeof(o)=="Instance" and o.Parent then
pcall(function()
if v.t=="e" then o.Enabled=v.v
elseif v.t=="tx" then o.Texture=v.v
elseif v.t=="bp" then
if v.CS~=nil then o.CastShadow=v.CS end
if v.MT~=nil then o.Material=v.MT end
if v.RF~=nil then o.Reflectance=v.RF end
elseif v.t=="v" then o.Volume=v.v end end) end end
for k,v in pairs(Saved) do
