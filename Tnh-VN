-- Called while Auto Loot is within range of `item` (BasePart or Model).
-- Uses an existing ProximityPrompt if the item has one. Returns true if an interaction started.
local function collectLoot(item)
	local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
	if not prompt then
		-- ClickDetectors cannot be triggered from a LocalScript with official APIs.
		-- Connect your game's own loot logic here if the item has no ProximityPrompt.
		return false
	end
	if not prompt.Enabled then
		return false
	end
	if heldPrompts[prompt] then
		return true
	end
	heldPrompts[prompt] = true
	prompt:InputHoldBegin()
	task.delay(prompt.HoldDuration + 0.1, function()
		if heldPrompts[prompt] then
			heldPrompts[prompt] = nil
			prompt:InputHoldEnd()
		end
	end)
	return true
end

-- =====================================================================
-- LIGHTING OVERRIDE MANAGER (shared by Fix Lag and Full Bright)
-- =====================================================================
local LIGHTING_PRIORITY = { "FixLag", "FullBright" } -- later entries win conflicts
local lightingOverrides = {}
local lightingOriginals = {}

local function applyLightingOverrides()
	local final = {}
	for _, source in ipairs(LIGHTING_PRIORITY) do
		for property, value in pairs(lightingOverrides[source] or {}) do
			final[property] = value
		end
	end
	for property, original in pairs(lightingOriginals) do
		if final[property] == nil then
			Lighting[property] = original
			lightingOriginals[property] = nil
		end
	end
	for property, value in pairs(final) do
		if lightingOriginals[property] == nil then
			lightingOriginals[property] = Lighting[property]
		end
		Lighting[property] = value
	end
end

local function setLightingOverride(source, properties)
	lightingOverrides[source] = properties
	runSafely("Lighting", applyLightingOverrides)
end

local function clearLightingOverride(source)
	lightingOverrides[source] = nil
	runSafely("Lighting", applyLightingOverrides)
end

-- =====================================================================
-- MOVEMENT CONTROLLER (single owner + cancellable tween)
-- =====================================================================
local movement = { owner = nil, tween = nil, tweenRoot = nil, connection = nil }

local function cancelTween()
	if movement.connection then
		movement.connection:Disconnect()
		movement.connection = nil
	end
	if movement.tween then
		movement.tween:Cancel()
		movement.tween:Destroy()
		movement.tween = nil
	end
	movement.tweenRoot = nil
end

local function isTweening()
	return movement.tween ~= nil
end

local function tweenRootTo(root, goal)
	cancelTween()
	local distance = (root.Position - goal.Position).Magnitude
	local duration = math.max(0.05, distance / CONFIG.TweenSpeed)
	local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = goal })
	movement.tween = tween
	movement.tweenRoot = root
	movement.connection = tween.Completed:Connect(function()
		if movement.tween == tween then
			cancelTween()
		end
	end)
	tween:Play()
end

local function claimMovement(owner)
	if movement.owner and movement.owner ~= owner then
		return false
	end
	movement.owner = owner
	return true
end

local function releaseMovement(owner)
	if movement.owner == owner then
		cancelTween()
		movement.owner = nil
	end
end

local function buildFacingCFrame(position, lookTarget, fallbackCFrame)
	local flat = Vector3.new(lookTarget.X - position.X, 0, lookTarget.Z - position.Z)
	if flat.Magnitude < 0.5 then
		return CFrame.new(position) * fallbackCFrame.Rotation
	end
	return CFrame.lookAt(position, position + flat)
end

-- =====================================================================
-- NOCLIP (reference-counted requests)
-- =====================================================================
local noclip = {
	requests = {},
	count = 0,
	stepConnection = nil,
	addedConnection = nil,
	parts = {},
	originals = {},
}

local function trackNoclipPart(instance)
	if instance:IsA("BasePart") then
		noclip.parts[instance] = true
	end
end

local function rebuildNoclipParts(character)
	noclip.parts = {}
	noclip.originals = {}
	if noclip.addedConnection then
		noclip.addedConnection:Disconnect()
		noclip.addedConnection = nil
	end
	if not character then
		return
	end
	for _, descendant in ipairs(character:GetDescendants()) do
		trackNoclipPart(descendant)
	end
	noclip.addedConnection = character.DescendantAdded:Connect(trackNoclipPart)
end

local function applyNoclipStep()
	for part in pairs(noclip.parts) do
		if part.Parent then
			if noclip.originals[part] == nil then
				noclip.originals[part] = part.CanCollide
			end
			part.CanCollide = false
		else
			noclip.parts[part] = nil
		end
	end
end

local function startNoclip()
	rebuildNoclipParts(localPlayer.Character)
	noclip.stepConnection = RunService.Stepped:Connect(applyNoclipStep)
end

local function stopNoclip()
	if noclip.stepConnection then
		noclip.stepConnection:Disconnect()
		noclip.stepConnection = nil
	end
	if noclip.addedConnection then
		noclip.addedConnection:Disconnect()
		noclip.addedConnection = nil
	end
	for part, original in pairs(noclip.originals) do
		if part.Parent then
			part.CanCollide = original
		end
	end
	noclip.originals = {}
	noclip.parts = {}
end

local function requestNoclip(source)
	if noclip.requests[source] then
		return
	end
	noclip.requests[source] = true
	noclip.count += 1
	if noclip.count == 1 then
		startNoclip()
	end
end

local function releaseNoclip(source)
	if not noclip.requests[source] then
		return
	end
	noclip.requests[source] = nil
	noclip.count -= 1
	if noclip.count == 0 then
		stopNoclip()
	end
end

-- =====================================================================
-- SPEED WALK
-- =====================================================================
local speedState = {
	value = CONFIG.WalkSpeed.Default,
	original = nil,
	connection = nil,
	lastWarning = 0,
}

local function applyWalkSpeed(humanoid)
	if humanoid.WalkSpeed ~= speedState.value then
		humanoid.WalkSpeed = speedState.value
	end
end

local function warnSpeedOverride()
	local now = os.clock()
	if now - speedState.lastWarning < 8 then
		return
	end
	speedState.lastWarning = now
	ui.notify("The game changed WalkSpeed - the server may override this value", "warn")
end

local function stopWatchingSpeed()
	if speedState.connection then
		speedState.connection:Disconnect()
		speedState.connection = nil
	end
end

local function watchWalkSpeed(humanoid)
	stopWatchingSpeed()
	speedState.original = humanoid.WalkSpeed
	speedState.connection = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
		if humanoid.WalkSpeed == speedState.value then
			return
		end
		warnSpeedOverride()
		applyWalkSpeed(humanoid)
	end)
	applyWalkSpeed(humanoid)
end

local function enableSpeedWalk()
	local humanoid = getHumanoid()
	if not humanoid then
		return false, "Character is not ready"
	end
	watchWalkSpeed(humanoid)
	return true
end

local function disableSpeedWalk()
	stopWatchingSpeed()
	local humanoid = getHumanoid()
	if humanoid and speedState.original then
		humanoid.WalkSpeed = speedState.original
	end
	speedState.original = nil
end

local function onSpeedSliderChanged(value)
	speedState.value = value
	local humanoid = getHumanoid()
	if state.enabled.SpeedWalk and humanoid then
		applyWalkSpeed(humanoid)
	end
end

