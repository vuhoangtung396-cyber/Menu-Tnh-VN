local function createNotifier(gui)
	local holder = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 44),
		Size = UDim2.fromOffset(250, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
	}, gui)
	create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, holder)
	local kindColors = { success = THEME.Success, error = THEME.Error, warn = THEME.Warn }
	local recent, queue, counter = {}, {}, 0

	ui.notify = function(text, kind)
		local now = os.clock()
		if state.shutdown or (recent[text] and now - recent[text] < 2) then
			return
		end
		recent[text] = now
		counter += 1
		local label = createText(holder, text, 12, {
			Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 0, LayoutOrder = counter,
			BackgroundColor3 = kindColors[kind or "success"], TextXAlignment = Enum.TextXAlignment.Center,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		addCorner(label, 6)
		queue[#queue + 1] = label
		if #queue > 4 then
			table.remove(queue, 1):Destroy()
		end
		task.delay(CONFIG.NotificationSeconds, function()
			if label.Parent then
				label:Destroy()
			end
		end)
	end
end

local function installUiCallbacks()
	ui.setToggle = function(name, isOn)
		local toggle = ui.toggles[name]
		if toggle then
			toggle.set(isOn)
		end
	end
	ui.setStatus = function(name, text)
		local label = ui.statusLabels[name]
		if label and label.Text ~= text then
			label.Text = text
		end
	end
end

local function addFeatureToggle(parent, name)
	ui.toggles[name] = createToggleRow(parent, DISPLAY_NAMES[name], function()
		setFeature(name, not (state.enabled[name] == true))
	end)
end

