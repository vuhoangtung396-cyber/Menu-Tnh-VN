local ATC,DTs={}
local function DT(o)
    if not o:IsA("BasePart") then return end
    local n=o.Name:lower()
    if n:find("trap") or n:find("bear") or n:find("bẫy") or n:find("spike") or n:find("snare") then
        DTs[o]={CC=o.CanCollide,CT=o.CanTouch}
        pcall(function() o.CanCollide=false;o.CanTouch=false end)
    end
end
local ATt=TG(SPg,TT("antiTrap"),TT("antiTrapD"),function(v)
    S.AntiTrap=v
    if v then
        if ATC then ATC:Disconnect() end
        for _,o in ipairs(W:GetDescendants()) do DT(o) end
        ATC=W.DescendantAdded:Connect(function(o) if S.AntiTrap then DT(o) end end)
    else
        if ATC then ATC:Disconnect();ATC=nil end
        for o,vv in pairs(DTs) do
            if o.Parent then pcall(function() o.CanCollide=vv.CC;o.CanTouch=vv.CT end) end
        end
        DTs={}
    end
end)

