<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Tnh-VN AI</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,Arial,sans-serif;background:#070d1a;color:#eaf2ff;min-height:100vh;overflow:hidden}
body:before{content:"";position:fixed;inset:0;background:radial-gradient(circle at 20% 20%,#07366d55,transparent 35%),radial-gradient(circle at 80% 80%,#0059ff22,transparent 35%);pointer-events:none}
button,input,textarea{font:inherit}.hidden{display:none!important}
#app{position:fixed;right:24px;top:24px;width:min(1120px,calc(100vw - 48px));height:min(720px,calc(100vh - 48px));border:2px solid #0787ff;border-radius:28px;background:#071123ee;box-shadow:0 0 35px #007bff55,0 20px 80px #0009;backdrop-filter:blur(18px);overflow:hidden}
header{height:92px;padding:17px 24px;display:flex;align-items:center;border-bottom:1px solid #147cff55;background:#08172bee}
.logo{width:58px;height:58px;border-radius:16px;background:linear-gradient(145deg,#13b9ff,#0753ff);display:grid;place-items:center;font-size:34px;font-weight:900;box-shadow:0 0 25px #008cff88}
.title{margin-left:18px}.title b{font-size:29px}.title b span{color:#0799ff}.title small{display:block;color:#8daee0;font-size:14px;margin-top:3px}
.headBtns{margin-left:auto;display:flex;gap:10px}.iconBtn{width:48px;height:48px;border-radius:13px;border:1px solid #2389ff77;background:#0b1a33;color:#bcd8ff;font-size:25px;cursor:pointer}
.main{height:calc(100% - 92px);display:flex;gap:12px;padding:16px}
.notes{width:250px;min-width:210px;border:1px solid #1781ff66;border-radius:20px;background:#07152bee;padding:12px;overflow:auto}
.notes h3{margin:5px 10px 12px;color:#dbeaff}.note{display:flex;gap:10px;align-items:center;padding:10px;border-radius:13px;color:#9ebde8;cursor:pointer}.note:hover,.note.active{background:#0869d955;color:#fff}.num{width:29px;height:29px;border-radius:50%;border:1px solid #168aff;display:grid;place-items:center;color:#d8ecff;font-size:13px}
.chat{flex:1;border:1px solid #1781ff66;border-radius:22px;background:#07152bee;padding:16px;display:flex;flex-direction:column;min-width:0}
.models{display:flex;gap:9px;overflow:auto;padding-bottom:12px}.model{white-space:nowrap;padding:12px 17px;border-radius:22px;border:1px solid #147bff77;background:#091a36;color:#b5cff4;cursor:pointer}.model.active{background:#067dff;color:#fff;box-shadow:0 0 20px #007bff66}
#messages{flex:1;overflow:auto;padding:8px 4px}.msg{max-width:82%;padding:13px 16px;border-radius:17px;margin:10px 0;line-height:1.45;white-space:pre-wrap}.user{margin-left:auto;background:#096ee8;color:white}.ai{background:#0d203c;border:1px solid #1b78db66;color:#d7e7ff}
.composer{border:1px solid #1386ff99;border-radius:18px;background:#06142ce8;padding:12px}.composer textarea{width:100%;height:82px;resize:none;background:transparent;border:0;outline:0;color:white;font-size:16px}.actions{display:flex;gap:8px;align-items:center;border-top:1px solid #1a5caa55;padding-top:10px}.action{border:1px solid #2379d888;background:#091c38;color:#bcd8ff;border-radius:11px;padding:9px 13px;cursor:pointer}.send{margin-left:auto;background:linear-gradient(135deg,#09b8ff,#0965ff);color:#fff;border:0;border-radius:11px;padding:11px 23px;font-weight:700;cursor:pointer}
#bubble{position:fixed;right:25px;bottom:25px;width:66px;height:66px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(145deg,#0db9ff,#0754ff);border:2px solid #168dff;box-shadow:0 0 28px #007bff99;color:#fff;font-size:35px;font-weight:900;cursor:pointer;z-index:20}
#keyModal{position:fixed;inset:0;background:#020714aa;backdrop-filter:blur(7px);display:grid;place-items:center;z-index:30}.modal{width:min(520px,calc(100vw - 30px));border:2px solid #0787ff;border-radius:25px;background:#071326f5;box-shadow:0 0 45px #007bff66;padding:22px}.modalTop{display:flex;align-items:center;gap:14px}.modal h2{margin:0;font-size:27px}.modal h2 span{color:#078eff}.modal p{color:#8facdc}.key{width:100%;padding:17px;border-radius:15px;border:2px solid #087fff;background:#07162d;color:white;outline:0;font-size:17px}.confirm{width:100%;margin-top:14px;padding:16px;border:0;border-radius:15px;background:linear-gradient(135deg,#10bfff,#0759ff);color:white;font-size:18px;font-weight:800;cursor:pointer}.error{color:#ff7f9c;min-height:20px}
@media(max-width:800px){#app{left:8px;right:8px;top:8px;width:auto;height:calc(100vh - 16px)}.notes{display:none}.main{padding:9px}.title b{font-size:22px}}
</style>
</head>
<body>

<div id="bubble" class="hidden" title="Mở Tnh-VN AI">T</div>

<div id="keyModal">
  <div class="modal">
    <div class="modalTop"><div class="logo">T</div><div><h2>Tnh-VN <span>AI</span></h2><p>Nhập Key để tiếp tục</p></div></div>
    <input id="keyInput" class="key" placeholder="Dán Key vào đây..." autocomplete="off">
    <button id="confirmKey" class="confirm">🛡 XÁC NHẬN</button>
    <div id="keyError" class="error"></div>
  </div>
</div>

<div id="app" class="hidden">
<header>
  <div class="logo">T</div>
  <div class="title"><b>Tnh-VN <span>AI</span></b><small>Trợ lý AI đa năng · Hỗ trợ học tập, làm việc, sáng tạo</small></div>
  <div class="headBtns"><button id="minBtn" class="iconBtn">−</button><button id="closeBtn" class="iconBtn">×</button></div>
</header>
<div class="main">
  <aside class="notes">
    <h3>📝 Note</h3>
    <div id="notes"></div>
  </aside>
  <section class="chat">
    <div class="models" id="models">
      <button class="model active" data-model="ChatGPT">◉ ChatGPT</button>
      <button class="model" data-model="Gemini">✦ Gemini</button>
      <button class="model" data-model="Claude">✹ Claude</button>
      <button class="model" data-model="DeepSeek">◉ DeepSeek</button>
      <button class="model" data-model="Kết hợp">🔗 Kết hợp</button>
    </div>
    <div id="messages">
      <div class="msg ai">Xin chào! Đây là giao diện Tnh-VN AI. Hãy nhập câu hỏi bên dưới.</div>
    </div>
    <div class="composer">
      <textarea id="prompt" placeholder="Hỏi AI bất kỳ điều gì..."></textarea>
      <div class="actions">
        <button class="action" id="copyInput">📋 Copy</button>
        <button class="action" id="editInput">✎ Chỉnh sửa</button>
        <button class="action" id="copyChat">⧉ Copy AI</button>
        <button class="send" id="send">➤ Gửi</button>
      </div>
    </div>
  </section>
</div>
</div>

<script>
const ACCESS_KEY="Tnh-VN";
const modal=document.getElementById("keyModal"), app=document.getElementById("app"), bubble=document.getElementById("bubble");
const input=document.getElementById("keyInput"), err=document.getElementById("keyError");

const noteTexts=["Ý tưởng hôm nay...","Kế hoạch công việc...","Học tập & kiến thức...","Dự án cá nhân...","Ghi chú nhanh...","Tài liệu tham khảo...","Mục tiêu phát triển...","Ý tưởng sáng tạo...","Danh sách cần làm...","Ghi chú khác..."];
document.getElementById("notes").innerHTML=noteTexts.map((x,i)=>`<div class="note ${i===0?"active":""}" data-note="${i}"><span class="num">${i+1}</span><span>${x}</span></div>`).join("");

function unlock(){
  if(input.value.trim()===ACCESS_KEY){
    modal.classList.add("hidden"); app.classList.remove("hidden");
    localStorage.setItem("tnhUnlocked","1");
  }else err.textContent="Key không đúng.";
}
document.getElementById("confirmKey").onclick=unlock;
input.addEventListener("keydown",e=>{if(e.key==="Enter")unlock()});

document.getElementById("minBtn").onclick=()=>{app.classList.add("hidden");bubble.classList.remove("hidden")};
bubble.onclick=()=>{bubble.classList.add("hidden");app.classList.remove("hidden")};
document.getElementById("closeBtn").onclick=()=>{app.classList.add("hidden");bubble.classList.add("hidden")};

document.querySelectorAll(".model").forEach(b=>b.onclick=()=>{
 document.querySelectorAll(".model").forEach(x=>x.classList.remove("active"));b.classList.add("active");
});

const prompt=document.getElementById("prompt"), messages=document.getElementById("messages");
let lastAI="";
function addMsg(text,type){const d=document.createElement("div");d.className="msg "+type;d.textContent=text;messages.appendChild(d);messages.scrollTop=messages.scrollHeight;return d}

document.getElementById("send").onclick=async()=>{
 const q=prompt.value.trim(); if(!q)return;
 addMsg(q,"user"); prompt.value="";
 const active=document.querySelector(".model.active").dataset.model;
 const ai=addMsg("Đang xử lý với "+active+"…","ai");
 /*
  * KẾT NỐI AI THẬT:
  * Thay phần bên dưới bằng backend của bạn.
  * Không đặt API key của OpenAI/Gemini/Claude/DeepSeek trực tiếp trong
  * JavaScript phía trình duyệt; hãy gọi server của bạn.
  *
  * Ví dụ:
  * const r=await fetch("/api/chat",{method:"POST",headers:{"Content-Type":"application/json"},
  * body:JSON.stringify({model:active,message:q})});
  * const data=await r.json(); ai.textContent=data.reply;
  */
 setTimeout(()=>{
   lastAI="Demo Tnh-VN AI: Bạn vừa hỏi: "+q+"\\n\\nGiao diện đã sẵn sàng. Hãy nối endpoint /api/chat ở server để dùng mô hình AI thật.";
   ai.textContent=lastAI;
 },500);
};

document.getElementById("copyInput").onclick=()=>navigator.clipboard.writeText(prompt.value);
document.getElementById("copyChat").onclick=()=>navigator.clipboard.writeText(lastAI||"");
document.getElementById("editInput").onclick=()=>{prompt.focus();prompt.select()};

document.querySelectorAll(".note").forEach(n=>n.onclick=()=>{
 document.querySelectorAll(".note").forEach(x=>x.classList.remove("active"));n.classList.add("active");
 prompt.value=n.innerText.replace(/^\\d+/,"").trim();
});

if(localStorage.getItem("tnhUnlocked")==="1"){modal.classList.add("hidden");app.classList.remove("hidden")}
</script>
</body>
</html>
