    local ESPObjects = {}

    local function ClearESPObject(obj)
        if ESPObjects[obj] then
            pcall(function()
                ESPObjects[obj].Gui:Destroy()
            end)
            ESPObjects[obj] = nil
        end
    end

    local function GetRoot(model)
        if not model then return nil end

        return model:FindFirstChild("HumanoidRootPart")
            or model:FindFirstChild("UpperTorso")
            or model:FindFirstChild("Torso")
            or model:FindFirstChildWhichIsA("BasePart")
    end

    local function IsEggObject(obj)
        local n = string.lower(obj.Name or "")

        return n:find("egg")
            or n:find("trung")
            or n:find("pet")
            or n:find("nest")
    end

    local function CreateESP(obj,isPlayer)
        if not obj or ESPObjects[obj] then return end

        local adornee

        if isPlayer then
            adornee = GetRoot(obj)
        else
            if obj:IsA("BasePart") then
                adornee = obj
            elseif obj:IsA("Model") then
                adornee = GetRoot(obj)
            end
        end

        if not adornee then return end

        local gui = Instance.new("BillboardGui")
        gui.Name = "TnhVN_ESP"
        gui.Adornee = adornee
        gui.Size = UDim2.fromOffset(150,60)
        gui.StudsOffset = Vector3.new(0,3,0)
        gui.AlwaysOnTop = true
        gui.ResetOnSpawn = false
        gui.Parent = MainGui

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1,0,1,0)
        frame.BackgroundTransparency = 1
        frame.Parent = gui

        local stroke = Instance.new("UIStroke")
        stroke.Color = State.ESPColor
        stroke.Thickness = 2
        stroke.Parent = frame

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Name = "Name"
        nameLabel.Size = UDim2.new(1,0,0,25)
        nameLabel.BackgroundTransparency = 1
        nameLabel.TextColor3 = State.ESPColor
        nameLabel.TextStrokeTransparency = 0
        nameLabel.TextSize = 14
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.Parent = frame

        local distLabel = Instance.new("TextLabel")
        distLabel.Name = "Distance"
        distLabel.Size = UDim2.new(1,0,0,22)
        distLabel.Position = UDim2.fromOffset(0,25)
        distLabel.BackgroundTransparency = 1
        distLabel.TextColor3 = State.ESPColor
        distLabel.TextStrokeTransparency = 0
        distLabel.TextSize = 13
        distLabel.Font = Enum.Font.Gotham
        distLabel.Parent = frame

        ESPObjects[obj] = {
            Gui = gui,
            Stroke = stroke,
            Name = nameLabel,
            Distance = distLabel,
            Player = isPlayer
        }
    end

    local function UpdateESP()
        local char,hum,root = GetChar()

        if not root then return end

        for obj,data in pairs(ESPObjects) do
            if not obj or not obj.Parent then
                ClearESPObject(obj)
            else
                local enabled = data.Player and State.ESPPlayer
                    or ((not data.Player) and State.ESPEgg)

                if not enabled then
                    ClearESPObject(obj)
                else
                    local targetRoot = GetRoot(obj)

                    if targetRoot then
                        local distance = (root.Position - targetRoot.Position).Magnitude

                        data.Stroke.Color = State.ESPColor
                        data.Name.TextColor3 = State.ESPColor
                        data.Distance.TextColor3 = State.ESPColor

                        if data.Player then
                            data.Name.Text = obj.Name
                        else
                            data.Name.Text = obj.Name
                        end

                        data.Name.Visible = State.ESPShowName
                        data.Distance.Visible = State.ESPShowDist
                        data.Distance.Text = math.floor(distance).." studs"
                    else
                        ClearESPObject(obj)
                    end
                end
            end
        end

        -- PLAYER ESP
        if State.ESPPlayer then
            for _,plr in ipairs(Players:GetPlayers()) do
                if plr ~= LP and plr.Character then
                    CreateESP(plr.Character,true)
                end
            end
        end

        -- EGG ESP
        if State.ESPEgg then
            for _,obj in ipairs(Workspace:GetDescendants()) do
                if (obj:IsA("BasePart") or obj:IsA("Model"))
                    and IsEggObject(obj)
                then
                    CreateESP(obj,false)
                end
            end
        end
    end

    AddConnection("ESPUpdate",RunService.Heartbeat:Connect(function()
        if State.ESPEgg or State.ESPPlayer then
            UpdateESP()
        else
            for obj in pairs(ESPObjects) do
                ClearESPObject(obj)
            end
        end
    end))

