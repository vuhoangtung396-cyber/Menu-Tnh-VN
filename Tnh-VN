local FlyVelocity
local FlyGyro

local function StopFly()
    if FlyVelocity then
        FlyVelocity:Destroy()
        FlyVelocity = nil
    end

    if FlyGyro then
        FlyGyro:Destroy()
        FlyGyro = nil
    end
end

local function StartFly()
    if not Root or not Humanoid then
        return
    end

    StopFly()

    FlyVelocity = Instance.new("BodyVelocity")
    FlyVelocity.Name = "TNH_VN_FlyVelocity"
    FlyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    FlyVelocity.Velocity = Vector3.zero
    FlyVelocity.Parent = Root

    FlyGyro = Instance.new("BodyGyro")
    FlyGyro.Name = "TNH_VN_FlyGyro"
    FlyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    FlyGyro.P = 50000
    FlyGyro.CFrame = Root.CFrame
    FlyGyro.Parent = Root
end

RunService.RenderStepped:Connect(function()
    if Config.Speed then
        UpdateSpeed()
    end

    if Config.Fly and Root and Humanoid and FlyVelocity and FlyGyro then

        local Direction = Humanoid.MoveDirection

        local Velocity = Direction * Config.FlySpeed

        if Config.FlyUp then
            Velocity += Vector3.new(0, Config.FlySpeed, 0)
        end

        if Config.FlyDown then
            Velocity -= Vector3.new(0, Config.FlySpeed, 0)
        end

        FlyVelocity.Velocity = Velocity

        if Direction.Magnitude > 0 then
            FlyGyro.CFrame = CFrame.lookAt(
                Root.Position,
                Root.Position + Direction
            )
        end
    end
end)

--==================================================
-- FIX LAG
--==================================================

local FixLagStates = {}

local function ApplyFixLag()
    if Config.FixLag then

        for _, Object in ipairs(Workspace:GetDescendants()) do

            if Object:IsA("ParticleEmitter")
                or Object:IsA("Trail")
                or Object:IsA("Beam") then

                if FixLagStates[Object] == nil then
                    FixLagStates[Object] = Object.Enabled
                end

                pcall(function()
                    Object.Enabled = false
                end)
            end

            if Object:IsA("BasePart") then
                if FixLagStates[Object] == nil then
                    FixLagStates[Object] = Object.CastShadow
                end

                pcall(function()
                    Object.CastShadow = false
                end)
            end
        end

        for _, Object in ipairs(Lighting:GetChildren()) do
            if Object:IsA("PostEffect") then

                if FixLagStates[Object] == nil then
                    FixLagStates[Object] = Object.Enabled
                end

                pcall(function()
                    Object.Enabled = false
                end)
            end
        end

        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)

    else

        for Object, OldValue in pairs(FixLagStates) do
            if Object and Object.Parent then
                pcall(function()
                    if Object:IsA("BasePart") then
                        Object.CastShadow = OldValue
                    else
                        Object.Enabled = OldValue
                    end
                end)
            end
        end

        table.clear(FixLagStates)
    end
end

--==================================================
-- AUTO STEAL
--==================================================

local function FindNearestEggPrompt()
    if not Root then
        return nil
    end

    local Nearest = nil
    local Distance = math.huge

    for _, Object in ipairs(Workspace:GetDescendants()) do

        if Object:IsA("ProximityPrompt") then

            local Text = string.lower(
                tostring(Object.ActionText)
                .. " "
                .. tostring(Object.ObjectText)
                .. " "
                .. tostring(Object.Name)
            )

            if string.find(Text, "egg")
                or string.find(Text, "steal")
                or string.find(Text, "grab")
                or string.find(Text, "take") then

                local ParentPart = Object.Parent

                if ParentPart and ParentPart:IsA("BasePart") then

                    local CurrentDistance =
                        (Root.Position - ParentPart.Position).Magnitude

                    if CurrentDistance < Distance then
                        Distance = CurrentDistance
                        Nearest = Object
                    end
                end
            end
        end
    end

    return Nearest
end

task.spawn(function()

    while task.wait(0.25) do

        if Config.AutoSteal then

            pcall(function()

                local Prompt = FindNearestEggPrompt()

                if Prompt then

                    local Part = Prompt.Parent

                    if Part and Part:IsA("BasePart") and Root then

                        Root.CFrame =
                            Part.CFrame
                            + Vector3.new(0, 3, 0)

                        task.wait(0.1)

                        if typeof(fireproximityprompt) == "function" then
                            fireproximityprompt(Prompt)
                        end
                    end
                end

            end)
        end
    end

end)

