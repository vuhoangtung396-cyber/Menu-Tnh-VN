    --====================================================

    local FlyVelocity
    local FlyGyro

    local function StopFly()

        if FlyVelocity then
            FlyVelocity:Destroy()
            FlyVelocity = nil
        end

        if FlyGyro then
            FlyGyro:Destroy()
            FlyGyro = nil
        end

    end

    local function StartFly()

        if not Root then
            return
        end

        StopFly()

        FlyVelocity = Instance.new("BodyVelocity")

        FlyVelocity.MaxForce =
            Vector3.new(math.huge,math.huge,math.huge)

        FlyVelocity.Velocity = Vector3.zero
        FlyVelocity.Parent = Root

        FlyGyro = Instance.new("BodyGyro")

        FlyGyro.MaxTorque =
            Vector3.new(math.huge,math.huge,math.huge)

        FlyGyro.P = 90000
        FlyGyro.Parent = Root

    end

    RunService.RenderStepped:Connect(function()

        FlyControls.Visible = Config.Fly

        if not Config.Fly then
            StopFly()
            return
        end

        if not Root then
            return
        end

        if not FlyVelocity then
            StartFly()
        end

        local Camera = Workspace.CurrentCamera

        local Move = Vector3.zero

        if Humanoid then
            Move = Humanoid.MoveDirection
        end

        local Vertical = 0

        if Config.FlyUp then
            Vertical += 1
        end

        if Config.FlyDown then
            Vertical -= 1
        end

        Move = Vector3.new(
            Move.X,
            Vertical,
            Move.Z
        )

        if Move.Magnitude > 0 then
            Move = Move.Unit * Config.FlySpeed
        end

        FlyVelocity.Velocity = Move

        if FlyGyro then
            FlyGyro.CFrame = Camera.CFrame
        end

    end)

    --====================================================
    -- FIX LAG
    --====================================================

    local function FixLag()

        for _,Object in ipairs(Workspace:GetDescendants()) do

            pcall(function()

                if Object:IsA("ParticleEmitter")
                or Object:IsA("Trail")
                or Object:IsA("Beam") then

                    if OriginalEffects[Object] == nil then
                        OriginalEffects[Object] = Object.Enabled
                    end

                    Object.Enabled = not Config.FixLag

                elseif Object:IsA("PostEffect") then

                    if OriginalEffects[Object] == nil then
                        OriginalEffects[Object] = Object.Enabled
                    end

                    Object.Enabled = not Config.FixLag

                elseif Object:IsA("BasePart") and Config.FixLag then

                    Object.CastShadow = false

                end

            end)

        end

        if Config.FixLag then

            Lighting.GlobalShadows = false

            pcall(function()
                settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            end)

        end

    end

    task.spawn(function()

        while MainGui and MainGui.Parent do

            if Config.FixLag then
