    local TStroke = Instance.new("UIStroke")
    TStroke.Color = Color3.fromRGB(255,220,100)
    TStroke.Thickness = 2
    TStroke.Parent = TButton

    local TDragging = false
    local TDragStart
    local TStartPos
    local Moved = false

    Connect(TButton.InputBegan, function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

            TDragging = true
            Moved = false
            TDragStart = input.Position
            TStartPos = TButton.Position

            local changed
            changed = input.Changed:Connect(function()

                if input.UserInputState == Enum.UserInputState.End then
                    TDragging = false

                    if not Moved then
                        if Main.Visible then
                            HideMenu()
                        else
                            ShowMenu()
                        end
                    end

                    changed:Disconnect()
                end
            end)

            table.insert(Connections, changed)
        end
    end)

    Connect(UserInputService.InputChanged, function(input)

        if not TDragging then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

            local delta = input.Position - TDragStart

            if delta.Magnitude > 8 then
                Moved = true
            end

            TButton.Position = UDim2.new(
                TStartPos.X.Scale,
                TStartPos.X.Offset + delta.X,
                TStartPos.Y.Scale,
                TStartPos.Y.Offset + delta.Y
            )
        end
    end)

