-- Generator Helpers for UI Items
local function CreateTab(name, layoutOrder)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 28)
    btn.BackgroundColor3 = HubTheme.Card
    btn.Text = "  " .. name
    btn.TextColor3 = HubTheme.TxtMute
    btn.TextSize = 11
    btn.Font = Enum.Font.GothamBold
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.LayoutOrder = layoutOrder
    btn.Parent = TabHolder
    ApplyCorner(btn, 6)
    return btn
end

local function CreateSectionHeader(title)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 22)
    frame.BackgroundTransparency = 1
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = "——  " .. title .. "  ——"
    lbl.TextColor3 = HubTheme.Accent
    lbl.TextSize = 11
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Center
    lbl.Parent = frame
    
    frame.Parent = ContentHolder
end

local function CreateToggle(text, defaultState, callback)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, -10, 0, 36)
    card.BackgroundColor3 = HubTheme.Card
    card.Parent = ContentHolder
    ApplyCorner(card, 6)
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.7, 0, 1, 0)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = HubTheme.Txt
    lbl.TextSize = 12
    lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = card
    
    local chk = Instance.new("TextButton")
    chk.Size = UDim2.new(0, 20, 0, 20)
    chk.Position = UDim2.new(1, -30, 0.5, -10)
    chk.BackgroundColor3 = defaultState and HubTheme.BtnOn or HubTheme.BtnOff
    chk.Text = defaultState and "✓" or ""
    chk.TextColor3 = Color3.new(1, 1, 1)
    chk.TextSize = 12
    chk.Font = Enum.Font.GothamBold
    chk.Parent = card
    ApplyCorner(chk, 4)
    
    local state = defaultState
    chk.MouseButton1Click:Connect(function()
        state = not state
        chk.BackgroundColor3 = state and HubTheme.BtnOn or HubTheme.BtnOff
        chk.Text = state and "✓" or ""
        callback(state)
    end)
end

local function CreateButton(text, callback)
    local card = Instance.new("Frame")
