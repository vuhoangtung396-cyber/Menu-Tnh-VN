if o:IsA("PointLight") or o:IsA("SpotLight") or o:IsA("SurfaceLight") then
if Saved[o]==nil then Saved[o]={t="e",v=o.Enabled} end
pcall(function() o.Enabled=false end) end
if o:IsA("Decal") or o:IsA("Texture") then
if Saved[o]==nil then Saved[o]={t="tx",v=o.Texture} end
pcall(function() o.Texture="" end) end
if o:IsA("Sky") then
if Saved[o]==nil then Saved[o]={t="p",v=o.Parent} end
pcall(function() o.Parent=nil end) end
if o:IsA("PostEffect") then
if Saved[o]==nil then Saved[o]={t="e",v=o.Enabled} end
pcall(function() o.Enabled=false end) end
if o:IsA("BasePart") then
if Saved[o]==nil then Saved[o]={t="bp",CS=o.CastShadow,MT=o.Material,RF=o.Reflectance} end
pcall(function()
o.CastShadow=false;o.Reflectance=0
if o.Material~=Enum.Material.Water and o.Material~=Enum.Material.Glass then
o.Material=Enum.Material.Plastic end end) end
if o:IsA("Sound") then
if Saved[o]==nil then Saved[o]={t="v",v=o.Volume} end
pcall(function() o.Volume=0 end) end end
local function SXF()
if S.FixLag then return end
S.FixLag=true
pcall(function() settings().Rendering.QualityLevel=Enum.QualityLevel.Level01 end)
pcall(function() settings().Rendering.MeshPartDetailLevel=Enum.MeshPartDetailLevel.Level01 end)
pcall(function() settings().Rendering.EagerBulkExecution=true end)
for _,o in ipairs(WS:GetDescendants()) do DE(o) end
for _,o in ipairs(LG:GetDescendants()) do DE(o) end
pcall(function()
Saved.GS=LG.GlobalShadows;LG.GlobalShadows=false
Saved.EDS=LG.EnvironmentDiffuseScale;LG.EnvironmentDiffuseScale=0
Saved.ESS=LG.EnvironmentSpecularScale;LG.EnvironmentSpecularScale=0
