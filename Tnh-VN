local ASC
local LPA=0
local CIF=nil
local LSc=0
local CEg={}
local SCT=0.8
local function GCE(rad)
    if tick()-LSc>SCT or #CEg==0 then
        CEg=Scan(rad);LSc=tick()
    end
    return CEg
end
local function FNE()
    local c=LP.Character
    local r=c and c:FindFirstChild("HumanoidRootPart")
    if not r then return nil end
    local all=GCE(500)
    if #all==0 then all=Scan();CEg=all;LSc=tick() end
    if #all==0 then return nil end
    local best,bs=nil,-math.huge
    for _,e in ipairs(all) do
        if e.part and e.part.Parent and EMP(e) then
            local d=(e.part.Position-r.Position).Magnitude
            local inf=e.info or {}
            local sc=-d
            if S.PrioritySecret then
                local rr=(inf.rarity or ""):lower()
                if rr=="secret" or rr=="mythic" or rr=="cosmic" or rr=="divine" or rr=="eternal" then sc=sc+1e9 end
            end
            sc=sc+PI(inf.income)*100
            if sc>bs then bs=sc;best=e end
        end
    end
    return best
end
local function ECI()
    local c=LP.Character
    if not c then return end
    local h=c:FindFirstChildOfClass("Humanoid")
    if h then for _,st in ipairs(NST) do pcall(function() h:SetStateEnabled(st,false) end) end end
    if not CIF or CIF.Parent~=c then
