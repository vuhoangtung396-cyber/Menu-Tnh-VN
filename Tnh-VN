-- ============================================================
-- FIX LAG
-- ============================================================
local FixLag = { active = false, saved = {}, conns = {} }
local VISUAL_CLASSES = {
    "ParticleEmitter","Trail","Beam","Smoke","Fire","Sparkles",
    "PointLight","SpotLight","SurfaceLight",
}
local LIGHTING_EFFECT_CLASSES = {
    "BloomEffect","BlurEffect","SunRaysEffect","ColorCorrectionEffect","DepthOfFieldEffect",
}

local function isVisualClass(inst)
    for _, c in ipairs(VISUAL_CLASSES) do
        if inst:IsA(c) then return true end
    end
    return false
end

local function processVisual(inst)
    if FixLag.saved[inst] == nil then
        FixLag.saved[inst] = { Enabled = inst.Enabled, CastShadow = inst.CastShadow }
    end
    if inst.Enabled ~= nil then inst.Enabled = false end
    if inst.CastShadow ~= nil then inst.CastShadow = false end
end

local function processBasePart(part)
    if FixLag.saved[part] == nil then
        FixLag.saved[part] = { CastShadow = part.CastShadow }
    end
    part.CastShadow = false
    -- Giảm texture (an toàn): không xóa, chỉ hạ độ phân giải Material nếu có
    if part.Material == Enum.Material.Grass or part.Material == Enum.Material.LeafyGrass then
        FixLag.saved[part].Material = part.Material
        part.Material = Enum.Material.SmoothPlastic
    end
end

local function processDescendant(d)
    if isVisualClass(d) then processVisual(d)
    elseif d:IsA("BasePart") then processBasePart(d) end
end

function FixLag:enable()
    if self.active then return end
    self.active = true; self.saved = {}

    -- Lighting effects
    for _, e in ipairs(Lighting:GetChildren()) do
        if table.find(LIGHTING_EFFECT_CLASSES, e.ClassName) then
            self.saved[e] = { Enabled = e.Enabled }
            e.Enabled = false
        end
    end
    self.saved.Lighting = {
        FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart,
        GlobalShadows = Lighting.GlobalShadows,
    }
    Lighting.FogEnd = 1e6; Lighting.FogStart = 1e6
    Lighting.GlobalShadows = false

    -- Quét Workspace
    for _, d in ipairs(Workspace:GetDescendants()) do
        processDescendant(d)
    end

    -- Xử lý hiệu ứng mới
    table.insert(self.conns, Workspace.DescendantAdded:Connect(function(d)
        if self.active then task.defer(function() if d.Parent then processDescendant(d) end end) end
    end))
    table.insert(self.conns, Lighting.ChildAdded:Connect(function(c)
        if self.active and table.find(LIGHTING_EFFECT_CLASSES, c.ClassName) then
            self.saved[c] = { Enabled = c.Enabled }; c.Enabled = false
        end
    end))
end

function FixLag:disable()
    if not self.active then return end
    self.active = false
    for _, c in ipairs(self.conns) do c:Disconnect() end
    self.conns = {}

    for inst, data in pairs(self.saved) do
        if typeof(inst) == "Instance" and inst.Parent then
            if data.Enabled ~= nil and inst.Enabled ~= nil then inst.Enabled = data.Enabled end
            if data.CastShadow ~= nil and inst.CastShadow ~= nil then inst.CastShadow = data.CastShadow end
            if data.Material ~= nil and inst.Material ~= nil then inst.Material = data.Material end
        end
    end
    if self.saved.Lighting then
        local L = self.saved.Lighting
        Lighting.FogEnd = L.FogEnd; Lighting.FogStart = L.FogStart
        Lighting.GlobalShadows = L.GlobalShadows
    end
    self.saved = {}
end

