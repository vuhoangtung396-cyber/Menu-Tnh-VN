-- Logic gửi tin nhắn
local function SendMessage()
    local text = InputBox.Text
    if text == "" then return end
    InputBox.Text = ""
    AddMessage("Bạn", text, true)
    
    -- Giả lập phản hồi AI (Bạn có thể thay bằng HTTP Request thật)
    task.spawn(function()
        task.wait(1)
        local response = ""
        if selectedModel == "ChatGPT" then
            response = "[ChatGPT] Đây là câu trả lời giả lập cho: " .. text .. "\n\nĐể dùng thật, hãy dán API Key vào phần CONFIG ở đầu script."
        elseif selectedModel == "Gemini" then
            response = "[Gemini] Phản hồi giả lập: " .. text
        else
            response = "[" .. selectedModel .. "] Phản hồi giả lập: " .. text
        end
        AddMessage("Tnh-VN AI", response, false)
    end)
end

SendBtn.MouseButton1Click:Connect(SendMessage)
