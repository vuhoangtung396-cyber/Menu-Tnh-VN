function OpenPg(n)
    for x,p in pairs(Pages) do p.Visible=(x==n) end
    for x,d in pairs(Btns) do
        if x==n then
            d.Btn.BackgroundColor3=P.CardHi
            d.Icon.TextColor3=P.Yellow
            d.Text.TextColor3=P.TextPri
            d.Text.Font=Enum.Font.GothamBold
        else
            d.Btn.BackgroundColor3=P.Side
            d.Icon.TextColor3=P.TextSec
            d.Text.TextColor3=P.TextSec
            d.Text.Font=Enum.Font.GothamMedium
        end
    end
end

