local NST={Enum.HumanoidStateType.Ragdoll,Enum.HumanoidStateType.FallingDown,Enum.HumanoidStateType.Physics,Enum.HumanoidStateType.PlatformStanding}
local AHC,AHF,AHL
local function ApplyAH()
    local c=LP.Character
    local h=c and c:FindFirstChildOfClass("Humanoid")
    if not c or not h then return end
    for _,st in ipairs(NST) do pcall(function() h:SetStateEnabled(st,false) end) end
    if AHF and AHF.Parent~=c then AHF=nil end
    if not AHF then AHF=Instance.new("ForceField");AHF.Name="TnhVN_AH";AHF.Visible=false;AHF.Parent=c end
    if AHL then AHL:Disconnect() end
    AHL=RS.Heartbeat:Connect(function()
        if not S.AntiHit or S.AutoSteal or S.Fly then return end
        local cc=LP.Character
        if not cc then return end
        local hh=cc:FindFirstChildOfClass("Humanoid")
        local rr=cc:FindFirstChild("HumanoidRootPart")
        if not hh or not rr then return end
        if hh.Health<hh.MaxHealth then hh.Health=hh.MaxHealth end
        hh.PlatformStand=false;hh.Sit=false;hh.AutoRotate=true
        local st=hh:GetState()
        if st==Enum.HumanoidStateType.Ragdoll or st==Enum.HumanoidStateType.FallingDown
        or st==Enum.HumanoidStateType.Physics or st==Enum.HumanoidStateType.PlatformStanding then
            pcall(function() hh:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
        local vel=rr.AssemblyLinearVelocity
        if Vector3.new(vel.X,0,vel.Z).Magnitude>math.max(hh.WalkSpeed*2,50) then
            rr.AssemblyLinearVelocity=Vector3.new(0,vel.Y,0)
        end
        rr.AssemblyAngularVelocity=Vector3.zero
    end)
end
local function StopAH()
    if AHC then AHC:Disconnect();AHC=nil end
    if AHL then AHL:Disconnect();AHL=nil end
    if AHF then AHF:Destroy();AHF=nil end
    local c=LP.Character
    local h=c and c:FindFirstChildOfClass("Humanoid")
    if h then for _,st in ipairs(NST) do pcall(function() h:SetStateEnabled(st,true) end) end end
end
local AHT=Tog(Mp,T("antiHit"),T("antiHitD"),function(v)
    if v then StopAH();S.AntiHit=true;ApplyAH()
        AHC=LP.CharacterAdded:Connect(function() task.wait(.5);if S.AntiHit then ApplyAH() end end)
    else S.AntiHit=false;StopAH() end end)

