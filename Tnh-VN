-- Hàm tìm Egg gần nhất
function FindNearestEgg()
    local nearestEgg = nil
    local minDistance = math.huge
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name:lower():find("egg") and obj:IsA("BasePart") then
            local distance = (obj.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
            if distance < minDistance and distance <= StealDistance * 2 then
                minDistance = distance
                nearestEgg = obj
            end
        end
    end
    return nearestEgg
end

-- Hàm Steal Egg
function StealNearestEgg()
    local egg = FindNearestEgg()
    if egg then
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            -- Teleport đến egg
            hrp.CFrame = CFrame.new(egg.Position + Vector3.new(0, 3, 0))
            task.wait(0.05)
            -- Kích hoạt steal (tùy game)
            if firetouchinterest then
                firetouchinterest(hrp, egg, 0)
                task.wait(0.05)
                firetouchinterest(hrp, egg, 1)
            end
        end
    end
end

