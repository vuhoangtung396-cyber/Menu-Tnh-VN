local function AddSlider(parent, key, min, max, default, cb)
    cfg[key] = default
    local f = cr("Frame", { Parent=parent, Size=UDim2.new(1,0,0,46), BackgroundColor3=Color3.fromRGB(20,20,32) })
    cr("UICorner", { Parent=f, CornerRadius=UDim.new(0,6) })
    local lbl = cr("TextLabel", { Parent=f, Position=UDim2.new(0,12,0,4), Size=UDim2.new(0.8,0,0,18), BackgroundTransparency=1, Text=txt(key)..": "..tostring(default), TextColor3=Color3.fromRGB(200,200,200), TextSize=12, Font=Enum.Font.Gotham, TextXAlignment=Enum.TextXAlignment.Left })
    local sBg = cr("Frame", { Parent=f, Position=UDim2.new(0,12,0,28), Size=UDim2.new(1,-24,0,8), BackgroundColor3=Color3.fromRGB(40,40,60) })
    cr("UICorner", { Parent=sBg, CornerRadius=UDim.new(1,0) })
    local sFill = cr("Frame", { Parent=sBg, Size=UDim2.new((default-min)/(max-min),0,1,0), BackgroundColor3=TCOL })
    cr("UICorner", { Parent=sFill, CornerRadius=UDim.new(1,0) })
    
    local drag = false
    local function Upd(input)
        local pos = math.clamp((input.Position.X - sBg.AbsolutePosition.X) / sBg.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * pos)
        cfg[key] = val
        sFill.Size = UDim2.new(pos,0,1,0)
        lbl.Text = txt(key)..": "..tostring(val)
        if cb then cb(val) end
    end
    sBg.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag=true; Upd(i) end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag=false end end)
    UIS.InputChanged:Connect(function(i) if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then Upd(i) end end)
end

