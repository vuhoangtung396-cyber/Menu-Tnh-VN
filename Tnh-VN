local function New(class,parent,props)
    local obj = Instance.new(class)

    for k,v in pairs(props or {}) do
        pcall(function()
            obj[k] = v
        end)
    end

    obj.Parent = parent
    return obj
end

local function Corner(obj,radius)
    New("UICorner",obj,{
        CornerRadius = UDim.new(0,radius)
    })
end

local function Stroke(obj,color,thickness)
    New("UIStroke",obj,{
        Color = color,
        Thickness = thickness
    })
end

