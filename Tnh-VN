-- =====================================================================
-- TARGET DISCOVERY (enemies and loot)
-- =====================================================================
local enemyCache = { models = {}, refreshedAt = -math.huge }

local function collectTaggedEnemies()
	local models = {}
	for _, instance in ipairs(CollectionService:GetTagged(CONFIG.EnemyTag)) do
		if instance:IsA("Model") and instance:IsDescendantOf(Workspace) then
			models[#models + 1] = instance
		end
	end
	return models
end

local function scanFallbackFolder()
	local models = {}
	local folder = resolveWorkspacePath(CONFIG.FallbackEnemyFolder)
	if not folder then
		return models
	end
	local source = if CONFIG.FallbackFolderRecursive then folder:GetDescendants() else folder:GetChildren()
	for _, instance in ipairs(source) do
		if instance:IsA("Model") and instance:FindFirstChildOfClass("Humanoid") then
			models[#models + 1] = instance
		end
	end
	return models
end

local function getEnemyModels(forceRefresh)
	local tagged = collectTaggedEnemies()
	if #tagged > 0 then
		return tagged
	end
	local now = os.clock()
	if forceRefresh or now - enemyCache.refreshedAt >= CONFIG.FallbackRefreshInterval then
		enemyCache.models = scanFallbackFolder()
		enemyCache.refreshedAt = now
	end
	return enemyCache.models
end

local function getEnemyTypeNames()
	local seen, names = {}, {}
	for _, model in ipairs(getEnemyModels(true)) do
		if not seen[model.Name] then
			seen[model.Name] = true
			names[#names + 1] = model.Name
		end
	end
	table.sort(names)
	return names
end

local function getLivingHumanoid(model)
	if not model or not model:IsDescendantOf(Workspace) then
		return nil
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		return humanoid
	end
	return nil
end

local function getModelRoot(model)
	return model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
end

local function findNearestEnemy(origin, enemyName)
	local best, bestDistance = nil, math.huge
	for _, model in ipairs(getEnemyModels(false)) do
		if model.Name == enemyName and getLivingHumanoid(model) then
			local part = getModelRoot(model)
			local distance = part and (part.Position - origin).Magnitude or math.huge
			if distance < bestDistance then
				best, bestDistance = model, distance
			end
		end
	end
	return best
end

local function getLootPosition(item)
	if item:IsA("BasePart") then
		return item.Position
	end
	if item:IsA("Model") then
		return item:GetPivot().Position
	end
	return nil
end

-- =====================================================================
-- AUTO FARM
-- =====================================================================
local farm = { connection = nil, target = nil, enemyName = nil, searchElapsed = 0, attackElapsed = 0 }

local function handleLoopError(featureKey, err)
	local name = DISPLAY_NAMES[featureKey]
	warnError(name .. " loop", err)
	ui.notify(name .. " stopped after an error (see Output)", "error")
	task.defer(setFeature, featureKey, false)
end

local function updateFarmTarget(root, dt)
	if farm.target and not getLivingHumanoid(farm.target) then
		cancelTween()
		farm.target = nil
		farm.searchElapsed = math.huge
	end
	if farm.target then
		return
	end
	farm.searchElapsed += dt
	if farm.searchElapsed < CONFIG.TargetSearchInterval then
		return
	end
	farm.searchElapsed = 0
	farm.target = findNearestEnemy(root.Position, farm.enemyName)
end

local function tryAttack(dt)
	farm.attackElapsed += dt
	if farm.attackElapsed < CONFIG.AttackInterval then
		return
	end
	farm.attackElapsed = 0
	runSafely("attackTarget", attackTarget, farm.target)
end

local function followFarmTarget(root, dt)
	local part = getModelRoot(farm.target)
	if not part then
		farm.target = nil
		return
	end
	local hoverPosition = part.Position + Vector3.new(0, CONFIG.EnemyHeightOffset, 0)
	local goal = buildFacingCFrame(hoverPosition, part.Position, root.CFrame)
	if (root.Position - hoverPosition).Magnitude > CONFIG.FarmSnapDistance then
		tweenRootTo(root, goal)
		return
	end
	local alpha = math.clamp(dt * CONFIG.FarmFollowSmoothing, 0, 1)
	root.CFrame = root.CFrame:Lerp(goal, alpha)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	tryAttack(dt)
end

local function farmStep(dt)
	local root, humanoid = getRootPart(), getHumanoid()
	if not root or not humanoid or humanoid.Health <= 0 then
		cancelTween()
		return
	end
	if movement.tweenRoot and movement.tweenRoot ~= root then
		cancelTween()
	end
	updateFarmTarget(root, dt)
	if not farm.target then
		ui.setStatus("AutoFarm", "Waiting for enemy to spawn")
		return
	end
	ui.setStatus("AutoFarm", "Farming: " .. farm.enemyName)
	if not isTweening() then
		followFarmTarget(root, dt)
	end
end

local function enableAutoFarm()
	if not farm.enemyName then
		return false, "Select an enemy type first"
	end
	if not claimMovement("AutoFarm") then
		return false, "Another movement feature is active"
	end
	requestNoclip("AutoFarm")
	farm.target = nil
	farm.searchElapsed = math.huge
	farm.attackElapsed = 0
	farm.connection = RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(farmStep, dt)
		if not ok then
			handleLoopError("AutoFarm", err)
		end
	end)
	return true
end

local function disableAutoFarm()
	if farm.connection then
		farm.connection:Disconnect()
		farm.connection = nil
	end
	farm.target = nil
	releaseMovement("AutoFarm")
	releaseNoclip("AutoFarm")
	ui.setStatus("AutoFarm", "Idle")
end

local function onEnemySelected(selected)
	farm.enemyName = next(selected)
	farm.target = nil
	farm.searchElapsed = math.huge
	if state.enabled.AutoFarm then
		cancelTween()
	end
end

-- =====================================================================
-- AUTO LOOT
-- =====================================================================
local loot = {
	connection = nil,
	target = nil,
	selectedTags = {},
	searchElapsed = 0,
	interactElapsed = 0,
	attempts = setmetatable({}, { __mode = "k" }),
	ignoreUntil = setmetatable({}, { __mode = "k" }),
}

local function isLootValid(item)
	if not item or not item:IsDescendantOf(Workspace) then
		return false
	end
	local deadline = loot.ignoreUntil[item]
	return not (deadline and os.clock() < deadline)
end

local function findNearestLoot(origin)
	local best, bestDistance = nil, math.huge
	for tag in pairs(loot.selectedTags) do
		for _, item in ipairs(CollectionService:GetTagged(tag)) do
			local position = isLootValid(item) and getLootPosition(item)
			if position and (position - origin).Magnitude < bestDistance then
				best, bestDistance = item, (position - origin).Magnitude
			end
		end
	end
	return best
end

local function updateLootTarget(root, dt)
	if loot.target and not isLootValid(loot.target) then
		cancelTween()
		loot.target = nil
		loot.searchElapsed = math.huge
	end
	if loot.target then
		return
	end
	loot.searchElapsed += dt
	if loot.searchElapsed < CONFIG.TargetSearchInterval then
		return
	end
	loot.searchElapsed = 0
	loot.target = findNearestLoot(root.Position)
	loot.interactElapsed = CONFIG.LootInteractCooldown
end

local function buildLootGoal(root, itemPosition)
	local offset = root.Position - itemPosition
	local flat = Vector3.new(offset.X, 0, offset.Z)
	local direction = if flat.Magnitude > 0.1 then flat.Unit else Vector3.new(0, 0, 1)
	local position = itemPosition + direction * CONFIG.LootStoppingDistance + Vector3.new(0, CONFIG.LootHeightOffset, 0)
	return buildFacingCFrame(position, itemPosition, root.CFrame)
end

local function interactWithLoot(dt)
	loot.interactElapsed += dt
	if loot.interactElapsed < CONFIG.LootInteractCooldown then
		return
	end
	loot.interactElapsed = 0
	local item = loot.target
	local attempts = (loot.attempts[item] or 0) + 1
	loot.attempts[item] = attempts
	if attempts > CONFIG.LootMaxAttempts then
		loot.ignoreUntil[item] = os.clock() + CONFIG.LootIgnoreSeconds
		loot.attempts[item] = nil
		loot.target = nil
		ui.notify("Skipped " .. item.Name .. ": could not collect it", "warn")
		return
	end
	runSafely("collectLoot", collectLoot, item)
end

local function approachOrCollect(root, dt)
	local itemPosition = getLootPosition(loot.target)
	if not itemPosition then
		loot.target = nil
		return
	end
	local arriveDistance = CONFIG.LootStoppingDistance + CONFIG.LootHeightOffset + 1
	if (root.Position - itemPosition).Magnitude > arriveDistance then
		tweenRootTo(root, buildLootGoal(root, itemPosition))
		return
	end
	root.AssemblyLinearVelocity = Vector3.zero
	interactWithLoot(dt)
end

local function lootStep(dt)
	local root, humanoid = getRootPart(), getHumanoid()
	if not root or not humanoid or humanoid.Health <= 0 then
		cancelTween()
		return
	end
	if movement.tweenRoot and movement.tweenRoot ~= root then
		cancelTween()
	end
	updateLootTarget(root, dt)
	if not loot.target then
		ui.setStatus("AutoLoot", "Waiting for loot to spawn")
		return
	end
	ui.setStatus("AutoLoot", "Looting: " .. loot.target.Name)
	if not isTweening() then
		approachOrCollect(root, dt)
	end
end

local function enableAutoLoot()
	if next(loot.selectedTags) == nil then
		return false, "Select at least one loot type first"
	end
	if not claimMovement("AutoLoot") then
		return false, "Another movement feature is active"
	end
	requestNoclip("AutoLoot")
	loot.target = nil
	loot.searchElapsed = math.huge
	loot.connection = RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(lootStep, dt)
		if not ok then
			handleLoopError("AutoLoot", err)
		end
	end)
	return true
end

local function disableAutoLoot()
	if loot.connection then
		loot.connection:Disconnect()
		loot.connection = nil
	end
	loot.target = nil
	releaseAllHeldPrompts()
	releaseMovement("AutoLoot")
	releaseNoclip("AutoLoot")
	ui.setStatus("AutoLoot", "Idle")
end

local function onLootTypesSelected(selected)
	loot.selectedTags = selected
	loot.target = nil
	loot.searchElapsed = math.huge
	if state.enabled.AutoLoot then
		cancelTween()
	end
end

