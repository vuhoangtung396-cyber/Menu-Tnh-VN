local function buildMenu()
	local camera = Workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
	local width = math.min(300, viewport.X - 20)
	local height = math.min(400, viewport.Y - 60)

	local gui = create("ScreenGui", {
		Name = MENU_NAME, ResetOnSpawn = false, IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 100,
	}, playerGui)
	ui.gui = gui
	installUiCallbacks()
	createNotifier(gui)

	local main = create("Frame", {
		Position = UDim2.fromOffset(20, 70), Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = THEME.Background, BorderSizePixel = 0, ClipsDescendants = true,
	}, gui)
	addCorner(main, 8)
	local bar, minimizeButton, closeButton = buildTitleBar(main)
	makeDraggable(bar, main)

	local body = create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 1, -32), BackgroundTransparency = 1,
		BorderSizePixel = 0, ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
	}, main)
	create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, body)
	create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }, body)

	buildVisualSection(body)
	buildMovementSection(body)
	buildAutomationSection(body)

	local openButton = createButton(gui, "Menu", { Size = UDim2.fromOffset(44, 30), Position = UDim2.new(0, 8, 0.5, -15), BackgroundColor3 = THEME.Accent, Visible = false })
	local minimized = false

	local function setMenuVisible(visible)
		main.Visible = visible
		openButton.Visible = not visible
	end

	minimizeButton.Activated:Connect(function()
		minimized = not minimized
		body.Visible = not minimized
		main.Size = minimized and UDim2.fromOffset(width, 32) or UDim2.fromOffset(width, height)
	end)
	closeButton.Activated:Connect(function()
		setMenuVisible(false)
	end)
	openButton.Activated:Connect(function()
		setMenuVisible(true)
	end)
	menuMaid.add(UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == CONFIG.MenuToggleKey then
			setMenuVisible(not main.Visible)
		end
	end))
	return gui
end

-- =====================================================================
-- STARTUP AND SHUTDOWN
-- =====================================================================
local function shutdown()
	if state.shutdown then
		return
	end
	for name, feature in pairs(features) do
		if state.enabled[name] then
			state.enabled[name] = false
			local ok, err = pcall(feature.disable)
			if not ok then
				warnError(name .. " shutdown", err)
			end
		end
	end
	state.shutdown = true
	menuMaid.clean()
end

local function initialize()
	local existing = playerGui:FindFirstChild(MENU_NAME)
	if existing then
		existing:Destroy() -- the older copy of this script cleans itself up via Destroying
	end
	local gui = buildMenu()
	connectDragEvents()
	menuMaid.add(localPlayer.CharacterAdded:Connect(function(character)
		for _, listener in ipairs(characterListeners) do
			task.spawn(runSafely, "Respawn handler", listener, character)
		end
	end))
	gui.Destroying:Connect(shutdown)
	refreshJumpRange()
	ui.setStatus("AutoFarm", "Idle")
	ui.setStatus("AutoLoot", "Idle")
	ui.notify("Ready - press " .. CONFIG.MenuToggleKey.Name .. " to show/hide", "success")
end

initialize()
