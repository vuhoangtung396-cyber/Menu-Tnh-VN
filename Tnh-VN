-- FIX LAG (cực mạnh)
--==================================================
local DisabledObjects={}
local function DisableObj(obj)
    -- Particles / Effects
    if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
    or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles")
    or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight")
    or obj:IsA("PostEffect") then
        if DisabledObjects[obj]==nil then DisabledObjects[obj]={t="e",v=obj.Enabled} end
        pcall(function() obj.Enabled=false end)
    end
    -- Textures
    if obj:IsA("Decal") or obj:IsA("Texture") then
        if DisabledObjects[obj]==nil then DisabledObjects[obj]={t="tx",v=obj.Texture} end
        pcall(function() obj.Texture="" end)
    end
    -- Sky
    if obj:IsA("Sky") then
        if DisabledObjects[obj]==nil then DisabledObjects[obj]={t="p",v=obj.Parent} end
        pcall(function() obj.Parent=nil end)
    end
    -- BasePart
    if obj:IsA("BasePart") then
        if DisabledObjects[obj]==nil then
            DisabledObjects[obj]={t="bp",CS=obj.CastShadow,MT=obj.Material,RF=obj.Reflectance}
        end
        pcall(function()
            obj.CastShadow=false
            obj.Reflectance=0
            if obj.Material~=Enum.Material.Water and obj.Material~=Enum.Material.Glass then
                obj.Material=Enum.Material.Plastic
            end
        end)
    end
    -- Sound
    if obj:IsA("Sound") then
        if DisabledObjects[obj]==nil then DisabledObjects[obj]={t="v",v=obj.Volume} end
        pcall(function() obj.Volume=0 end)
    end
end

local LagConn
local function StartFixLag()
    if State.FixLag then return end
    State.FixLag=true
    
    pcall(function() settings().Rendering.QualityLevel=Enum.QualityLevel.Level01 end)
    pcall(function() settings().Rendering.MeshPartDetailLevel=Enum.MeshPartDetailLevel.Level01 end)
    pcall(function() settings().Rendering.EagerBulkExecution=true end)
    
    for _,o in ipairs(WS:GetDescendants()) do DisableObj(o) end
    for _,o in ipairs(Lighting:GetDescendants()) do DisableObj(o) end
    
    pcall(function()
        Original.GS=Lighting.GlobalShadows; Lighting.GlobalShadows=false
        Original.EDS=Lighting.EnvironmentDiffuseScale; Lighting.EnvironmentDiffuseScale=0
        Original.ESS=Lighting.EnvironmentSpecularScale; Lighting.EnvironmentSpecularScale=0
        Original.BR=Lighting.Brightness; Lighting.Brightness=1
        Original.FS=Lighting.FogStart; Lighting.FogStart=0
        Original.FE=Lighting.FogEnd; Lighting.FogEnd=300
    end)
    
    pcall(function()
        if WS.Terrain then
            Original.T1=WS.Terrain.WaterWaveSize; WS.Terrain.WaterWaveSize=0
            Original.T2=WS.Terrain.WaterWaveSpeed; WS.Terrain.WaterWaveSpeed=0
            Original.T3=WS.Terrain.WaterReflectance; WS.Terrain.WaterReflectance=0
            Original.T4=WS.Terrain.Decoration; WS.Terrain.Decoration=false
        end
    end)
    
    LagConn=WS.DescendantAdded:Connect(function(o)
        if State.FixLag then task.defer(function() DisableObj(o) end) end
    end)
end

local function StopFixLag()
    if not State.FixLag then return end
    State.FixLag=false
    if LagConn then LagConn:Disconnect(); LagConn=nil end
    
    for obj,v in pairs(DisabledObjects) do
        if typeof(obj)=="Instance" and obj.Parent then
            pcall(function()
                if v.t=="e" then obj.Enabled=v.v
                elseif v.t=="tx" then obj.Texture=v.v
                elseif v.t=="bp" then
                    if v.CS~=nil then obj.CastShadow=v.CS end
                    if v.MT~=nil then obj.Material=v.MT end
                    if v.RF~=nil then obj.Reflectance=v.RF end
                elseif v.t=="v" then obj.Volume=v.v end
            end)
        end
    end
    DisabledObjects={}
    
    pcall(function()
        if Original.GS~=nil then Lighting.GlobalShadows=Original.GS end
        if Original.EDS~=nil then Lighting.EnvironmentDiffuseScale=Original.EDS end
        if Original.ESS~=nil then Lighting.EnvironmentSpecularScale=Original.ESS end
        if Original.BR~=nil then Lighting.Brightness=Original.BR end
        if Original.FS~=nil then Lighting.FogStart=Original.FS end
        if Original.FE~=nil then Lighting.FogEnd=Original.FE end
    end)
    pcall(function() settings().Rendering.QualityLevel=Enum.QualityLevel.Automatic end)
end

--==================================================
-- AUTO STEAL EGG (mới: teleport + fireprompt + bay về base)
--==================================================
local AutoRunning=false
local CarryForce

local function GetPromptFromEgg(part)
    if not part then return nil end
    local p=part:FindFirstChildOfClass("ProximityPrompt")
    if p then return p end
    if part.Parent then
        p=part.Parent:FindFirstChildOfClass("ProximityPrompt")
        if p then return p end
        for _,d in ipairs(part.Parent:GetDescendants()) do
            if d:IsA("ProximityPrompt") then return d end
        end
    end
    for _,d in ipairs(part:GetDescendants()) do
        if d:IsA("ProximityPrompt") then return d end
    end
    return nil
end

local function GetClickFromEgg(part)
    if not part then return nil end
    local c=part:FindFirstChildOfClass("ClickDetector")
    if c then return c end
    if part.Parent then
        c=part.Parent:FindFirstChildOfClass("ClickDetector")
        if c then return c end
    end
    return nil
end

local function FindEggs()
    local eggs,seen={},{}
    for _,o in ipairs(WS:GetDescendants()) do
        if o:IsA("BasePart") and not seen[o] then
            local n=o.Name:lower()
            local isEgg=(n:find("egg") or n:find("trứng"))
                and not n:find("machine") and not n:find("fuse") and not n:find("zone")
                and not n:find("shop") and not n:find("display") and not n:find("decor")
            if isEgg then
                local a,ic=o.Parent,false
                for _=1,5 do
                    if not a or a==WS then break end
                    if a:FindFirstChildOfClass("Humanoid") then ic=true; break end
                    a=a.Parent
                end
                if not ic then
                    local prompt=GetPromptFromEgg(o)
                    local click=GetClickFromEgg(o)
                    if prompt or click then
                        seen[o]=true
                        table.insert(eggs,{part=o,prompt=prompt,click=click})
                    end
                end
            end
        end
    end
    return eggs
end

local function FindNearestEgg()
    local eggs=FindEggs()
    if #eggs==0 then return nil end
    GetChar()
    if not Root then return nil end
    local best,bd=nil,math.huge
    for _,e in ipairs(eggs) do
        local d=(e.part.Position-Root.Position).Magnitude
        if d<bd then bd=d; best=e end
    end
    return best
end

local function TriggerPickup(egg)
    if not egg then return end
    -- fire prompt
    if egg.prompt then
        pcall(function()
            if fireproximityprompt then
                fireproximityprompt(egg.prompt,0)
            else
                egg.prompt:InputHoldBegin()
                task.wait(math.max(egg.prompt.HoldDuration or 0.05,0.05)+0.05)
                egg.prompt:InputHoldEnd()
            end
        end)
    end
    -- fire click
    if egg.click and fireclickdetector then
        pcall(function() fireclickdetector(egg.click,0) end)
    end
    -- fire touch
    GetChar()
    if Root and firetouchinterest then
        pcall(function()
            firetouchinterest(Root,egg.part,0)
            task.wait(0.03)
            firetouchinterest(Root,egg.part,1)
        end)
    end
end

local function FindBase()
    GetChar()
    if not Root then return nil end
    -- Ưu tiên folder chứa tên player
    local lname=LP.Name:lower()
    for _,folderName in ipairs({"Bases","Pens","Base","Spawns","Plots"}) do
        local f=WS:FindFirstChild(folderName)
        if f then
            for _,o in ipairs(f:GetChildren()) do
                if o.Name:lower():find(lname,1,true) then
                    local p=o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart")
                    if p then return p end
                end
            end
        end
    end
    -- Fallback: SpawnLocation
    for _,o in ipairs(WS:GetDescendants()) do
        if o:IsA("SpawnLocation") then return o end
    end
    return nil
end

local function IsCarryingEgg()
    for _,a in ipairs({"HasEgg","CarryingEgg","HasPet","CarryEgg","Holding","IsCarrying","Egg","EggName"}) do
        local ok,v=pcall(function() return LP:GetAttribute(a) end)
        if ok and v~=nil and v~=false and v~="" then return true end
    end
    GetChar()
    if Character then
        for _,o in ipairs(Character:GetChildren()) do
            if o:IsA("Tool") or o:IsA("Model") then
                local n=o.Name:lower()
                if n=="egg" or n:match("^egg[%s_%-%d]") then return true end
            end
        end
    end
    local bp=LP:FindFirstChildOfClass("Backpack")
    if bp then
        for _,o in ipairs(bp:GetChildren()) do
            local n=o.Name:lower()
            if n=="egg" or n:match("^egg[%s_%-%d]") then return true end
        end
    end
    return false
end

local function TPTo(pos)
    GetChar()
    if not Root then return end
    pcall(function()
        Root.CFrame=CFrame.new(pos+Vector3.new(0,3,0))
        Root.AssemblyLinearVelocity=Vector3.zero
        Root.AssemblyAngularVelocity=Vector3.zero
    end)
end

local function AutoStealLoop()
    if AutoRunning then return end
    AutoRunning=true
    task.spawn(function()
        while State.AutoSteal and not State.Destroyed do
            GetChar()
            if not Root then task.wait(1); continue end
            
            -- Đang cầm trứng → bay về base
            if IsCarryingEgg() then
                -- Bật ForceField bất tử
                if Character and not Character:FindFirstChild("TNHVN_FF") then
                    local ff=Instance.new("ForceField")
                    ff.Name="TNHVN_FF"
                    ff.Visible=false
                    ff.Parent=Character
                end
                if Humanoid and Humanoid.Health<Humanoid.MaxHealth then
                    Humanoid.Health=Humanoid.MaxHealth
                end
                local base=FindBase()
                if base then
                    local dist=(base.Position-Root.Position).Magnitude
                    if dist>8 then
                        -- Teleport dần về base (tránh bị kick)
                        local dir=base.Position-Root.Position
                        local step=math.min(dir.Magnitude-4,80)
                        TPTo(Root.Position+dir.Unit*step)
                    end
                end
                task.wait(0.1)
            else
                -- Tìm trứng gần nhất
                local egg=FindNearestEgg()
                if egg then
                    local dist=(egg.part.Position-Root.Position).Magnitude
                    if dist>5 then
                        local dir=egg.part.Position-Root.Position
                        local step=math.min(dir.Magnitude-3,60)
                        TPTo(Root.Position+dir.Unit*step)
                    else
                        -- Đã tới gần → nhặt
                        TriggerPickup(egg)
                        task.wait(0.15)
                    end
                else
                    task.wait(0.5)
                end
                task.wait(0.05)
            end
        end
        AutoRunning=false
    end)
end

