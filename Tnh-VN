features.Noclip = {
	enable = function()
		requestNoclip("Manual")
		return true
	end,
	disable = function()
		releaseNoclip("Manual")
	end,
}

local function disableExclusiveRival(name)
	local rival = EXCLUSIVE_PAIRS[name]
	if rival and state.enabled[rival] then
		setFeature(rival, false)
		ui.notify(DISPLAY_NAMES[rival] .. " disabled (movement conflict)", "warn")
	end
end

local function tryEnableFeature(name)
	disableExclusiveRival(name)
	local called, ok, reason = pcall(features[name].enable)
	if not called then
		warnError(DISPLAY_NAMES[name], ok)
		ui.notify(DISPLAY_NAMES[name] .. " failed to start (see Output)", "error")
		return false
	end
	if not ok then
		ui.notify(reason or (DISPLAY_NAMES[name] .. " could not start"), "error")
		return false
	end
	return true
end

setFeature = function(name, wantEnabled)
	local feature = features[name]
	local current = state.enabled[name] == true
	if not feature or state.shutdown or current == wantEnabled then
		ui.setToggle(name, current)
		return
	end
	if wantEnabled then
		if not tryEnableFeature(name) then
			ui.setToggle(name, false)
			return
		end
		state.enabled[name] = true
		ui.notify(DISPLAY_NAMES[name] .. " enabled", "success")
	else
		local ok, err = pcall(feature.disable)
		if not ok then
			warnError(DISPLAY_NAMES[name] .. " disable", err)
		end
		state.enabled[name] = false
		ui.notify(DISPLAY_NAMES[name] .. " disabled", "success")
	end
	ui.setToggle(name, state.enabled[name])
end

local function handleRespawn(character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid or localPlayer.Character ~= character then
		return
	end
	if state.enabled.SpeedWalk then
		watchWalkSpeed(humanoid)
	end
	if state.enabled.HighJump then
		captureJumpOriginal(humanoid)
		applyJump(humanoid)
	end
	refreshJumpRange()
end

onCharacterSpawn(function(character)
	if noclip.count > 0 then
		rebuildNoclipParts(character)
	end
end)
onCharacterSpawn(handleRespawn)

