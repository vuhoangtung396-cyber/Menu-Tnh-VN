--========================================================--
-- AUTO STEAL
--========================================================--

local StealRunning = false
local StealStatus = "OFF"

local function GetPosition(Object)

    if not Object then
        return nil
    end

    if Object:IsA("BasePart") then
        return Object.Position
    end

    if Object:IsA("Attachment") then
        return Object.WorldPosition
    end

    if Object:IsA("Model") then
        local P = Object.PrimaryPart

        if P then
            return P.Position
        end

        local OK, Pivot = pcall(function()
            return Object:GetPivot()
        end)

        if OK then
            return Pivot.Position
        end
    end

    return nil
end

local function GetPromptPosition(Prompt)

    if not Prompt then
        return nil
    end

    local Parent = Prompt.Parent

    if Parent:IsA("Attachment") then
        return Parent.WorldPosition
    end

    if Parent:IsA("BasePart") then
        return Parent.Position
    end

    local Model = Prompt:FindFirstAncestorOfClass("Model")

    if Model then
        return GetPosition(Model)
    end

    return nil
end

local function IsEggPrompt(Prompt)

    if not Prompt:IsA("ProximityPrompt") then
        return false
    end

    local Name =
        string.lower(tostring(Prompt.Name))

    local Action =
        string.lower(tostring(Prompt.ActionText))

    local Object =
        string.lower(tostring(Prompt.ObjectText))

    if Name == "carryareaegg" then
        return true
    end

    if string.find(Name, "egg")
        or string.find(Action, "egg")
        or string.find(Object, "egg") then

        return true
    end

    return false
end

local function FindNearestEgg()

    if not Root then
        return nil
    end

    local Best
    local BestDistance = math.huge

    local SearchFolders = {
        Workspace:FindFirstChild("Eggs"),
        Workspace:FindFirstChild("EggNest"),
    }

    -- Ưu tiên các folder egg nếu tồn tại
    for _, Folder in ipairs(SearchFolders) do

        if Folder then

            for _, Obj in ipairs(Folder:GetDescendants()) do

                if Obj:IsA("ProximityPrompt")
                    and IsEggPrompt(Obj) then

                    local Pos = GetPromptPosition(Obj)

                    if Pos then

                        local Dist =
                            (Root.Position - Pos).Magnitude

                        if Dist < BestDistance then
                            BestDistance = Dist
                            Best = Obj
                        end
                    end
                end
            end
        end
    end

    -- Fallback: quét toàn Workspace
    if not Best then

        for _, Obj in ipairs(Workspace:GetDescendants()) do

            if Obj:IsA("ProximityPrompt")
                and IsEggPrompt(Obj) then

                local Pos = GetPromptPosition(Obj)

                if Pos then

                    local Dist =
                        (Root.Position - Pos).Magnitude

                    if Dist < BestDistance then
                        BestDistance = Dist
                        Best = Obj
                    end
                end
            end
        end
    end

    return Best
end

local function FindSafeZone()

    local Spawn = Workspace:FindFirstChild("Spawn")

    if Spawn then

        local Safe =
            Spawn:FindFirstChild("SafeZone", true)

        if Safe then
            return Safe
        end
    end

    return Workspace:FindFirstChild("SafeZone", true)
end

local function MoveToPosition(TargetPosition)

    if not Humanoid or not Root or not TargetPosition then
        return false
    end

    local Path

    local OK = pcall(function()

        Path = PathfindingService:CreatePath({
            AgentRadius = 2,
            AgentHeight = 5,
            AgentCanJump = true,
            AgentCanClimb = true,
            WaypointSpacing = 5
        })

        Path:ComputeAsync(
            Root.Position,
            TargetPosition
        )
    end)

    if OK
        and Path
        and Path.Status == Enum.PathStatus.Success then

        local Waypoints = Path:GetWaypoints()

        for _, Waypoint in ipairs(Waypoints) do

            if not Config.AutoSteal then
                return false
            end

            if not Humanoid or Humanoid.Health <= 0 then
                return false
            end

            if Waypoint.Action == Enum.PathWaypointAction.Jump then
                Humanoid.Jump = true
            end

            Humanoid:MoveTo(Waypoint.Position)

            local Reached =
                Humanoid.MoveToFinished:Wait()

            if not Reached then
                return false
            end
        end

        return true
    end

    -- Fallback MoveTo nếu Pathfinding không tạo được path
    Humanoid:MoveTo(TargetPosition)

    local Start = os.clock()

    while os.clock() - Start < 15 do

        if not Config.AutoSteal then
            return false
        end

        if not Root then
            return false
        end

        if
            (Root.Position - TargetPosition).Magnitude
            <= 7 then

            return true
        end

        task.wait(0.15)
    end

    return false
end

local function FireEggPrompt(Prompt)

    if not Prompt then
        return false
    end

    pcall(function()
        Prompt.HoldDuration = 0
        Prompt.MaxActivationDistance =
            math.max(Prompt.MaxActivationDistance, 12)
    end)

    if typeof(fireproximityprompt) == "function" then

        local OK =
            pcall(function()
                fireproximityprompt(Prompt)
            end)

        if OK then
            return true
        end
    end

    -- Nếu executor không có fireproximityprompt,
    -- MoveTo đủ gần để Roblox tự cho người chơi tương tác.
    return false
end

local function AutoStealCycle()

    if StealRunning then
        return
    end

    StealRunning = true

    while Config.AutoSteal do

        pcall(function()

            RefreshCharacter()

            if not Root or not Humanoid then
                task.wait(1)
                return
            end

            StealStatus = "Đang tìm Egg..."

            local Prompt = FindNearestEgg()

            if not Prompt then
                StealStatus = "Không tìm thấy Egg"
                task.wait(1)
                return
            end

            local EggPosition =
                GetPromptPosition(Prompt)

            if not EggPosition then
                task.wait(0.5)
                return
            end

            StealStatus = "Đang đi tới Egg..."

            local Reached =
                MoveToPosition(EggPosition)

            if not Reached then
                StealStatus = "Không tới được Egg"
                task.wait(0.5)
                return
            end

            if not Config.AutoSteal then
                return
            end

            task.wait(0.15)

            StealStatus = "Đang lấy Egg..."

            FireEggPrompt(Prompt)

            task.wait(Config.StealDelay)

            if not Config.AutoSteal then
                return
            end

            -- Sau khi lấy egg: đi về SafeZone
            local Safe = FindSafeZone()

            if Safe then

                local SafePos =
                    GetPosition(Safe)

                if SafePos then

                    StealStatus =
                        "Đã lấy Egg - đang về Base..."

                    MoveToPosition(SafePos)

                    task.wait(0.5)

                    StealStatus = "Hoàn thành!"
                end

            else
                StealStatus =
                    "Không tìm thấy SafeZone"
            end

        end)

        task.wait(0.5)
    end

    StealStatus = "OFF"
    StealRunning = false
end

