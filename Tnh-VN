local function AFx(o)
    if o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Beam") or o:IsA("Smoke") or o:IsA("Fire") or o:IsA("Sparkles") then
        if Sv[o]==nil then Sv[o]={t="e",v=o.Enabled} end
        pcall(function() o.Enabled=false end)
    end
    if o:IsA("PointLight") or o:IsA("SpotLight") or o:IsA("SurfaceLight") then
        if Sv[o]==nil then Sv[o]={t="e",v=o.Enabled} end
        pcall(function() o.Enabled=false end)
    end
    if o:IsA("Decal") or o:IsA("Texture") then
        if Sv[o]==nil then Sv[o]={t="tx",v=o.Texture} end
        pcall(function() o.Texture="" end)
    end
    if o:IsA("Sky") then
        if Sv[o]==nil then Sv[o]={t="p",v=o.Parent} end
        pcall(function() o.Parent=nil end)
    end
    if o:IsA("PostEffect") then
        if Sv[o]==nil then Sv[o]={t="e",v=o.Enabled} end
        pcall(function() o.Enabled=false end)
    end
    if o:IsA("BasePart") then
        if Sv[o]==nil then Sv[o]={t="bp",CS=o.CastShadow,MT=o.Material,RF=o.Reflectance} end
        pcall(function()
            o.CastShadow=false;o.Reflectance=0
            if o.Material~=Enum.Material.Water and o.Material~=Enum.Material.Glass then o.Material=Enum.Material.Plastic end
            o.TopSurface=Enum.SurfaceType.Smooth;o.BottomSurface=Enum.SurfaceType.Smooth
        end)
    end
    if o:IsA("Sound") then
        if Sv[o]==nil then Sv[o]={t="v",v=o.Volume} end
        pcall(function() o.Volume=0 end)
    end
end
