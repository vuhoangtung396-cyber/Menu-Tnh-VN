-- FIX LAG
--==================================================

local DisabledObjects = {}

local function DisableObject(obj)
    if obj:IsA("ParticleEmitter")
    or obj:IsA("Trail")
    or obj:IsA("Beam")
    or obj:IsA("Smoke")
    or obj:IsA("Fire")
    or obj:IsA("Sparkles") then

        if DisabledObjects[obj] == nil then
            DisabledObjects[obj] = obj.Enabled
        end

        pcall(function()
            obj.Enabled = false
        end)

    elseif obj:IsA("PostEffect") then

        if DisabledObjects[obj] == nil then
            DisabledObjects[obj] = obj.Enabled
        end

        pcall(function()
            obj.Enabled = false
        end)
    end
end

local function StartFixLag()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        DisableObject(obj)
    end

    for _, obj in ipairs(Lighting:GetChildren()) do
        DisableObject(obj)
    end

    if Original.GlobalShadows == nil then
        Original.GlobalShadows = Lighting.GlobalShadows
    end

    Lighting.GlobalShadows = false

    pcall(function()
        if Workspace.Terrain then
            Original.Decoration = Workspace.Terrain.Decoration
            Workspace.Terrain.Decoration = false
        end
    end)
end

local function StopFixLag()
    for obj, oldValue in pairs(DisabledObjects) do
        if obj and obj.Parent then
            pcall(function()
                obj.Enabled = oldValue
            end)
        end
    end

    table.clear(DisabledObjects)

    if Original.GlobalShadows ~= nil then
        Lighting.GlobalShadows = Original.GlobalShadows
    end

    pcall(function()
        if Workspace.Terrain and Original.Decoration ~= nil then
            Workspace.Terrain.Decoration = Original.Decoration
        end
    end)
end

Connect(Workspace.DescendantAdded, function(obj)
    if State.FixLag then
        task.defer(function()
            DisableObject(obj)
        end)
    end
end)

