-- Hàm tạo Toggle
local function makeToggle(text, default, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, -10, 0, 45)
    Btn.BackgroundColor3 = Color3.fromRGB(50, 50, 75)
    Btn.Text = ""
    Btn.BorderSizePixel = 0
    Btn.Parent = Scroll
    local C = Instance.new("UICorner"); C.CornerRadius = UDim.new(0, 10); C.Parent = Btn

    local Lbl = Instance.new("TextLabel")
    Lbl.Size = UDim2.new(1, -70, 1, 0)
    Lbl.Position = UDim2.new(0, 15, 0, 0)
    Lbl.BackgroundTransparency = 1
    Lbl.Text = text
    Lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    Lbl.TextSize = 14
    Lbl.Font = Enum.Font.Gotham
    Lbl.TextXAlignment = Enum.TextXAlignment.Left
    Lbl.Parent = Btn

    local St = Instance.new("TextLabel")
    St.Size = UDim2.new(0, 55, 0, 28)
    St.Position = UDim2.new(1, -65, 0.5, -14)
    St.BackgroundColor3 = default and Color3.fromRGB(70, 200, 110) or Color3.fromRGB(90, 90, 110)
    St.Text = default and "ON" or "OFF"
    St.TextColor3 = Color3.fromRGB(255, 255, 255)
    St.TextSize = 12
    St.Font = Enum.Font.GothamBold
    St.BorderSizePixel = 0
    St.Parent = Btn
    local SC = Instance.new("UICorner"); SC.CornerRadius = UDim.new(0, 8); SC.Parent = St

    local state = default
    Btn.MouseButton1Click:Connect(function()
        state = not state
        St.Text = state and "ON" or "OFF"
        St.BackgroundColor3 = state and Color3.fromRGB(70, 200, 110) or Color3.fromRGB(90, 90, 110)
        Btn.BackgroundColor3 = state and Color3.fromRGB(60, 80, 100) or Color3.fromRGB(50, 50, 75)
        if callback then callback(state) end
    end)
end

