local function cleanup()
	stopAutoFarm()
	stopAutoLoot()

	cancelTween()

	State.Noclip = false
	State.NoclipRequests = {}

	restoreNoclip()
	restoreVisuals()

	for property, value in pairs(
		State.OriginalLighting
	) do
		Lighting[property] = value
	end

	State.OriginalLighting = {}

	for _, connection in pairs(
		State.Connections
	) do

		if typeof(connection)
			== "RBXScriptConnection" then

			connection:Disconnect()
		end
	end

	for player in pairs(State.ESPObjects) do
		clearESP(player)
	end

	State.ESPObjects = {}
end

Gui.Destroying:Connect(cleanup)

notify("Utility loaded.")
