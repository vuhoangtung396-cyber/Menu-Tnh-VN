    local LagCache = {}

    StartFixLag = function()
        if State.Destroyed then return end

        LagCache = {}

        for _,obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter")
                or obj:IsA("Trail")
                or obj:IsA("Beam")
                or obj:IsA("Smoke")
                or obj:IsA("Fire")
                or obj:IsA("Sparkles")
            then
                LagCache[obj] = obj.Enabled
                pcall(function()
                    obj.Enabled = false
                end)
            end
        end

        pcall(function()
            Lighting.GlobalShadows = false
        end)
    end

    StopFixLag = function()
        for obj,value in pairs(LagCache) do
            if obj and obj.Parent then
                pcall(function()
                    obj.Enabled = value
                end)
            end
        end

        LagCache = {}

        pcall(function()
            Lighting.GlobalShadows = true
        end)
    end

    --==================================================
    -- AUTO STEAL
    --==================================================

    local AutoStealThread

    local function GetPromptPart(prompt)
        if not prompt then return nil end

        local parent = prompt.Parent

        if parent:IsA("BasePart") then
            return parent
        end

        if parent:IsA("Attachment") and parent.Parent:IsA("BasePart") then
            return parent.Parent
        end

        local part = prompt:FindFirstAncestorWhichIsA("BasePart")

        if part then
            return part
        end

        local model = prompt:FindFirstAncestorOfClass("Model")

        if model then
            return GetRoot(model)
        end

        return nil
    end

    local function PromptText(prompt)
        return string.lower(
            tostring(prompt.ActionText or "").." "..tostring(prompt.ObjectText or "")
        )
    end

    local function IsEggPrompt(prompt)
        if not prompt:IsA("ProximityPrompt") then
            return false
        end

        local text = PromptText(prompt)

        return text:find("egg")
            or text:find("trứng")
            or text:find("steal")
            or text:find("take")
            or text:find("pick")
            or text:find("grab")
    end

    local function FindBestEggPrompt()
        local char,hum,root = GetChar()

        if not root then return nil end

        local best
        local bestDist = math.huge

        for _,prompt in ipairs(Workspace:GetDescendants()) do
            if IsEggPrompt(prompt)
                and prompt.Enabled
            then
                local part = GetPromptPart(prompt)

                if part then
                    local d = (root.Position - part.Position).Magnitude

                    if d < bestDist then
                        bestDist = d
                        best = prompt
                    end
                end
            end
        end

        return best
    end

    local function ActivatePrompt(prompt)
        if not prompt then return false end

        for i = 1,3 do
            pcall(function()
                if typeof(fireproximityprompt) == "function" then
                    fireproximityprompt(prompt)
                else
                    prompt:InputHoldBegin()
                    task.wait(math.max(prompt.HoldDuration,0.05))
                    prompt:InputHoldEnd()
                end
            end)

            task.wait(0.15)

            if not prompt.Parent then
                return true
            end
        end

        return true
    end

    local function DetectCarryingEgg()
        local char = LP.Character

        if not char then return false end

        local names = {
            "egg",
            "trứng",
            "carrying",
            "stolen",
            "hold"
        }

        for _,obj in ipairs(char:GetDescendants()) do
            local n = string.lower(obj.Name or "")

            for _,word in ipairs(names) do
                if n:find(word) then
                    if obj:IsA("Tool")
                        or obj:IsA("Model")
                        or obj:IsA("BasePart")
                    then
                        return true
                    end
                end
            end
        end

        return false
    end

    local function WalkToPosition(position,timeout)
        local char,hum,root = GetChar()

        if not hum or not root then
            return false
        end

        hum:MoveTo(position)

        local start = tick()

        while tick() - start < timeout do
            if not State.AutoSteal then
                return false
            end

            if not root.Parent then
                return false
            end

            if (root.Position - position).Magnitude <= 5 then
                return true
            end

            task.wait(0.08)
        end

        return (root.Position - position).Magnitude <= 10
    end

    local function MoveNear(part)
        if not part then return false end

        local char,hum,root = GetChar()

        if not hum or not root then
            return false
        end

        local direction = part.Position - root.Position

        if direction.Magnitude < 4 then
            return true
        end

        local distance = math.min(
            math.max(direction.Magnitude - 3,0),
            12
        )

        local target = root.Position + direction.Unit * distance

        return WalkToPosition(target,5)
    end

    local function FindDeliveryPrompt()
        local char,hum,root = GetChar()

        if not root then return nil end

        local best
        local bestScore = math.huge

        for _,prompt in ipairs(Workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt")
                and prompt.Enabled
            then
                local text = PromptText(prompt)

                local valid =
                    text:find("deliver")
                    or text:find("deposit")
                    or text:find("place")
                    or text:find("drop")
                    or text:find("return")
                    or text:find("base")
                    or text:find("put")

                if valid then
                    local part = GetPromptPart(prompt)

                    if part then
                        local distance =
                            (root.Position - part.Position).Magnitude

                        local score = distance

                        local ancestor = prompt.Parent

                        while ancestor and ancestor ~= Workspace do
                            local n = string.lower(ancestor.Name or "")

                            if n:find(string.lower(LP.Name))
                                or n:find(string.lower(LP.DisplayName))
                            then
                                score -= 10000
                                break
                            end

                            ancestor = ancestor.Parent
                        end

                        if score < bestScore then
                            bestScore = score
                            best = prompt
                        end
                    end
                end
            end
        end

        return best
    end

    StartAutoSteal = function()
        if AutoStealThread then return end

        AutoStealThread = task.spawn(function()
            while State.AutoSteal and not State.Destroyed do

                -- FIND EGG
                local eggPrompt = FindBestEggPrompt()

                if eggPrompt then
                    local eggPart = GetPromptPart(eggPrompt)

                    if eggPart then
                        -- MOVE TO EGG
                        MoveNear(eggPart)

                        task.wait(0.15)

                        -- FIND AGAIN BECAUSE OBJECT MAY HAVE MOVED
                        eggPrompt = FindBestEggPrompt()

                        if eggPrompt then
                            ActivatePrompt(eggPrompt)
                        end

                        -- WAIT FOR CARRY
                        local carryStart = tick()

                        while State.AutoSteal
                            and tick() - carryStart < 2
                        do
                            if DetectCarryingEgg() then
                                break
                            end

                            task.wait(0.1)
                        end

                        task.wait(0.2)

                        -- FIND DELIVERY
                        local delivery = FindDeliveryPrompt()

                        if delivery then
                            local deliveryPart = GetPromptPart(delivery)

                            if deliveryPart then
                                MoveNear(deliveryPart)

                                task.wait(0.15)

                                ActivatePrompt(delivery)

                                task.wait(0.5)
                            end
                        end
                    end
                end

                task.wait(0.25)
            end

            AutoStealThread = nil
        end)
    end

    StopAutoSteal = function()
        State.AutoSteal = false
        AutoStealThread = nil
    end

