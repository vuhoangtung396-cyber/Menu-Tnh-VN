        end

        local function Hold(button,func)
            button.MouseButton1Down:Connect(function()
                func(true)
            end)

            button.MouseButton1Up:Connect(function()
                func(false)
            end)

            button.MouseLeave:Connect(function()
                func(false)
            end)

            button.TouchLongPress:Connect(function(_,state)
                if state == Enum.UserInputState.Begin then
                    func(true)
                elseif state == Enum.UserInputState.End then
                    func(false)
                end
            end)
        end

        Hold(Up,function(v)
            FlyUp = v
        end)

        Hold(Down,function(v)
            FlyDown = v
        end)

        Connections.FlyUpButton = Up
        Connections.FlyDownButton = Down
    end

    StartFly = function()
        if State.Destroyed then return end
        if FlyConn then return end

        local char,hum,root = GetChar()

        if not hum or not root then
            State.Fly = false
            return
        end

        CreateFlyButtons()

        FlyVel = Instance.new("BodyVelocity")
        FlyVel.Name = "TnhVN_FlyVelocity"
        FlyVel.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
        FlyVel.P = 9000
        FlyVel.Velocity = Vector3.zero
        FlyVel.Parent = root

        FlyGyro = Instance.new("BodyGyro")
        FlyGyro.Name = "TnhVN_FlyGyro"
        FlyGyro.MaxTorque = Vector3.new(math.huge,math.huge,math.huge)
        FlyGyro.P = 50000
        FlyGyro.D = 1000
        FlyGyro.CFrame = root.CFrame
        FlyGyro.Parent = root

        hum.AutoRotate = false

        if Connections.FlyUpButton then
            Connections.FlyUpButton.Visible = true
        end

        if Connections.FlyDownButton then
            Connections.FlyDownButton.Visible = true
        end

        FlyConn = RunService.RenderStepped:Connect(function()
            if not State.Fly or not root.Parent then
                StopFly()
                return
            end

            local camera = Workspace.CurrentCamera
            local move = hum.MoveDirection

            -- MOBILE JOYSTICK
            if move.Magnitude > 0.05 then
                move = move.Unit * State.FlyValue
            else
                move = Vector3.zero

                -- KEYBOARD
                if UIS:IsKeyDown(Enum.KeyCode.W) then
                    move += camera.CFrame.LookVector
                end

                if UIS:IsKeyDown(Enum.KeyCode.S) then
                    move -= camera.CFrame.LookVector
                end

                if UIS:IsKeyDown(Enum.KeyCode.A) then
                    move -= camera.CFrame.RightVector
                end

                if UIS:IsKeyDown(Enum.KeyCode.D) then
                    move += camera.CFrame.RightVector
                end

                if move.Magnitude > 0 then
                    move = move.Unit * State.FlyValue
                end
            end

            if FlyUp then
                move += Vector3.new(0,State.FlyValue,0)
            end

            if FlyDown then
                move -= Vector3.new(0,State.FlyValue,0)
            end

            FlyVel.Velocity = move

            local look = camera.CFrame.LookVector

            FlyGyro.CFrame = CFrame.lookAt(
                root.Position,
                root.Position + look
            )
        end)
    end

    StopFly = function()
        RemoveConnection("Fly")

        if FlyConn then
            pcall(function()
                FlyConn:Disconnect()
            end)
            FlyConn = nil
        end

        if FlyVel then
            pcall(function()
                FlyVel:Destroy()
            end)
            FlyVel = nil
        end

        if FlyGyro then
            pcall(function()
                FlyGyro:Destroy()
            end)
            FlyGyro = nil
        end

        local char,hum = GetChar()

        if hum then
            hum.AutoRotate = true
        end

        FlyUp = false
        FlyDown = false

        if Connections.FlyUpButton then
            Connections.FlyUpButton.Visible = false
        end

        if Connections.FlyDownButton then
            Connections.FlyDownButton.Visible = false
        end
    end

