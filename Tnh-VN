local ESP = {}

local function RemoveESP(Player)
    local H = ESP[Player]

    if H then
        pcall(function()
            H:Destroy()
        end)

        ESP[Player] = nil
    end
end

local function AddESP(Player)
    if Player == LP then
        return
    end

    if not Config.ESP then
        RemoveESP(Player)
        return
    end

    local Char = Player.Character

    if not Char then
        return
    end

    local Old = Char:FindFirstChild("TNH_BOX_ESP")

    if Old then
        Old.FillColor = Config.ESPColor
        Old.OutlineColor = Config.ESPColor
        ESP[Player] = Old
        return
    end

    local H = Instance.new("Highlight")
    H.Name = "TNH_BOX_ESP"
    H.Adornee = Char
    H.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    H.FillColor = Config.ESPColor
    H.OutlineColor = Config.ESPColor
    H.FillTransparency = 0.88
    H.OutlineTransparency = 0
    H.Parent = Char

    ESP[Player] = H
end

task.spawn(function()
    while task.wait(0.5) do
        for _, P in ipairs(Players:GetPlayers()) do
            if P ~= LP then
                AddESP(P)
            end
        end
    end
end)

