-- ANTI TRAP
local ATC
local DTs={}
local function DT(o)
    if not o:IsA("BasePart") then return end
    local n=o.Name:lower()
    if n:find("trap") or n:find("bear") or n:find("bẫy") or n:find("spike") or n:find("snare") or n:find("hunter") then
        DTs[o]={CC=o.CanCollide,CT=o.CanTouch}
        pcall(function() o.CanCollide=false;o.CanTouch=false end)
    end
end
local ATt=Tog(StealP,T("antiTrap"),T("antiTrapD"),function(v)
    S.AntiTrap=v
    if v then
        if ATC then ATC:Disconnect() end
        for _,o in ipairs(WS:GetDescendants()) do DT(o) end
        ATC=WS.DescendantAdded:Connect(function(o) if S.AntiTrap then DT(o) end end)
    else
        if ATC then ATC:Disconnect();ATC=nil end
        for o,vv in pairs(DTs) do
            if o.Parent then pcall(function() o.CanCollide=vv.CC;o.CanTouch=vv.CT end) end
        end
        DTs={}
    end
end)

-- SCRIPT CARD
local function ScriptCard(parent,title,desc,url)
    local r=Row(parent,82)
    local t=Lbl(r,title,15,UDim2.new(0,16,0,12))
    t.Font=Enum.Font.GothamBold
    local d=Lbl(r,desc,11,UDim2.new(0,16,0,38))
    d.TextColor3=P.TextMute;d.Size=UDim2.new(1,-160,0,20)
    local b=Instance.new("TextButton")
    b.Size=UDim2.new(0,120,0,32);b.Position=UDim2.new(1,-134,.5,-16)
    b.BackgroundColor3=P.Yellow;b.BorderSizePixel=0
    b.Text="EXECUTE";b.TextColor3=Color3.fromRGB(30,25,45)
    b.TextSize=12;b.Font=Enum.Font.GothamBold;b.AutoButtonColor=false
    b.ZIndex=15;b.Parent=r;Corner(b,10)
    Grad(b,P.Yellow,P.YellowHi)
    b.MouseButton1Click:Connect(function()
        b.Text="LOADING..."
        task.spawn(function()
            local ok,err=pcall(function()
                local code=game:HttpGet(url)
                local fn=loadstring(code)
                if fn then fn() else error("loadstring failed") end
            end)
            if ok then
                b.Text="EXECUTED";task.wait(1);b.Text="EXECUTE"
            else
                b.Text="ERROR";warn("[Tnh-VN] "..tostring(err))
                task.wait(1.5);b.Text="EXECUTE"
            end
        end)
    end)
    return r
end

