    --====================================================
    -- AUTO STEAL
    --====================================================

    local function IsEggPrompt(Prompt)

        local Text = string.lower(
            tostring(Prompt.Name).." "
            ..tostring(Prompt.ActionText).." "
            ..tostring(Prompt.ObjectText)
        )

        return
            string.find(Text,"egg") ~= nil
            or string.find(Text,"steal") ~= nil
            or string.find(Text,"grab") ~= nil
            or string.find(Text,"take") ~= nil

    end

    local function PromptPosition(Prompt)

        local Parent = Prompt.Parent

        if Parent:IsA("BasePart") then
            return Parent.Position
        end

        if Parent:IsA("Attachment") then
            return Parent.WorldPosition
        end

        local Model = Parent:FindFirstAncestorOfClass("Model")

        if Model then

            if Model.PrimaryPart then
                return Model.PrimaryPart.Position
            end

            local Part =
                Model:FindFirstChildWhichIsA(
                    "BasePart",
                    true
                )

            if Part then
                return Part.Position
            end

        end

        return nil

    end

    local function FindEgg()

        if not Root then
            return nil
        end

        local Closest
        local Distance = math.huge

        for _,Object in ipairs(Workspace:GetDescendants()) do

            if Object:IsA("ProximityPrompt")
            and Object.Enabled
            and IsEggPrompt(Object) then

                local Position = PromptPosition(Object)

                if Position then

                    local D =
                        (Root.Position-Position).Magnitude

                    if D < Distance then

                        Distance = D

                        Closest = {
                            Prompt = Object,
                            Position = Position
                        }

                    end

                end

            end

        end

        return Closest

    end

    local function Steal(Egg)

        if not Egg or not Root then
            return
        end

        local Prompt = Egg.Prompt

        if not Prompt or not Prompt.Enabled then
            return
        end

        -- Đưa nhân vật tới gần prompt
        pcall(function()

            Root.CFrame =
                CFrame.new(
                    Egg.Position+
                    Vector3.new(0,2.5,0)
                )

        end)

        task.wait(.15)

        -- Hỗ trợ executor có fireproximityprompt
        if typeof(fireproximityprompt) == "function" then

            pcall(function()
                fireproximityprompt(Prompt)
            end)

            task.wait(.1)

            pcall(function()
                fireproximityprompt(
                    Prompt,
                    Prompt.HoldDuration+.1
                )
            end)

        end

    end

    task.spawn(function()

        while MainGui and MainGui.Parent do

            if Config.AutoSteal then

                local Egg = FindEgg()

                if Egg then
                    Steal(Egg)
                end

                task.wait(.35)

            else

                task.wait(.5)

            end

        end

    end)

end

