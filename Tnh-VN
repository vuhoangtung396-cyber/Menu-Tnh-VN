--========================================================--
-- FLY
--========================================================--

local FlyVel
local FlyGyro
local FlyConn
local FlyKeys = {}

Connect(UIS.InputBegan,function(input,gp)

    if gp then return end

    FlyKeys[input.KeyCode] = true

end)

Connect(UIS.InputEnded,function(input)

    FlyKeys[input.KeyCode] = nil

end)

StartFly = function()

    if State.Fly then
        return
    end

    State.Fly = true

    local char = GetChar()

    Root =
        char:FindFirstChild("HumanoidRootPart")
        or char:WaitForChild("HumanoidRootPart")

    Humanoid =
        char:FindFirstChildOfClass("Humanoid")

    if FlyVel then
        FlyVel:Destroy()
    end

    if FlyGyro then
        FlyGyro:Destroy()
    end

    FlyVel = Instance.new("BodyVelocity")
    FlyVel.MaxForce = Vector3.new(
        math.huge,
        math.huge,
        math.huge
    )
    FlyVel.Velocity = Vector3.zero
    FlyVel.Parent = Root

    FlyGyro = Instance.new("BodyGyro")
    FlyGyro.MaxTorque = Vector3.new(
        math.huge,
        math.huge,
        math.huge
    )
    FlyGyro.P = 10000
    FlyGyro.CFrame = Root.CFrame
    FlyGyro.Parent = Root

    if FlyConn then
        FlyConn:Disconnect()
    end

    FlyConn = RunService.RenderStepped:Connect(function()

        if not State.Fly then
            return
        end

        if not Root or not Root.Parent then
            return
        end

        local Camera = Workspace.CurrentCamera

        if not Camera then
            return
        end

        local move = Vector3.zero

        if FlyKeys[Enum.KeyCode.W] then
            move += Camera.CFrame.LookVector
        end

        if FlyKeys[Enum.KeyCode.S] then
            move -= Camera.CFrame.LookVector
        end

        if FlyKeys[Enum.KeyCode.A] then
            move -= Camera.CFrame.RightVector
        end

        if FlyKeys[Enum.KeyCode.D] then
            move += Camera.CFrame.RightVector
        end

        if FlyKeys[Enum.KeyCode.Space] then
            move += Vector3.new(0,1,0)
        end

        if FlyKeys[Enum.KeyCode.LeftControl] then
            move -= Vector3.new(0,1,0)
        end

        if Humanoid and Humanoid.MoveDirection.Magnitude > 0 then

            move += Humanoid.MoveDirection

        end

        if move.Magnitude > 0 then
            move = move.Unit * State.FlyValue
        else
            move = Vector3.zero
        end

        FlyVel.Velocity = move
        FlyGyro.CFrame = Camera.CFrame

    end)

end

StopFly = function()

    State.Fly = false

    if FlyConn then
        FlyConn:Disconnect()
        FlyConn = nil
    end

    if FlyVel then
        FlyVel:Destroy()
        FlyVel = nil
    end

    if FlyGyro then
        FlyGyro:Destroy()
        FlyGyro = nil
    end

end

--========================================================--
-- FIX LAG
--========================================================--

local FixCache = {}
local FixConnection

local function DisableObject(obj)

    if FixCache[obj] then
        return
    end

    local data = {
        obj = obj
    }

    if obj:IsA("ParticleEmitter")
    or obj:IsA("Trail")
    or obj:IsA("Beam")
    or obj:IsA("Smoke")
    or obj:IsA("Fire")
    or obj:IsA("Sparkles")
    or obj:IsA("PostEffect") then

        data.type = "Enabled"
        data.value = obj.Enabled

        obj.Enabled = false

    elseif obj:IsA("PointLight")
    or obj:IsA("SpotLight")
    or obj:IsA("SurfaceLight") then

        data.type = "Enabled"
        data.value = obj.Enabled

        obj.Enabled = false

    elseif obj:IsA("Decal")
    or obj:IsA("Texture") then

        data.type = "Transparency"
        data.value = obj.Transparency

        obj.Transparency = 1

    elseif obj:IsA("BasePart") then

        data.type = "Part"
        data.cast = obj.CastShadow
        data.reflect = obj.Reflectance
        data.material = obj.Material

        obj.CastShadow = false
        obj.Reflectance = 0

        pcall(function()
            obj.Material = Enum.Material.Plastic
        end)

    elseif obj:IsA("Sound") then

        data.type = "Volume"
        data.value = obj.Volume

        obj.Volume = 0

    elseif obj:IsA("Sky") then

        data.type = "Parent"
        data.value = obj.Parent

        obj.Parent = nil

    else
        return
    end

    FixCache[obj] = data
end

StartFixLag = function()

    if State.FixLag then
        return
    end

    State.FixLag = true

    for _,obj in ipairs(Lighting:GetDescendants()) do
        DisableObject(obj)
    end

    for _,obj in ipairs(Workspace:GetDescendants()) do
        DisableObject(obj)
    end

    if FixConnection then
        FixConnection:Disconnect()
    end

    FixConnection = Workspace.DescendantAdded:Connect(function(obj)

        if State.FixLag then
            task.defer(function()
                DisableObject(obj)
            end)
        end

    end)

    pcall(function()
        Lighting.GlobalShadows = false
    end)

end

StopFixLag = function()

    if not State.FixLag then
        return
    end

    State.FixLag = false

    if FixConnection then
        FixConnection:Disconnect()
        FixConnection = nil
    end

    for obj,data in pairs(FixCache) do

        if obj and obj.Parent then

            if data.type == "Enabled" then

                pcall(function()
                    obj.Enabled = data.value
                end)

            elseif data.type == "Transparency" then

                pcall(function()
                    obj.Transparency = data.value
                end)

            elseif data.type == "Volume" then

                pcall(function()
                    obj.Volume = data.value
                end)

            elseif data.type == "Part" then

                pcall(function()
                    obj.CastShadow = data.cast
                    obj.Reflectance = data.reflect
                    obj.Material = data.material
                end)

            elseif data.type == "Parent" then

                pcall(function()
                    obj.Parent = data.value
                end)

            end
        end
    end

    table.clear(FixCache)

    pcall(function()
        Lighting.GlobalShadows = true
    end)

end

--========================================================--
-- AUTO STEAL
--========================================================--

local AutoThread = false
local AutoStopToken = 0

local EggWords = {
    "egg",
    "trung",
    "steal egg",
    "take egg",
    "grab egg",
    "pickup egg",
    "pick up egg",
    "steal",
    "take",
    "grab",
    "pickup"
}

local DeliveryWords = {
    "place egg",
    "drop egg",
    "deliver egg",
    "deposit egg",
    "hatch egg",
    "place",
    "deliver",
    "deposit"
}

local BadEggWords = {
    "shop",
    "upgrade",
    "machine",
    "treadmill",
    "fuse",
    "display",
    "sell"
}

local function Lower(v)
    return tostring(v or ""):lower()
end

local function HasWord(text,list)

    text = Lower(text)

    for _,word in ipairs(list) do

        if text:find(word,1,true) then
            return true
        end

    end

    return false
end

local function PromptText(prompt)

    if not prompt then
        return ""
    end

    local text = ""

    pcall(function()
        text = text .. " " .. Lower(prompt.ActionText)
    end)

    pcall(function()
        text = text .. " " .. Lower(prompt.ObjectText)
    end)

    local obj = prompt.Parent

    for i = 1,6 do

        if not obj then
            break
        end

        text = text .. " " .. Lower(obj.Name)

        obj = obj.Parent
    end

    return text
end

local function PromptPart(prompt)

    if not prompt then
        return nil
    end

    local parent = prompt.Parent

    if parent and parent:IsA("BasePart") then
        return parent
    end

    if parent then

        local p =
            parent:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

        if p then
            return p
        end
    end

    return nil
end

--========================================================--
-- EGG PROMPT FINDER
--========================================================--

local function FindEggPrompt()

    local root = GetRoot()

    if not root then
        return nil
    end

    local nearest
    local nearestDistance = math.huge

    for _,obj in ipairs(Workspace:GetDescendants()) do

        if obj:IsA("ProximityPrompt")
        and obj.Enabled ~= false then

            local text = PromptText(obj)

            if HasWord(text,EggWords)
            and not HasWord(text,BadEggWords) then

                local part = PromptPart(obj)

                if part then

                    local distance =
                        (root.Position-part.Position).Magnitude

                    if distance < nearestDistance then

                        nearestDistance = distance
                        nearest = obj

                    end
                end
            end
        end
    end

    return nearest
end

--========================================================--
-- DELIVERY PROMPT FINDER
--========================================================--

local function FindDeliveryPrompt()

    local root = GetRoot()

    if not root then
        return nil
    end

    local nearest
    local nearestDistance = math.huge

    for _,obj in ipairs(Workspace:GetDescendants()) do

        if obj:IsA("ProximityPrompt")
        and obj.Enabled ~= false then

            local text = PromptText(obj)

            if HasWord(text,DeliveryWords) then

                local part = PromptPart(obj)

                if part then

                    local distance =
                        (root.Position-part.Position).Magnitude

                    if distance < nearestDistance then

                        nearestDistance = distance
                        nearest = obj

                    end
                end
            end
        end
    end

    return nearest
end

--========================================================--
-- FIRE PROMPT
--========================================================--

local function FirePrompt(prompt)

    if not prompt then
        return false
    end

    local fired = false

    if typeof(fireproximityprompt) == "function" then

        pcall(function()

            fireproximityprompt(
                prompt,
                prompt.HoldDuration or 0
            )

            fired = true

        end)

    end

    if fired then
        return true
    end

    pcall(function()

        prompt:InputHoldBegin()

        local duration =
            math.max(
                tonumber(prompt.HoldDuration) or 0,
                0.08
            )

        task.wait(duration)

        prompt:InputHoldEnd()

        fired = true

    end)

    return fired
end

--========================================================--
-- CARRY DETECTION
--========================================================--

local function IsCarryingEgg()

    local char = LP.Character

    if not char then
        return false
    end

    local attrs = {
        "HasEgg",
        "CarryingEgg",
        "CarryEgg",
        "HoldingEgg",
        "IsCarrying",
        "Holding",
        "HasCarriedEgg"
    }

    for _,attribute in ipairs(attrs) do

        local value = char:GetAttribute(attribute)

        if value == true then
            return true
        end
    end

    -- tool / model
    for _,obj in ipairs(char:GetChildren()) do

        local n = Lower(obj.Name)

        if n:find("egg",1,true)
        or n:find("trung",1,true) then

            if obj:IsA("Tool")
            or obj:IsA("Model")
            or obj:IsA("BasePart") then

                return true
            end
        end
    end

    -- backpack
    local backpack =
        LP:FindFirstChildOfClass("Backpack")

    if backpack then

        for _,obj in ipairs(backpack:GetChildren()) do

            local n = Lower(obj.Name)

            if n:find("egg",1,true)
            or n:find("trung",1,true) then

                return true
            end
        end
    end

    -- descendant check
    for _,obj in ipairs(char:GetDescendants()) do

        local n = Lower(obj.Name)

        if n == "carryingegg"
        or n == "carriedegg"
        or n == "heldegg" then

            return true
        end
    end

    return false
end

--========================================================--
-- BASE / PEN FINDER
--========================================================--

local function FindOwnBase()

    local root = GetRoot()

    if not root then
        return nil
    end

    local playerName = Lower(LP.Name)
    local displayName = Lower(LP.DisplayName)

    local containers = {
        "Bases",
        "Base",
        "Plots",
        "Plot",
        "Pens",
        "Pans",
        "PlayerBases",
        "PlayerPlots"
    }

    -- ưu tiên container có tên player
    for _,containerName in ipairs(containers) do

        local container =
            Workspace:FindFirstChild(containerName)

        if container then

            for _,obj in ipairs(container:GetDescendants()) do

                local n = Lower(obj.Name)

                if n:find(playerName,1,true)
                or n:find(displayName,1,true) then

                    if obj:IsA("BasePart") then
                        return obj
                    end

                    local part =
                        obj:FindFirstChildWhichIsA(
                            "BasePart",
                            true
                        )

                    if part then
                        return part
                    end
                end
            end
        end
    end

    return nil
end

--========================================================--
-- MOVE
--========================================================--

local function MoveSmooth(target)

    if not target then
        return false
    end

    local root = GetRoot()

    if not root then
        return false
    end

    local targetPosition

    if typeof(target) == "Vector3" then
        targetPosition = target
    elseif target:IsA("BasePart") then
        targetPosition = target.Position
    else
        return false
    end

    local distance =
        (root.Position-targetPosition).Magnitude

    if distance < 5 then
        return true
    end

    -- chia thành nhiều đoạn để không teleport một phát
    local segment = math.clamp(
        35 + State.StealSpeed * 0.18,
        35,
        65
    )

    local segments =
        math.max(1,math.ceil(distance/segment))

    for i = 1,segments do

        if not State.AutoSteal then
            return false
        end

        root = GetRoot()

        if not root then
            return false
        end

        local current = root.Position

        local alpha =
            math.min(
                1,
                segment /
                math.max(
                    (targetPosition-current).Magnitude,
                    0.01
                )
            )

        local nextPosition =
            current:Lerp(targetPosition,alpha)

        local distanceToMove =
            (nextPosition-current).Magnitude

        local duration =
            math.clamp(
                distanceToMove /
                math.max(State.StealSpeed,1),
                0.08,
                0.35
            )

        local tween = TweenService:Create(
            root,
            TweenInfo.new(
                duration,
                Enum.EasingStyle.Linear
            ),
            {
                CFrame =
                    CFrame.new(nextPosition)
            }
        )

        tween:Play()
        tween.Completed:Wait()

        if (root.Position-targetPosition).Magnitude < 6 then
            return true
        end
    end

    return true
end

--========================================================--
-- WAIT FOR CARRY
--========================================================--

local function WaitForCarry(timeout)

    local start = tick()

    while tick()-start < timeout do

        if not State.AutoSteal then
            return false
        end

        if IsCarryingEgg() then
            return true
        end

        task.wait(0.1)
    end

    return false
end

--========================================================--
-- WAIT FOR DELIVERY
--========================================================--

local function WaitForDelivery(timeout)

    local start = tick()

    while tick()-start < timeout do

        if not State.AutoSteal then
            return false
        end

        if not IsCarryingEgg() then
            return true
        end

        task.wait(0.12)
    end

    return false
end

--========================================================--
-- AUTO STEAL
--========================================================--

StartAutoSteal = function()

    if AutoThread then
        return
    end

    State.AutoSteal = true
    AutoThread = true

    AutoStopToken += 1

    local myToken = AutoStopToken

    task.spawn(function()

        while State.AutoSteal
        and not State.Destroyed
        and myToken == AutoStopToken do

            ------------------------------------------------
            -- CHARACTER READY
            ------------------------------------------------

            local root = GetRoot()

            if not root then
                task.wait(0.5)
                continue
            end

            ------------------------------------------------
            -- ALREADY CARRYING
            ------------------------------------------------

            if IsCarryingEgg() then

                local delivered = false

                -- ưu tiên delivery prompt
                for attempt = 1,3 do

                    if not State.AutoSteal then
                        break
                    end

                    local prompt =
                        FindDeliveryPrompt()

                    if prompt then

                        local part =
                            PromptPart(prompt)

                        if part then

                            MoveSmooth(part.Position)

                            task.wait(0.15)

                            FirePrompt(prompt)

                            if WaitForDelivery(2.5) then

                                delivered = true
                                break

                            end
                        end
                    else
                        break
                    end

                    task.wait(0.3)
                end

                ------------------------------------------------
                -- fallback: own base
                ------------------------------------------------

                if not delivered then

                    local base =
                        FindOwnBase()

                    if base then

                        MoveSmooth(base.Position)

                        task.wait(0.25)

                        local prompt =
                            FindDeliveryPrompt()

                        if prompt then

                            local part =
                                PromptPart(prompt)

                            if part then

                                MoveSmooth(part.Position)

                                task.wait(0.15)

                                FirePrompt(prompt)

                                delivered =
                                    WaitForDelivery(3)

                            end
                        end
                    end
                end

                if delivered then
                    task.wait(0.45)
                else
                    -- Không coi như thành công.
                    -- Chờ prompt giao xuất hiện lại.
                    task.wait(0.6)
                end

            ------------------------------------------------
            -- NOT CARRYING
            ------------------------------------------------

            else

                local eggPrompt =
                    FindEggPrompt()

                if eggPrompt then

                    local part =
                        PromptPart(eggPrompt)

                    if part then

                        local moved =
                            MoveSmooth(part.Position)

                        if moved and State.AutoSteal then

                            task.wait(0.12)

                            FirePrompt(eggPrompt)

                            -- xác nhận thực sự đã lấy
                            local gotEgg =
                                WaitForCarry(2.2)

                            if gotEgg then

                                task.wait(0.15)

                            else

                                -- prompt cũ có thể đã hết hiệu lực
                                task.wait(0.35)
                            end
                        end
                    end

                else

                    -- không có target
                    task.wait(0.35)
                end
            end

            task.wait(0.08)
        end

        AutoThread = false

    end)

end

StopAutoSteal = function()

    State.AutoSteal = false
    AutoStopToken += 1

end

