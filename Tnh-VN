local function createDropdown(title, items, callback)
	local container = Instance.new("Frame")

	container.Size = UDim2.new(1, -4, 0, 70)
	container.BackgroundTransparency = 1
	container.Parent = Scroll

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 22)
	label.BackgroundTransparency = 1
	label.Text = title
	label.TextColor3 = Color3.fromRGB(210, 210, 220)
	label.TextSize = 12
	label.Font = Enum.Font.GothamMedium
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = container

	local search = Instance.new("TextBox")
	search.Position = UDim2.fromOffset(0, 25)
	search.Size = UDim2.new(1, 0, 0, 34)
	search.BackgroundColor3 = Color3.fromRGB(42, 44, 53)
	search.BorderSizePixel = 0
	search.Text = ""
	search.PlaceholderText = "Search / chọn..."
	search.TextColor3 = Color3.new(1, 1, 1)
	search.TextSize = 12
	search.Font = Enum.Font.Gotham
	search.Parent = container

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = search

	local current = nil

	local function refresh()
		local query = string.lower(search.Text)

		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end

		local y = 64

		for _, item in ipairs(items()) do
			if query == "" or string.find(
				string.lower(item),
				query,
				1,
				true
			) then

				local button = Instance.new("TextButton")
				button.Position = UDim2.fromOffset(0, y)
				button.Size = UDim2.new(1, 0, 0, 28)
				button.BackgroundColor3 = Color3.fromRGB(48, 50, 60)
				button.Text = item
				button.TextColor3 = Color3.new(1, 1, 1)
				button.TextSize = 11
				button.Font = Enum.Font.Gotham
				button.Parent = container

				button.Activated:Connect(function()
					current = item
					search.Text = item
					callback(item)
				end)

				y += 30
			end
		end

		container.Size = UDim2.new(1, -4, 0, math.max(70, y))
	end

	search:GetPropertyChangedSignal("Text"):Connect(refresh)

	refresh()

	return container
end

