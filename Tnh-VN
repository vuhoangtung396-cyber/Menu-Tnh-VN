-- ESP
-- ============================================================
local ESP = { active = false, data = {}, thread = nil }

local function clearESPFor(player)
    local d = ESP.data[player]
    if not d then return end
    if d.highlight then d.highlight:Destroy() end
    if d.billboard then d.billboard:Destroy() end
    if d.conns then for _, c in ipairs(d.conns) do c:Disconnect() end end
    ESP.data[player] = nil
end

local function clearAllESP()
    for p in pairs(ESP.data) do clearESPFor(p) end
    ESP.data = {}
end

local function makeESP(player)
    if player == LocalPlayer then return end
    clearESPFor(player)
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not head or not hum then return end

    local hl = Instance.new("Highlight")
    hl.FillColor = CONFIG.ESPColors.Fill
    hl.OutlineColor = CONFIG.ESPColors.Outline
    hl.FillTransparency = 0.6
    hl.OutlineTransparency = 0
    hl.Adornee = char
    hl.Parent = gui

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.fromOffset(180, 46)
    bb.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = head
    bb.Parent = gui

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size = UDim2.new(1, 0, 0, 14)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = player.Name
    nameLbl.TextColor3 = CONFIG.ESPColors.Text
    nameLbl.Font = Enum.Font.GothamBold; nameLbl.TextSize = 12
    nameLbl.TextStrokeTransparency = 0.4
    nameLbl.Visible = CONFIG.ESPShowName
    nameLbl.Parent = bb

    local distLbl = Instance.new("TextLabel")
    distLbl.Size = UDim2.new(1, 0, 0, 12)
    distLbl.Position = UDim2.fromOffset(0, 14)
    distLbl.BackgroundTransparency = 1
    distLbl.TextColor3 = CONFIG.ESPColors.Text
    distLbl.Font = Enum.Font.Gotham; distLbl.TextSize = 11
    distLbl.TextStrokeTransparency = 0.4
    distLbl.Visible = CONFIG.ESPShowDistance
    distLbl.Parent = bb

    local hpBg = Instance.new("Frame")
    hpBg.Size = UDim2.new(1, -20, 0, 4)
    hpBg.Position = UDim2.new(0, 10, 1, -6)
    hpBg.BackgroundColor3 = CONFIG.ESPColors.HealthBg
    hpBg.BorderSizePixel = 0
    hpBg.Visible = CONFIG.ESPShowHealth
    hpBg.Parent = bb
    Instance.new("UICorner", hpBg).CornerRadius = UDim.new(1, 0)

    local hpFill = Instance.new("Frame")
    hpFill.Size = UDim2.new(1, 0, 1, 0)
    hpFill.BackgroundColor3 = CONFIG.ESPColors.HealthFill
    hpFill.BorderSizePixel = 0
    hpFill.Parent = hpBg
    Instance.new("UICorner", hpFill).CornerRadius = UDim.new(1, 0)

    local conns = {}
    table.insert(conns, hum.HealthChanged:Connect(function() end))
    table.insert(conns, player.CharacterAdded:Connect(function()
        task.wait(0.3)
        if ESP.active then makeESP(player) end
    end))

    ESP.data[player] = { highlight = hl, billboard = bb, hum = hum, distLbl = distLbl, hpFill = hpFill, conns = conns }
end

local function updateESP()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    for player, d in pairs(ESP.data) do
        local char = player.Character
        if not char or not d.hum or not d.hum.Parent then
            clearESPFor(player)
        else
            if d.highlight then d.highlight.Enabled = true end
            local hp = math.clamp(d.hum.Health / d.hum.MaxHealth, 0, 1)
            d.hpFill.Size = UDim2.new(hp, 0, 1, 0)
            if myRoot then
                local head = char:FindFirstChild("Head")
                if head then
                    local dist = (myRoot.Position - head.Position).Magnitude
                    d.distLbl.Text = string.format("[%d]", math.floor(dist))
                end
            end
            -- Ẩn cùng team
            if CONFIG.ESPHideSameTeam and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
                d.highlight.Enabled = false
                d.billboard.Enabled = false
            else
                d.billboard.Enabled = true
            end
        end
    end
end

function ESP:enable()
    if self.active then return end
    self.active = true
    for _, p in ipairs(Players:GetPlayers()) do makeESP(p) end
    self.thread = task.spawn(function()
        while self.active do
            local ok, err = pcall(updateESP)
            if not ok then warn("[ESP]", err) end
            task.wait(CONFIG.ESPUpdateInterval)
        end
        self.thread = nil
    end)
end

function ESP:disable()
    if not self.active then return end
    self.active = false
    clearAllESP()
end

track(Players.PlayerAdded:Connect(function(p)
    if ESP.active then task.wait(0.3); makeESP(p) end
end))
track(Players.PlayerRemoving:Connect(function(p)
    clearESPFor(p)
end))

