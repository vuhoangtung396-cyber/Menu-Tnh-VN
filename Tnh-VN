local function DE(o)
if o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Beam") or o:IsA("Smoke")
or o:IsA("Fire") or o:IsA("Sparkles") then
if Saved[o]==nil then Saved[o]={t="e",v=o.Enabled} end
