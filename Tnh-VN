-- NOCLIP MANAGER (đếm tham chiếu)
-- ============================================================
local NoclipManager = { active = false, original = {} }

function NoclipManager:_apply()
    local char = LocalPlayer.Character
    if not char then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") then
            if self.original[d] == nil then self.original[d] = d.CanCollide end
            d.CanCollide = false
        end
    end
end

function NoclipManager:_update()
    local want = next(State.noclipRequests) ~= nil
    if want and not self.active then
        self.active = true
        self.original = {}
        self:_apply()
    elseif not want and self.active then
        self.active = false
        for part, st in pairs(self.original) do
            if part and part.Parent then part.CanCollide = st end
        end
        self.original = {}
    end
end

function NoclipManager.request(source) State.noclipRequests[source] = true;  NoclipManager:_update() end
function NoclipManager.release(source) State.noclipRequests[source] = nil;   NoclipManager:_update() end

-- Reapply noclip khi respawn
track(LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.3)
    if NoclipManager.active then NoclipManager.original = {}; NoclipManager:_apply() end
end))

