local AutoRunning = false

local EggWords = {
    "egg",
    "trung",
    "steal",
    "take",
    "grab",
    "carry",
    "pickup",
    "pick up"
}

local BadWords = {
    "machine",
    "shop",
    "upgrade",
    "treadmill",
    "sell",
    "fuse",
    "display",
    "decor"
}

local function StringContains(text,words)

    if not text then
        return false
    end

    text = tostring(text):lower()

    for _,word in ipairs(words) do
        if text:find(word,1,true) then
            return true
        end
    end

    return false
end

--==================================================
-- GET OBJECT TEXT
--==================================================

local function GetPromptText(prompt)

    local t = ""

    pcall(function()
        t = t .. " " .. tostring(prompt.ActionText)
    end)

    pcall(function()
        t = t .. " " .. tostring(prompt.ObjectText)
    end)

    local p = prompt.Parent

    for i = 1,5 do

        if not p then
            break
        end

        t = t .. " " .. tostring(p.Name)

        p = p.Parent
    end

    return t:lower()
end

--==================================================
-- FIND EGG PROMPT
--==================================================

local function FindEggPrompt()

    local root = GetRoot()

    if not root then
        return nil
    end

    local nearest = nil
    local nearestDistance = math.huge

    for _,obj in ipairs(workspace:GetDescendants()) do

        if obj:IsA("ProximityPrompt") then

            local text = GetPromptText(obj)

            local hasEggWord = StringContains(text,EggWords)
            local bad = StringContains(text,BadWords)

            if hasEggWord and not bad then

                local part

                if obj.Parent:IsA("BasePart") then
                    part = obj.Parent
                else
                    part = obj.Parent:FindFirstChildWhichIsA(
                        "BasePart",
                        true
                    )
                end

                if part then

                    local distance =
                        (root.Position - part.Position).Magnitude

                    if distance < nearestDistance then

                        nearestDistance = distance
                        nearest = obj

                    end
                end
            end
        end
    end

    return nearest
end

--==================================================
-- PROMPT POSITION
--==================================================

local function GetPromptPart(prompt)

    if not prompt then
        return nil
    end

    if prompt.Parent:IsA("BasePart") then
        return prompt.Parent
    end

    return prompt.Parent:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end

--==================================================
-- FIRE PROMPT
--==================================================

local function FirePrompt(prompt)

    if not prompt then
        return false
    end

    local success = false

    pcall(function()

        if fireproximityprompt then

            fireproximityprompt(
                prompt,
                prompt.HoldDuration or 0
            )

            success = true
        end

    end)

    if not success then

        pcall(function()

            prompt:InputHoldBegin()

            task.wait(
                math.max(
                    prompt.HoldDuration,
                    0.05
                )
            )

            prompt:InputHoldEnd()

            success = true

        end)
    end

    return success
end

--==================================================
-- CHECK CARRYING EGG
--==================================================

local function IsCarryingEgg()

    local char = LP.Character

    if not char then
        return false
    end

    -- attributes
    local attrs = {
        "HasEgg",
        "CarryingEgg",
        "CarryEgg",
        "HoldingEgg",
        "IsCarrying",
        "Holding"
    }

    for _,a in ipairs(attrs) do

        local value = char:GetAttribute(a)

        if value == true then
            return true
        end
    end

    -- tool / model
    for _,obj in ipairs(char:GetChildren()) do

        if obj:IsA("Tool") or obj:IsA("Model") then

            local n = obj.Name:lower()

            if n:find("egg")
            or n:find("trung") then
                return true
            end
        end
    end

    -- backpack
    local backpack = LP:FindFirstChildOfClass("Backpack")

    if backpack then

        for _,obj in ipairs(backpack:GetChildren()) do

            if obj:IsA("Tool") then

                local n = obj.Name:lower()

                if n:find("egg")
                or n:find("trung") then
                    return true
                end
            end
        end
    end

    -- character descendant names
    for _,obj in ipairs(char:GetDescendants()) do

        local n = obj.Name:lower()

        if n == "carryingegg"
        or n == "heldegg"
        or n == "carriedegg" then
            return true
        end
    end

    return false
end

--==================================================
-- FIND PLAYER BASE
--==================================================

local function FindBase()

    local root = GetRoot()

    if not root then
        return nil
    end

    local possibleContainers = {
        "Bases",
        "Base",
        "Plots",
        "Plot",
        "Players",
        "Spawns",
        "SpawnLocations"
    }

    -- ưu tiên object có tên player
    for _,containerName in ipairs(possibleContainers) do

        local container = workspace:FindFirstChild(containerName)

        if container then

            for _,obj in ipairs(container:GetDescendants()) do

                local n = obj.Name:lower()

                if n:find(LP.Name:lower(),1,true)
                or n:find(LP.DisplayName:lower(),1,true) then

                    if obj:IsA("BasePart") then
                        return obj
                    end

                    local p = obj:FindFirstChildWhichIsA(
                        "BasePart",
                        true
                    )

                    if p then
                        return p
                    end
                end
            end
        end
    end

    -- tìm prompt base/deliver
    for _,obj in ipairs(workspace:GetDescendants()) do

        if obj:IsA("ProximityPrompt") then

            local text = GetPromptText(obj)

            if StringContains(
                text,
                {
                    "deliver",
                    "deposit",
                    "drop egg",
                    "place egg",
                    "your base",
                    "base"
                }
            ) then

                local part = GetPromptPart(obj)

                if part then
                    return part
                end
            end
        end
    end

    return nil
end

--==================================================
-- FIND BASE PROMPT
--==================================================

local function FindBasePrompt()

    local root = GetRoot()

    if not root then
        return nil
    end

    local nearest = nil
    local best = math.huge

    for _,obj in ipairs(workspace:GetDescendants()) do

        if obj:IsA("ProximityPrompt") then

            local text = GetPromptText(obj)

            if StringContains(
                text,
                {
                    "deliver",
                    "deposit",
                    "drop egg",
                    "place egg",
                    "base"
                }
            ) then

                local part = GetPromptPart(obj)

                if part then

                    local d =
                        (root.Position - part.Position).Magnitude

                    if d < best then
                        best = d
                        nearest = obj
                    end
                end
            end
        end
    end

    return nearest
end

--==================================================
-- MOVE BY SHORT STEPS
--==================================================

local function MoveToPosition(target)

    local root = GetRoot()

    if not root then
        return false
    end

    local start = root.Position
    local distance = (target - start).Magnitude

    if distance <= 5 then
        return true
    end

    local stepDistance =
        math.clamp(State.StealSpeed / 7,6,14)

    local steps =
        math.ceil(distance / stepDistance)

    for i = 1,steps do

        if not State.AutoSteal then
            return false
        end

        root = GetRoot()

        if not root then
            return false
        end

        local alpha = i / steps

        local pos = start:Lerp(target,alpha)

        root.CFrame = CFrame.new(pos)

        RunService.Heartbeat:Wait()
    end

    return true
end

--==================================================
-- AUTO STEAL LOOP
--==================================================

local function StartAutoSteal()

    if AutoRunning then
        return
    end

    AutoRunning = true

    task.spawn(function()

        while State.AutoSteal do

            local root = GetRoot()

            if not root then
                task.wait(1)
                continue
            end

            ------------------------------------------------
            -- PHASE 1: IF ALREADY CARRYING -> RETURN BASE
            ------------------------------------------------

            if IsCarryingEgg() then

                local basePrompt = FindBasePrompt()

                if basePrompt then

                    local part = GetPromptPart(basePrompt)

                    if part then

                        MoveToPosition(part.Position)

                        task.wait(0.15)

                        FirePrompt(basePrompt)

                        task.wait(0.5)

                    end

                else

                    local base = FindBase()

                    if base then

                        MoveToPosition(base.Position)

                        task.wait(0.5)

                        -- tìm prompt lần nữa
                        local p = FindBasePrompt()

                        if p then
                            FirePrompt(p)
                        end
                    end
                end

                task.wait(0.5)

            ------------------------------------------------
            -- PHASE 2: FIND EGG
            ------------------------------------------------

            else

                local eggPrompt = FindEggPrompt()

                if eggPrompt then

                    local part = GetPromptPart(eggPrompt)

                    if part then

                        MoveToPosition(part.Position)

                        task.wait(0.15)

                        FirePrompt(eggPrompt)

                        -- chờ game xác nhận pickup
                        local gotEgg = false

                        for i = 1,20 do

                            task.wait(0.1)

                            if IsCarryingEgg() then
                                gotEgg = true
                                break
                            end
                        end

                        if not gotEgg then
                            task.wait(0.4)
                        end
                    end

                else

                    -- không thấy egg
                    task.wait(0.5)

                end
            end
        end

        AutoRunning = false
    end)
end

