-- 1. AIMBOT SYSTEM (MƯỢT VÀ TỐI ƯU HƠN)
local function GetClosestTarget()
    local target, minD = nil, cfg.AimFOV
    local mPos = UIS:GetMouseLocation()
    for _, p in pairs(P:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChildOfClass("Humanoid") then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum.Health > 0 then
                local head = p.Character.Head
                local pos, vis = cam:WorldToViewportPoint(head.Position)
                if vis then
                    local mag = (Vector2.new(pos.X, pos.Y) - mPos).Magnitude
                    if mag < minD then
                        minD = mag
                        target = head
                    end
                end
            end
        end
    end
    return target
end

RS.RenderStepped:Connect(function()
    FOVC.Visible = cfg.Aimbot
    FOVC.Position = UDim2.new(0, UIS:GetMouseLocation().X, 0, UIS:GetMouseLocation().Y)
    
    if cfg.Aimbot then
        local target = GetClosestTarget()
        if target then
            local cur = cam.CFrame
            local goal = CFrame.new(cur.Position, target.Position)
            -- Sửa lerp từ 0.35 -> 0.15 để aimbot bám mượt không bị giật camera
            cam.CFrame = cur:Lerp(goal, cfg.AimSmooth or 0.15)
        end
    end
end)

-- 2. ESP SYSTEM
local ESD = {}
local function RemESP(p)
    if ESD[p] then
        for _, v in pairs(ESD[p]) do pcall(function() v:Destroy() end) end
        ESD[p] = nil
    end
end

local function UpdESP()
    for _, p in pairs(P:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChildOfClass("Humanoid") then
            local char = p.Character
            local hrp = char.HumanoidRootPart
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if hum.Health > 0 and cfg.ESP then
                if not ESD[p] then
                    ESD[p] = {
                        Box = cr("Frame", { Parent=S, BackgroundTransparency=1, BorderColor3=Color3.fromRGB(255,50,50), BorderSizePixel=1.5 }),
                        Tracer = cr("Frame", { Parent=S, BackgroundColor3=Color3.fromRGB(255,50,50), BorderSizePixel=0 }),
                        Name = cr("TextLabel", { Parent=S, BackgroundTransparency=1, TextColor3=Color3.fromRGB(255,255,255), TextSize=11, Font=Enum.Font.Gotham }),
                        Dist = cr("TextLabel", { Parent=S, BackgroundTransparency=1, TextColor3=Color3.fromRGB(200,200,200), TextSize=10, Font=Enum.Font.Gotham })
                    }
                end
                
                local pos, vis = cam:WorldToViewportPoint(hrp.Position)
                if vis then
                    local scale = 1000 / pos.Z
                    local w, h = 2.2 * scale, 3.5 * scale
                    
                    local box = ESD[p].Box
                    box.Visible = cfg.ESPBox
                    box.Size = UDim2.new(0, w, 0, h)
                    box.Position = UDim2.new(0, pos.X - w/2, 0, pos.Y - h/2)
                    
                    local tr = ESD[p].Tracer
                    tr.Visible = cfg.ESPTracer
                    local mPos = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y)
                    local tPos = Vector2.new(pos.X, pos.Y + h/2)
                    local dist = (tPos - mPos).Magnitude
                    local angle = math.atan2(tPos.Y - mPos.Y, tPos.X - mPos.X)
                    tr.Size = UDim2.new(0, dist, 0, 1)
                    tr.Position = UDim2.new(0, mPos.X, 0, mPos.Y)
                    tr.Rotation = math.deg(angle)
                    tr.AnchorPoint = Vector2.new(0, 0.5)
                    
                    local nm = ESD[p].Name
                    nm.Visible = cfg.ESPName
                    nm.Text = p.Name
                    nm.Position = UDim2.new(0, pos.X - 50, 0, pos.Y - h/2 - 14)
                    nm.Size = UDim2.new(0, 100, 0, 12)
                    
                    local dt = ESD[p].Dist
                    dt.Visible = cfg.ESPDist
                    local dVal = math.floor((hrp.Position - cam.CFrame.Position).Magnitude)
                    dt.Text = tostring(dVal).."m"
                    dt.Position = UDim2.new(0, pos.X - 50, 0, pos.Y + h/2 + 2)
                    dt.Size = UDim2.new(0, 100, 0, 12)
                else
                    for _, v in pairs(ESD[p]) do v.Visible = false end
                end
            else
                RemESP(p)
            end
        else
            RemESP(p)
        end
    end
end
P.PlayerRemoving:Connect(RemESP)
RS.RenderStepped:Connect(UpdESP)

-- 3. PROXIMITY PROMPT & AUTO FARM (TỐI ƯU KHÔNG BLOCK LUỒNG RENDER)
local function FirePrompt(prompt)
    if not prompt then return end
    task.spawn(function()
        pcall(function()
            if fireproximityprompt then
                fireproximityprompt(prompt, 0)
            else
                prompt:InputHoldBegin()
                task.wait(math.max(prompt.HoldDuration, 0.02) + 0.02)
                prompt:InputHoldEnd()
            end
        end)
    end)
end

local function ScanAndSteal(kw, maxDist)
    if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LP.Character.HumanoidRootPart
    
    for _, obj in pairs(WS:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local parent = obj.Parent
            if parent and parent:IsA("BasePart") then
                local nameMatch = parent.Name:lower():find(kw) or obj.ActionText:lower():find(kw) or obj.ObjectText:lower():find(kw)
                if nameMatch or kw == "all" then
                    local dist = (parent.Position - hrp.Position).Magnitude
                    if dist <= maxDist then
                        FirePrompt(obj)
                    end
                end
            end
        end
    end
end

RS.Heartbeat:Connect(function()
    if cfg.AutoSteal then ScanAndSteal("steal", cfg.StealDist) end
    if cfg.AutoEgg then ScanAndSteal("egg", cfg.EggDist) end
end)

-- 4. ADVANCED HUMANOIDROOTPART FLY SYSTEM (BAY MƯỢT BẰNG LINEARVELOCITY & HRPRT)
local flyLV, flyAO = nil, nil

local function ToggleFly(enable)
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if enable then
        -- Dọn dẹp cơ chế cũ
        if flyLV then flyLV:Destroy() end
        if flyAO then flyAO:Destroy() end

        -- Khởi tạo LinearVelocity (Phương pháp fly mượt nhất của Roblox)
        local att = hrp:FindFirstChild("FlyAttachment") or Instance.new("Attachment", hrp)
        att.Name = "FlyAttachment"

        flyLV = Instance.new("LinearVelocity")
        flyLV.Name = "FlyVelocity"
        flyLV.Attachment0 = att
        flyLV.MaxForce = math.huge
        flyLV.VectorVelocity = Vector3.zero
        flyLV.RelativeTo = Enum.ActuatorRelativeTo.World
        flyLV.Parent = hrp

        flyAO = Instance.new("AlignOrientation")
        flyAO.Name = "FlyOrientation"
        flyAO.Attachment0 = att
        flyAO.MaxTorque = math.huge
        flyAO.Responsiveness = 200
        flyAO.Mode = Enum.OrientationAlignmentMode.OneAttachment
        flyAO.Parent = hrp

        hum.PlatformStand = true
    else
        if flyLV then flyLV:Destroy(); flyLV = nil end
        if flyAO then flyAO:Destroy(); flyAO = nil end
        if hrp:FindFirstChild("FlyAttachment") then hrp.FlyAttachment:Destroy() end
        hum.PlatformStand = false
    end
end

-- Xử lý chuyển động bay liên tục theo Camera
RS.RenderStepped:Connect(function()
    if cfg.Fly and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LP.Character.HumanoidRootPart
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        
        if not flyLV or flyLV.Parent ~= hrp then
            ToggleFly(true)
        end

        hum.PlatformStand = true
        
        -- Tính toán hướng di chuyển từ bàn phím/phím điều khiển
        local moveDir = hum.MoveDirection
        local flyVec = Vector3.zero
        
        if moveDir.Magnitude > 0 then
            -- Bay theo góc nhìn của Camera
            local camCF = cam.CFrame
            local rawVec = (camCF:VectorToWorldSpace(camCF:ToObjectSpace(CFrame.new(Vector3.zero, moveDir)).LookVector))
            flyVec = rawVec * cfg.FlySpeed
        else
            flyVec = Vector3.zero
        end

        -- Phím Q/E hoặc nút nhảy để điều chỉnh độ cao nếu không di chuyển
        if UIS:IsKeyDown(Enum.KeyCode.Space) then
            flyVec = flyVec + Vector3.new(0, cfg.FlySpeed, 0)
        elseif UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
            flyVec = flyVec + Vector3.new(0, -cfg.FlySpeed, 0)
        end

        flyLV.VectorVelocity = flyVec
        flyAO.CFrame = cam.CFrame
    else
        if flyLV then ToggleFly(false) end
    end
end)

-- Reset Fly khi Spawn lại
LP.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if cfg.Fly then ToggleFly(true) end
end)

