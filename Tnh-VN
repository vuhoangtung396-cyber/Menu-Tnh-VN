    local function IsEggName(name)

        name = string.lower(name or "")

        return
            name:find("egg") ~= nil
            or name:find("trung") ~= nil
            or name:find("carryareaegg") ~= nil
    end

    local function IsStealPrompt(prompt)

        local all =
            string.lower(
                (prompt.Name or "") .. " "
                .. (prompt.ActionText or "") .. " "
                .. (prompt.ObjectText or "")
            )

        return
            all:find("egg") ~= nil
            or all:find("steal") ~= nil
            or all:find("grab") ~= nil
            or all:find("carry") ~= nil
            or all:find("take") ~= nil
            or all:find("trung") ~= nil
    end

    local function GetPromptPart(prompt)

        if not prompt then
            return nil
        end

        if prompt.Parent:IsA("BasePart") then
            return prompt.Parent
        end

        local model =
            prompt:FindFirstAncestorOfClass("Model")

        if model then

            if model.PrimaryPart then
                return model.PrimaryPart
            end

            return model:FindFirstChildWhichIsA(
                "BasePart",
                true
            )
        end

        return nil
    end

    local function FindEggPrompt()

        local root =
            LP.Character
            and LP.Character:FindFirstChild(
                "HumanoidRootPart"
            )

        if not root then return nil end

        local nearest
        local distance = math.huge

        for _,obj in ipairs(
            Workspace:GetDescendants()
        ) do

            if obj:IsA("ProximityPrompt")
            and obj.Enabled
            and IsStealPrompt(obj) then

                local part =
                    GetPromptPart(obj)

                if part then

                    local d =
                        (root.Position -
                        part.Position).Magnitude

                    if d < distance then
                        distance = d
                        nearest = obj
                    end
                end
            end
        end

        return nearest
    end

    local function FirePrompt(prompt)

        if not prompt then
            return false
        end

        pcall(function()
            prompt.HoldDuration = 0
        end)

        if typeof(fireproximityprompt)
            == "function" then

            local ok =
                pcall(function()
                    fireproximityprompt(prompt)
                end)

            if ok then
                return true
            end
        end

        return false
    end

    -- tìm vị trí base
    local function FindBasePosition()

        local root =
            LP.Character
            and LP.Character:FindFirstChild(
                "HumanoidRootPart"
            )

        if not root then return nil end

        local candidates = {}

        -- tên thông dụng
        local names = {
            "Base",
            "MyBase",
            "PlayerBase",
            "Home",
            "Plot",
            "Nest",
            "SafeZone",
            "Safe"
        }

        for _,name in ipairs(names) do

            for _,obj in ipairs(
                Workspace:GetDescendants()
            ) do

                if string.lower(obj.Name)
                    == string.lower(name) then

                    table.insert(
                        candidates,obj
                    )
                end
            end
        end

        -- thử tìm object có tên người chơi
        for _,obj in ipairs(
            Workspace:GetDescendants()
        ) do

            local n =
                string.lower(obj.Name)

            local username =
                string.lower(LP.Name)

            local display =
                string.lower(LP.DisplayName)

            if n == username
            or n == display
            or n:find(username) then

                if obj:IsA("Model")
                or obj:IsA("BasePart") then

                    table.insert(
                        candidates,obj
                    )
                end
            end
        end

        -- chọn object gần spawn hiện tại
        local best
        local bestDist = math.huge

        for _,obj in ipairs(candidates) do

            local part

            if obj:IsA("BasePart") then
                part = obj

            elseif obj:IsA("Model") then

                part =
                    obj.PrimaryPart
                    or obj:FindFirstChildWhichIsA(
                        "BasePart",
                        true
                    )
            end

            if part then

                local d =
                    (root.Position -
                    part.Position).Magnitude

                if d < bestDist then
                    bestDist = d
                    best = part
                end
            end
        end

        if best then
            return best.Position
        end

        return nil
    end

    local function TeleportTo(position)

        local char = LP.Character
        if not char then return end

        local root =
            char:FindFirstChild(
                "HumanoidRootPart"
            )

        if root then

            pcall(function()
                root.CFrame =
                    CFrame.new(
                        position +
                        Vector3.new(0,3,0)
                    )
            end)

        end
    end

    local function AutoStealLoop()

        if StealThread then
            return
        end

        StealThread = true

        task.spawn(function()

            while AutoSteal do

                local char =
                    LP.Character

                local root =
                    char and
                    char:FindFirstChild(
                        "HumanoidRootPart"
                    )

                if root then

                    -- tìm trứng
                    local prompt =
                        FindEggPrompt()

                    if prompt then

                        local part =
                            GetPromptPart(prompt)

                        if part then

                            -- tới trứng
                            TeleportTo(
                                part.Position
                            )

                            task.wait(.12)

                            -- nhặt
                            FirePrompt(prompt)

                            task.wait(.35)

                            -- tìm base
                            local basePos =
                                FindBasePosition()

                            if basePos then

                                -- mang về
                                TeleportTo(
                                    basePos
                                )

                                task.wait(.45)
                            end

                        end
                    end
                end

                task.wait(.12)
            end

            StealThread = nil
        end)
    end

