-- FLY (fix: BodyVelocity + BodyGyro + mobile support)
--==================================================
local FlyVel,FlyGyro,FlyConn
local function StopFly()
    if FlyConn then FlyConn:Disconnect(); FlyConn=nil end
    if FlyVel then FlyVel:Destroy(); FlyVel=nil end
    if FlyGyro then FlyGyro:Destroy(); FlyGyro=nil end
    GetChar()
    if Humanoid then
        Humanoid.PlatformStand=false
        pcall(function() Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
end

local function StartFly()
    StopFly()
    GetChar()
    if not Root or not Humanoid then
        task.wait(0.3)
        GetChar()
        if not Root or not Humanoid then return end
    end
    
    FlyVel=Instance.new("BodyVelocity")
    FlyVel.Name="TNH_VN_Fly"
    FlyVel.MaxForce=Vector3.new(1e9,1e9,1e9)
    FlyVel.P=25000
    FlyVel.Velocity=Vector3.zero
    FlyVel.Parent=Root
    
    FlyGyro=Instance.new("BodyGyro")
    FlyGyro.Name="TNH_VN_Gyro"
    FlyGyro.MaxTorque=Vector3.new(1e9,1e9,1e9)
    FlyGyro.P=30000
    FlyGyro.D=1000
    FlyGyro.CFrame=Root.CFrame
    FlyGyro.Parent=Root
    
    Humanoid.PlatformStand=true
    
    FlyConn=RunService.RenderStepped:Connect(function()
        if not State.Fly or State.Destroyed then StopFly(); return end
        if not Root or not Root.Parent then return end
        if not Humanoid or not Humanoid.Parent then return end
        
        Humanoid.PlatformStand=true
        
        local cam=WS.CurrentCamera
        if not cam then return end
        
        local dir=Vector3.zero
        
        -- PC keyboard
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir+=cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir-=cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir-=cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir+=cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir+=Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir-=Vector3.new(0,1,0) end
        
        -- Mobile: nếu không có phím thì dùng MoveDirection (joystick)
        if dir.Magnitude<0.1 then
            local md=Humanoid.MoveDirection
            if md.Magnitude>0.1 then
                dir=md
                -- Mobile: nút Space ảo không có → dùng joystick lên/xuống là đủ
            end
        end
        
        if dir.Magnitude>0 then
            FlyVel.Velocity=dir.Unit*State.FlyValue
        else
            FlyVel.Velocity=Vector3.zero
        end
        
        FlyGyro.CFrame=CFrame.lookAt(Root.Position,Root.Position+cam.CFrame.LookVector)
    end)
end

