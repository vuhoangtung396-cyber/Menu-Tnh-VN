local CBase=nil
local function FB()
  if CBase then return CBase end
  for _,o in ipairs(WS:GetDescendants()) do if o:IsA("SpawnLocation") then CBase=o.Position;return CBase end end
  local ln=LP.Name:lower()
  for _,o in ipairs(WS:GetChildren()) do
    if o:IsA("Model") or o:IsA("Folder") then
      if o.Name:lower():find(ln,1,true) then
        local p=o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart")
        if p then CBase=p.Position;return CBase end
      end
    end
  end
  for _,fn in ipairs({"Bases","Pens","Base","Spawns","Plots"}) do
    local f=WS:FindFirstChild(fn)
    if f then
      for _,o in ipairs(f:GetChildren()) do
        if o.Name:lower():find(ln,1,true) then
          local p=o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart")
          if p then CBase=p.Position;return CBase end
        end
      end
    end
  end
  return Vector3.new(0,50,0)
end
local function ICE()
  for _,a in ipairs({"HasEgg","CarryingEgg","HasPet","CarryEgg","Holding","IsCarrying","EggName","Carrying"}) do
    local ok,v=pcall(function() return LP:GetAttribute(a) end)
    if ok and v~=nil and v~=false and v~="" then return true end
  end
  local c=LP.Character
  if c then
    for _,o in ipairs(c:GetChildren()) do
      local n=o.Name:lower()
      if (n=="egg" or n:match("^egg[%s%d]") or n:match("carry") or n:match("hold"))
      and not o:IsA("Humanoid") and not o:IsA("Accessory") and not o:IsA("Tool") and not o:IsA("Folder") then
        return true
      end
    end
  end
  local bp=LP:FindFirstChildOfClass("Backpack")
  if bp then
    for _,o in ipairs(bp:GetChildren()) do
      local n=o.Name:lower()
      if n=="egg" or n:match("^egg[%s%d]") then return true end
    end
  end
  return false
end
local function EMP(e)
  if not next(S.PriorityEggs) then return true end
  local c={}
  if e.real then table.insert(c,e.real:lower()) end
  if e.name then table.insert(c,e.name:lower()) end
  if e.info and e.info.pet then table.insert(c,e.info.pet:lower()) end
  for k,_ in pairs(S.PriorityEggs) do
    local p=k:lower();local pn=p:gsub("%s*egg%s*$","")
    for _,cc in ipairs(c) do
      local cn=cc:gsub("%s*egg%s*$","")
      if cc==p or cc==pn or cn==p or cn==pn then return true end
    end
  end
  return false
end

-- AUTO STEAL
local ASC,LPA=0,CIF=nil,LSc=0,CEg={},SCT=0.8
local function GCE(rad)
  if tick()-LSc>SCT or #CEg==0 then CEg=Scan(rad);LSc=tick() end
  return CEg
end
local function FNE()
  local c=LP.Character
  local r=c and c:FindFirstChild("HumanoidRootPart")
  if not r then return nil end
  local all=GCE(500)
  if #all==0 then all=Scan();CEg=all;LSc=tick() end
  if #all==0 then return nil end
  local best,bs=nil,-math.huge
  for _,e in ipairs(all) do
    if e.part and e.part.Parent and EMP(e) then
      local d=(e.part.Position-r.Position).Magnitude
      local inf=e.info or {}
      local sc=-d
      if S.PrioritySecret then
        local rr=(inf.rarity or ""):lower()
        if rr=="secret" or rr=="mythic" or rr=="cosmic" or rr=="divine" or rr=="eternal" then sc=sc+1e9 end
      end
      sc=sc+PI(inf.income)*100
      if sc>bs then bs=sc;best=e end
    end
  end
  return best
end
local function ECI()
  local c=LP.Character
  if not c then return end
  local h=c:FindFirstChildOfClass("Humanoid")
  if h then for _,st in ipairs(NST) do pcall(function() h:SetStateEnabled(st,false) end) end end
  if not CIF or CIF.Parent~=c then
    if CIF then CIF:Destroy() end
    CIF=Instance.new("ForceField");CIF.Name="TnhVN_CI";CIF.Visible=false;CIF.Parent=c
  end
end
local function DCI()
  if CIF then CIF:Destroy();CIF=nil end
  local c=LP.Character
  local h=c and c:FindFirstChildOfClass("Humanoid")
  if h and not S.AntiHit then for _,st in ipairs(NST) do pcall(function() h:SetStateEnabled(st,true) end) end end
end
local function SAS()
  S.AutoSteal=true
  StatL.Text=T("stat")..": "..T("on");StatL.TextColor3=Color3.fromRGB(0,220,100)
  FB()
  if ASC then ASC:Disconnect() end
  ASC=RS.Heartbeat:Connect(function()
    if not S.AutoSteal then return end
    local c=LP.Character
    local r=c and c:FindFirstChild("HumanoidRootPart")
    local h=c and c:FindFirstChildOfClass("Humanoid")
    if not r or not h then return end
    if ICE() then
      ECI()
      if h.Health<h.MaxHealth then h.Health=h.MaxHealth end
      local base=FB()
      local d=(base-r.Position).Magnitude
      StatL.Text=T("stat")..": Về Base ("..math.floor(d).."m)"
      StatL.TextColor3=Color3.fromRGB(255,200,80)
      if d>8 then
        local dir=base-r.Position
        local step=math.min(dir.Magnitude-4,80)
        pcall(function() r.CFrame=CFrame.new(r.Position+dir.Unit*step+Vector3.new(0,2.5,0)) end)
        r.AssemblyLinearVelocity=Vector3.zero
      end
      return
    else DCI() end
    local t=FNE()
    if not t then StatL.Text=T("stat")..": Không có match";StatL.TextColor3=Color3.fromRGB(255,100,100);return end
    local pos=t.part.Position
    local d=(pos-r.Position).Magnitude
    local inf=t.info or {}
    StatL.Text=T("stat")..": → "..(t.real or t.name).." ("..(inf.income or "?")..") "..math.floor(d).."m"
    StatL.TextColor3=Color3.fromRGB(0,200,255)
    if d<=20 then
      if tick()-LPA>0.15 then
        LPA=tick()
        local ok=TP(t.part)
        if not ok and firetouchinterest then
          local cc=LP.Character
          if cc then
            for _,pName in ipairs({"HumanoidRootPart","Head","UpperTorso","Torso","LeftHand","RightHand"}) do
              local bp=cc:FindFirstChild(pName)
              if bp then
                pcall(function() firetouchinterest(bp,t.part,0);task.wait(0.03);firetouchinterest(bp,t.part,1) end)
              end
            end
          end
        end
      end
    else
      local dir=pos-r.Position
      local step=math.min(dir.Magnitude-5,50)
      pcall(function() r.CFrame=CFrame.new(r.Position+dir.Unit*step+Vector3.new(0,2.5,0)) end)
      r.AssemblyLinearVelocity=Vector3.zero
    end
  end)
end
local function SASstop()
  S.AutoSteal=false
  if ASC then ASC:Disconnect();ASC=nil end
  DCI();CEg={}
  StatL.Text=T("stat")..": "..T("off");StatL.TextColor3=Color3.fromRGB(150,160,165)
end
