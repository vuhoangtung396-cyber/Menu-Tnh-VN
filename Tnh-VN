local esp = {
	enabled = false,
	generation = 0,
	entries = {},
	playerMaids = {},
	maid = nil,
	elapsed = 0,
	hideSameTeam = CONFIG.Esp.HideSameTeam,
}

local function isSameTeam(player)
	return localPlayer.Team ~= nil and player.Team == localPlayer.Team
end

local function shouldShowEsp(player)
	return not (esp.hideSameTeam and isSameTeam(player))
end

local function createEspBillboard(head)
	local billboard = create("BillboardGui", {
		Name = "EspBillboard",
		Adornee = head,
		AlwaysOnTop = true,
		ResetOnSpawn = false,
		Size = UDim2.fromOffset(120, 42),
