local function OpenPage(name)
    for n,page in pairs(Pages) do
        page.Visible = n == name
    end

    for n,b in pairs(Buttons) do
        b.BackgroundColor3 =
            n == name
            and Color3.fromRGB(0,150,215)
            or Color3.fromRGB(29,36,40)
    end
end

