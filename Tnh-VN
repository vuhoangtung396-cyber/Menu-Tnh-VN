local NST={Enum.HumanoidStateType.Ragdoll,Enum.HumanoidStateType.FallingDown,Enum.HumanoidStateType.Physics,Enum.HumanoidStateType.PlatformStanding}
local AHC,AHF,AHL
local function ApplyAH()
  local c=LP.Character
  local h=c and c:FindFirstChildOfClass("Humanoid")
  if not c or not h then return end
  for _,st in ipairs(NST) do pcall(function() h:SetStateEnabled(st,false) end) end
