                o.BorderSizePixel = 0; o.ZIndex = 7; o.Parent = scroll
                Instance.new("UICorner", o).CornerRadius = UDim.new(0, 4)
                o.MouseButton1Click:Connect(function()
                    if multi then
                        selected[name] = not selected[name] or nil
                    else
                        selected = { [name] = true }; popup.Visible = false
                    end
                    render(); updateLabel()
                    if onSelect then onSelect(selected) end
                end)
            end
        end
    end

    search:GetPropertyChangedSignal("Text"):Connect(render)
    btn.MouseButton1Click:Connect(function()
        popup.Visible = not popup.Visible
        if popup.Visible then render() end
    end)

    return {
        SetItems = function(l) items = l; render() end,
        GetSelected = function() return selected end,
        GetSelectedList = function()
            local t = {}
            for k in pairs(selected) do table.insert(t, k) end
            return t
        end,
    }
end

