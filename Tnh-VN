local function corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 12)
    c.Parent = obj
end

local function stroke(obj, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(0,130,255)
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.Parent = obj
end

local function makeButton(parent, text, size)
    local b = Instance.new("TextButton")
    b.Parent = parent
    b.Size = size or UDim2.new(0,120,0,42)
    b.BackgroundColor3 = Color3.fromRGB(8,27,55)
    b.TextColor3 = Color3.fromRGB(190,220,255)
    b.Text = text
    b.TextSize = 14
    b.Font = Enum.Font.GothamSemibold
    b.AutoButtonColor = true
    corner(b, 11)
    stroke(b, Color3.fromRGB(20,125,255), 1, .25)
    return b
end

