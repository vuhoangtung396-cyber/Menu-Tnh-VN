-- HIGH JUMP
-- =====================================================================
local jumpState = {
	values = { JumpPower = CONFIG.JumpPower.Default, JumpHeight = CONFIG.JumpHeight.Default },
	property = nil,
	original = nil,
}

local function getJumpProperty(humanoid)
	if humanoid and not humanoid.UseJumpPower then
		return "JumpHeight"
	end
	return "JumpPower"
end

local function captureJumpOriginal(humanoid)
	jumpState.property = getJumpProperty(humanoid)
	jumpState.original = humanoid[jumpState.property]
end

local function applyJump(humanoid)
	humanoid[jumpState.property] = jumpState.values[jumpState.property]
end

local function enableHighJump()
	local humanoid = getHumanoid()
	if not humanoid then
		return false, "Character is not ready"
	end
	captureJumpOriginal(humanoid)
	applyJump(humanoid)
	return true
end

local function disableHighJump()
	local humanoid = getHumanoid()
	if humanoid and jumpState.property and jumpState.original then
		humanoid[jumpState.property] = jumpState.original
	end
	jumpState.property = nil
	jumpState.original = nil
end

local function refreshJumpRange()
	if not ui.jumpSlider then
		return
	end
	local property = getJumpProperty(getHumanoid())
	local range = CONFIG[property]
	local label = property == "JumpHeight" and "Jump Height" or "Jump Power"
	ui.jumpSlider.setLabel(label)
	ui.jumpSlider.setRange(range.Min, range.Max, jumpState.values[property])
end

local function onJumpSliderChanged(value)
	local humanoid = getHumanoid()
	local property = getJumpProperty(humanoid)
	jumpState.values[property] = value
	if state.enabled.HighJump and humanoid and jumpState.property == property then
		applyJump(humanoid)
	end
end

-- =====================================================================
-- FIX LAG
-- =====================================================================
local SWITCH_OFF_CLASSES = toSet({
	"ParticleEmitter", "Trail", "Beam", "Smoke", "Fire", "Sparkles",
	"PointLight", "SpotLight", "SurfaceLight",
})
local LIGHTING_EFFECT_CLASSES = toSet({
	"BloomEffect", "BlurEffect", "SunRaysEffect", "ColorCorrectionEffect", "DepthOfFieldEffect",
})

local lag = {
	records = setmetatable({}, { __mode = "k" }),
	protectedCache = setmetatable({}, { __mode = "k" }),
	protectedTags = {},
	simplifiedMaterials = {},
	connections = {},
	generation = 0,
}

local function setTracked(instance, property, value)
	local record = lag.records[instance]
	if not record then
		record = {}
		lag.records[instance] = record
	end
	if record[property] == nil then
		record[property] = instance[property]
	end
	instance[property] = value
end

local function isProtectedNode(node)
	if node:IsA("Terrain") then
		return true
	end
	if node:IsA("Model") and node:FindFirstChildOfClass("Humanoid") then
		return true
	end
	local lowerName = node.Name:lower()
	for _, fragment in ipairs(CONFIG.FixLag.ProtectedNameFragments) do
		if lowerName:find(fragment, 1, true) then
			return true
		end
	end
	for _, tag in ipairs(CollectionService:GetTags(node)) do
		if lag.protectedTags[tag] then
			return true
		end
	end
	return false
end

local function isProtected(instance)
	if instance == nil or instance == game or instance == Workspace or instance == Lighting then
		return false
	end
	local cached = lag.protectedCache[instance]
	if cached ~= nil then
		return cached
	end
	local result = isProtectedNode(instance) or isProtected(instance.Parent)
	lag.protectedCache[instance] = result
	return result
end

local function simplifyPart(part)
	if part.Transparency >= 0.95 or isProtected(part) then
		return
	end
	setTracked(part, "CastShadow", false)
	if lag.simplifiedMaterials[part.Material] then
		setTracked(part, "Material", Enum.Material.SmoothPlastic)
	end
	if part:IsA("MeshPart") then
		setTracked(part, "RenderFidelity", Enum.RenderFidelity.Performance)
	end
end

local function processInstance(instance)
	local className = instance.ClassName
	if LIGHTING_EFFECT_CLASSES[className] then
		setTracked(instance, "Enabled", false)
	elseif className == "Atmosphere" then
		setTracked(instance, "Density", 0)
		setTracked(instance, "Haze", 0)
	elseif SWITCH_OFF_CLASSES[className] then
		if not isProtected(instance) then
			setTracked(instance, "Enabled", false)
		end
	elseif className == "Decal" or className == "Texture" then
		if not isProtected(instance) then
			setTracked(instance, "Transparency", 1)
		end
	elseif instance:IsA("BasePart") then
		simplifyPart(instance)
	end
end

local function processInstanceSafely(instance)
	local ok, err = pcall(processInstance, instance)
	if not ok then
		warnError("Fix Lag (" .. instance:GetFullName() .. ")", err)
	end
end

local function scanWorkspaceInBatches(generation)
	local descendants = Workspace:GetDescendants()
	for index, instance in ipairs(descendants) do
		if lag.generation ~= generation then
			return
		end
		processInstanceSafely(instance)
		if index % CONFIG.FixLag.BatchSize == 0 then
			task.wait()
		end
	end
end

local function buildProtectedTagSet()
	local tags = { CONFIG.EnemyTag }
	for _, tag in ipairs(CONFIG.LootTags) do
		tags[#tags + 1] = tag
	end
	return toSet(tags)
end

local function enableFixLag()
	lag.generation += 1
	lag.protectedTags = buildProtectedTagSet()
	lag.simplifiedMaterials = toSet(CONFIG.FixLag.SimplifiedMaterials)
	setLightingOverride("FixLag", { GlobalShadows = false, FogStart = 100000, FogEnd = 100001 })
	lag.connections = {
		Workspace.DescendantAdded:Connect(processInstanceSafely),
		Lighting.DescendantAdded:Connect(processInstanceSafely),
	}
	for _, instance in ipairs(Lighting:GetDescendants()) do
		processInstanceSafely(instance)
	end
	task.spawn(scanWorkspaceInBatches, lag.generation)
	return true
end

local function restoreFixLagRecords()
	for instance, record in pairs(lag.records) do
		if instance.Parent then
			for property, original in pairs(record) do
				local ok, err = pcall(function()
					instance[property] = original
				end)
				if not ok then
					warnError("Fix Lag restore " .. instance:GetFullName(), err)
				end
			end
		end
	end
	lag.records = setmetatable({}, { __mode = "k" })
	lag.protectedCache = setmetatable({}, { __mode = "k" })
end

local function disableFixLag()
	lag.generation += 1
	for _, connection in ipairs(lag.connections) do
		connection:Disconnect()
	end
	lag.connections = {}
	clearLightingOverride("FixLag")
	restoreFixLagRecords()
end

