--// Tnh-VN Auto Steal - SERVER
--// Dùng cho game Roblox của bạn

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local PathfindingService = game:GetService("PathfindingService")

--==================================================
-- REMOTE
--==================================================

local folder = ReplicatedStorage:FindFirstChild("TnhVN_AutoSteal")

if not folder then
	folder = Instance.new("Folder")
	folder.Name = "TnhVN_AutoSteal"
	folder.Parent = ReplicatedStorage
end

local Remote = folder:FindFirstChild("Remote")

if not Remote then
	Remote = Instance.new("RemoteEvent")
	Remote.Name = "Remote"
	Remote.Parent = folder
end

--==================================================
-- DATA
--==================================================

local PlayerData = {}

local DEFAULT_SPEED = 100
local MAX_SPEED = 500

local PICKUP_DISTANCE = 14
local DROP_DISTANCE = 18

--==================================================
-- UTILS
--==================================================

local function getCharacter(player)
	local char = player.Character

	if not char then
		return nil
	end

	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return nil
	end

	return char, humanoid, root
end

local function getEggRoot(egg)
	if not egg then
		return nil
	end

	if egg:IsA("BasePart") then
		return egg
	end

	if egg:IsA("Model") then
		if egg.PrimaryPart then
			return egg.PrimaryPart
		end

		return egg:FindFirstChildWhichIsA("BasePart", true)
	end

	return nil
end

local function getEggName(egg)
	return egg:GetAttribute("EggName")
		or egg:GetAttribute("Name")
		or egg.Name
end

local function isEggAvailable(egg)
	if not egg or not egg.Parent then
		return false
	end

	if egg:GetAttribute("Taken") == true then
		return false
	end

	if egg:GetAttribute("Stolen") == true then
		return false
	end

	return true
end

local function getEggs()
	local result = {}

	for _, egg in ipairs(CollectionService:GetTagged("StealableEgg")) do
		if isEggAvailable(egg) then
			table.insert(result, egg)
		end
	end

	return result
end

--==================================================
-- PLAYER BASE
--==================================================

local function getPlayerBase(player)
	for _, base in ipairs(CollectionService:GetTagged("PlayerBase")) do

		local ownerId = base:GetAttribute("OwnerUserId")

		if ownerId == player.UserId then
			return base
		end

		local ownerName = base:GetAttribute("Owner")

		if ownerName == player.Name then
			return base
		end
	end

	return nil
end

local function getBaseRoot(base)
	if not base then
		return nil
	end

	if base:IsA("BasePart") then
		return base
	end

	if base:IsA("Model") then
		if base.PrimaryPart then
			return base.PrimaryPart
		end

		return base:FindFirstChild("DropPoint", true)
			or base:FindFirstChildWhichIsA("BasePart", true)
	end

	return nil
end

--==================================================
-- TARGET
--==================================================

local function targetAllowed(data, egg)
	local name = getEggName(egg)

	-- Nếu TargetList rỗng => cho phép tất cả
	if next(data.Targets) == nil then
		return true
	end

	return data.Targets[name] == true
end

local function chooseEgg(player)
	local data = PlayerData[player]

	if not data then
		return nil
	end

	local char, humanoid, root = getCharacter(player)

	if not root then
		return nil
	end

	local candidates = {}

	for _, egg in ipairs(getEggs()) do

		if targetAllowed(data, egg) then

			local eggRoot = getEggRoot(egg)

			if eggRoot then
				local priority = egg:GetAttribute("Priority") or 999999
				local value = egg:GetAttribute("StealValue") or 0
				local distance = (root.Position - eggRoot.Position).Magnitude

				table.insert(candidates, {
					Object = egg,
					Priority = priority,
					Value = value,
					Distance = distance
				})
			end
		end
	end

	table.sort(candidates, function(a, b)

		if a.Priority ~= b.Priority then
			return a.Priority < b.Priority
		end

		if a.Value ~= b.Value then
			return a.Value > b.Value
		end

		return a.Distance < b.Distance
	end)

	if candidates[1] then
		return candidates[1].Object
	end

	return nil
end

--==================================================
-- MOVEMENT
--==================================================

local function moveTo(player, position, speed)
	local char, humanoid, root = getCharacter(player)

	if not humanoid or not root then
		return false
	end

	speed = math.clamp(speed or DEFAULT_SPEED, 1, MAX_SPEED)

	local oldSpeed = humanoid.WalkSpeed
	humanoid.WalkSpeed = speed

	local reached = false

	local connection
	connection = humanoid.MoveToFinished:Connect(function(success)
		reached = success
	end)

	local path

	local success = pcall(function()

		path = PathfindingService:CreatePath({
			AgentRadius = 2,
			AgentHeight = 5,
			AgentCanJump = true,
			AgentCanClimb = true
		})

		path:ComputeAsync(root.Position, position)
	end)

	if success and path and path.Status == Enum.PathStatus.Success then

		for _, waypoint in ipairs(path:GetWaypoints()) do

			if not PlayerData[player] or not PlayerData[player].Enabled then
				connection:Disconnect()
				humanoid.WalkSpeed = oldSpeed
				return false
			end

			if waypoint.Action == Enum.PathWaypointAction.Jump then
				humanoid.Jump = true
			end

			humanoid:MoveTo(waypoint.Position)

			local start = os.clock()

			while os.clock() - start < 8 do

				if not root.Parent then
					break
				end

				if (root.Position - waypoint.Position).Magnitude <= 5 then
					break
				end

				if not PlayerData[player] or not PlayerData[player].Enabled then
					connection:Disconnect()
					humanoid.WalkSpeed = oldSpeed
					return false
				end

				task.wait()
			end
		end

	else
		humanoid:MoveTo(position)

		local start = os.clock()

		while os.clock() - start < 10 do

			if (root.Position - position).Magnitude <= 7 then
				break
			end

			if not PlayerData[player] or not PlayerData[player].Enabled then
				break
			end

			task.wait()
		end
	end

	connection:Disconnect()
	humanoid.WalkSpeed = oldSpeed

	return true
end

--==================================================
-- PICK UP
--==================================================

local function pickupEgg(player, egg)
	local data = PlayerData[player]

	if not data then
		return false
	end

	if not isEggAvailable(egg) then
		return false
	end

	local char, humanoid, root = getCharacter(player)
	local eggRoot = getEggRoot(egg)

	if not root or not eggRoot then
		return false
	end

	if (root.Position - eggRoot.Position).Magnitude > PICKUP_DISTANCE then
		return false
	end

	egg:SetAttribute("Taken", true)
	egg:SetAttribute("Stolen", true)

	data.Carrying = egg

	-- Thông báo client
	Remote:FireClient(player, "Carrying", true, getEggName(egg))

	-- Tạo Weld để egg đi theo player
	local oldParent = egg.Parent

	if egg:IsA("Model") then
		egg.Parent = char
	elseif egg:IsA("BasePart") then
		egg.Parent = char
	end

	eggRoot = getEggRoot(egg)

	if eggRoot then

		eggRoot.CanCollide = false
		eggRoot.Massless = true

		eggRoot.CFrame =
			root.CFrame
			* CFrame.new(0, 2.5, -2)

		local weld = Instance.new("WeldConstraint")
		weld.Name = "TnhVN_CarryWeld"
		weld.Part0 = root
		weld.Part1 = eggRoot
		weld.Parent = eggRoot
	end

	return true
end

--==================================================
-- DROP
--==================================================

local function dropEgg(player)
	local data = PlayerData[player]

	if not data or not data.Carrying then
		return false
	end

	local egg = data.Carrying
	local char, humanoid, root = getCharacter(player)

	if not root then
		return false
	end

	local base = getPlayerBase(player)
	local baseRoot = getBaseRoot(base)

	if not baseRoot then
		return false
	end

	if (root.Position - baseRoot.Position).Magnitude > DROP_DISTANCE then
		return false
	end

	local eggRoot = getEggRoot(egg)

	if eggRoot then

		local weld = eggRoot:FindFirstChild("TnhVN_CarryWeld")

		if weld then
			weld:Destroy()
		end

		eggRoot.CanCollide = true
		eggRoot.Massless = false
	end

	-- Đưa egg về base
	egg.Parent = base or workspace

	egg:SetAttribute("Taken", false)
	egg:SetAttribute("Stolen", false)
	egg:SetAttribute("OwnerUserId", player.UserId)

	-- Nếu game của bạn có Inventory thì xử lý tại đây
	local inventory = player:FindFirstChild("EggInventory")

	if inventory then
		local eggValue = Instance.new("StringValue")
		eggValue.Name = getEggName(egg)
		eggValue.Value = getEggName(egg)
		eggValue.Parent = inventory
	end

	data.Carrying = nil

	Remote:FireClient(player, "Carrying", false)

	return true
end

--==================================================
-- AUTO LOOP
--==================================================

local function autoStealLoop(player)

	task.spawn(function()

		while PlayerData[player] do

			local data = PlayerData[player]

			if not data.Enabled then
				task.wait(0.25)
				continue
			end

			if data.Carrying then

				local base = getPlayerBase(player)
				local baseRoot = getBaseRoot(base)

				if baseRoot then

					Remote:FireClient(player, "State", "Returning")

					moveTo(
						player,
						baseRoot.Position,
						data.Speed
					)

					if data.Enabled then
						dropEgg(player)
					end
				else
					Remote:FireClient(player, "Error", "Không tìm thấy Base của bạn.")
					task.wait(1)
				end

				continue
			end

			local egg = chooseEgg(player)

			if egg then

				local eggRoot = getEggRoot(egg)

				if eggRoot then

					Remote:FireClient(
						player,
						"Target",
						getEggName(egg)
					)

					Remote:FireClient(
						player,
						"State",
						"Going"
					)

					moveTo(
						player,
						eggRoot.Position,
						data.Speed
					)

					if not data.Enabled then
						continue
					end

					local _, _, root = getCharacter(player)

					if root and
						eggRoot.Parent and
						(root.Position - eggRoot.Position).Magnitude <= PICKUP_DISTANCE then

						local success = pickupEgg(player, egg)

						if success then
							Remote:FireClient(
								player,
								"State",
								"RUN!!"
							)
						end
					end
				end

				task.wait(0.15)

			else
				Remote:FireClient(
					player,
					"State",
					"Waiting"
				)

				task.wait(1)
			end
		end
	end)
end

--==================================================
-- REMOTE COMMANDS
--==================================================

Remote.OnServerEvent:Connect(function(player, command, ...)
	local data = PlayerData[player]

	if not data then
		return
	end

	if command == "Toggle" then

		local enabled = ...

		data.Enabled = enabled == true

		Remote:FireClient(
			player,
			"Enabled",
			data.Enabled
		)

	elseif command == "Speed" then

		local speed = tonumber(...)

		if speed then
			data.Speed = math.clamp(speed, 1, MAX_SPEED)
		end

	elseif command == "Targets" then

		local targets = ...

		if typeof(targets) == "table" then

			data.Targets = {}

			for name, enabled in pairs(targets) do
				if enabled == true then
					data.Targets[tostring(name)] = true
				end
			end
		end

	elseif command == "Drop" then

		dropEgg(player)

	elseif command == "Stop" then

		data.Enabled = false

		Remote:FireClient(
			player,
			"Enabled",
			false
		)
	end
end)

--==================================================
-- PLAYER
--==================================================

Players.PlayerAdded:Connect(function(player)

	PlayerData[player] = {
		Enabled = false,
		Speed = DEFAULT_SPEED,
		Targets = {},
		Carrying = nil
	}

	autoStealLoop(player)
end)

Players.PlayerRemoving:Connect(function(player)

	PlayerData[player] = nil
end)
