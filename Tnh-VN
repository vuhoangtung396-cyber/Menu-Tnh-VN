local function ScanEggs()
    local results = {}

    for _,object in ipairs(WS:GetDescendants()) do
        if object:IsA("BasePart") then
            local name = object.Name:lower()

            if name:find("egg",1,true)
            or name:find("trứng",1,true) then

                table.insert(results,{
                    Name = object.Name,
                    Position = object.Position
                })
            end
        end
    end

    return results
end

local function UpdateEggList()
    local eggs = ScanEggs()

    if #eggs == 0 then
        EggText.Text = T("noEgg")
        return
    end

    local character = LP.Character
    local root = character and
        character:FindFirstChild("HumanoidRootPart")

    local output = {}

    for index,egg in ipairs(eggs) do
        if index > 20 then
            table.insert(
                output,
                "... +"..(#eggs-20).." egg"
            )
            break
        end

        local distance = 0

        if root then
            distance = math.floor(
                (egg.Position-root.Position).Magnitude
            )
        end

        table.insert(
            output,
            "• "..egg.Name.." ["..distance.."m]"
        )
    end

    EggText.Text = table.concat(output,"\n")
end

