-- ============================================================
-- MOVEMENT MANAGER (chống xung đột Farm/Loot)
-- ============================================================
local MovementManager = { owner = nil, tween = nil }

function MovementManager:acquire(owner)
    if self.owner and self.owner ~= owner then return false end
    self.owner = owner
    return true
end

function MovementManager:release(owner)
    if self.owner ~= owner then return end
    if self.tween then self.tween:Cancel(); self.tween = nil end
    self.owner = nil
end

function MovementManager:moveTo(owner, targetCFrame, duration)
    if self.owner ~= owner then return end
    local c = LocalPlayer.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if self.tween then self.tween:Cancel() end
    local info = TweenInfo.new(math.max(duration, 0.1), Enum.EasingStyle.Linear)
    self.tween = TweenService:Create(root, info, { CFrame = targetCFrame })
    self.tween:Play()
    self.tween.Completed:Wait()
    if self.tween then self.tween = nil end
end

-- ============================================================
-- AUTO FARM
-- ============================================================
local AutoFarm = { active = false, thread = nil, selectedType = nil }

local function getEnemySet()
    local set, types = {}, {}
    for _, m in ipairs(CollectionService:GetTagged("FarmableEnemy")) do
        if m:IsA("Model") and m:IsDescendantOf(Workspace) then
            set[m] = true; types[m.Name] = true
        end
    end
    if next(set) then return set, types end
    local folder = Workspace:FindFirstChild(CONFIG.FallbackEnemyFolder)
    if folder then
        for _, m in ipairs(folder:GetChildren()) do
            if m:IsA("Model") then set[m] = true; types[m.Name] = true end
        end
    end
    return set, types
end

local function isAlive(model)
    if not model or not model.Parent then return false end
    local h = model:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function findNearestEnemy(enemyType)
    local set = getEnemySet()
    local c = LocalPlayer.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestDist = nil, math.huge
    for m in pairs(set) do
        if isAlive(m) and m.Name == enemyType then
            local hrp = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
            if hrp then
                local d = (hrp.Position - root.Position).Magnitude
                if d < bestDist then best, bestDist = m, d end
            end
        end
    end
    return best
end

-- >>> KẾT NỐI VỚI HỆ THỐNG COMBAT CỦA BẠN <<<
-- Ví dụ: tool:Activate() hoặc RemoteEvent có sẵn của game.
-- KHÔNG tự tạo RemoteEvent.
local function attackTarget(target)
    if not target or not target.Parent then return end
    local hum = target:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    -- TODO: gọi hệ thống combat tại đây (ví dụ kích hoạt tool đang cầm)
end

function AutoFarm:start()
    if self.thread then return end
    self.thread = task.spawn(function()
        while self.active do
            local ok, err = pcall(function()
                if not self.selectedType then
                    task.wait(CONFIG.TargetSearchInterval); return
                end
                local target = findNearestEnemy(self.selectedType)
                if not target then
                    farmStatus.Text = "Auto Farm: Đang chờ kẻ địch xuất hiện"
                    task.wait(CONFIG.TargetSearchInterval); return
                end
                local hrp = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
                if not hrp then task.wait(0.2); return end
                farmStatus.Text = "Auto Farm: Đang tấn công " .. target.Name
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not myRoot then task.wait(0.2); return end
                local goalPos = hrp.Position + Vector3.new(0, CONFIG.EnemyHeightOffset, 0)
                local dist = (myRoot.Position - goalPos).Magnitude
                if dist > 3 then
                    local dur = dist / CONFIG.TweenSpeed
                    MovementManager:moveTo("AutoFarm", CFrame.new(goalPos, hrp.Position), dur)
                else
                    myRoot.CFrame = CFrame.new(goalPos, hrp.Position)
                    task.wait(CONFIG.TargetSearchInterval)
                end
                attackTarget(target)
            end)
            if not ok then warn("[AutoFarm]", err) end
            task.wait(0.1)
        end
        self.thread = nil
    end)
end

function AutoFarm:enable()
    if self.active then return end
    if not self.selectedType then
        notify("Hãy chọn loại kẻ địch trước!", true)
        return false
    end
    if AutoLoot.active then
        AutoLoot:disable(); AutoLootToggle.Set(false)
        notify("Đã tắt Auto Loot (xung đột di chuyển)", false)
    end
    if not MovementManager:acquire("AutoFarm") then
        notify("Movement đang bị chiếm bởi Auto Loot", true)
        return false
    end
    self.active = true
    NoclipManager.request("AutoFarm")
    self:start()
    return true
end

function AutoFarm:disable()
    if not self.active then return end
    self.active = false
    NoclipManager.release("AutoFarm")
    MovementManager:release("AutoFarm")
    farmStatus.Text = "Auto Farm: Tắt"
end

-- ============================================================
-- AUTO LOOT
-- ============================================================
local AutoLoot = { active = false, thread = nil, selectedTags = {} }

local function getLootPosition(item)
    if item:IsA("BasePart") then return item.Position end
    if item:IsA("Model") then
        local pp = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
        return pp and pp.Position
    end
    return nil
end

local function findNearestLoot(tagSet)
    local c = LocalPlayer.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestDist = nil, math.huge
    for _, tag in ipairs(CONFIG.LootTags) do
        if tagSet[tag] then
            for _, item in ipairs(CollectionService:GetTagged(tag)) do
                if item:IsDescendantOf(Workspace) then
                    local pos = getLootPosition(item)
                    if pos then
                        local d = (pos - root.Position).Magnitude
                        if d < bestDist then best, bestDist = item, d end
                    end
                end
            end
        end
    end
    return best
end

-- >>> KẾT NỐI VỚI HỆ THỐNG LOOT CỦA BẠN <<<
-- Thử dùng ProximityPrompt có sẵn. Không tạo RemoteEvent.
local function collectLoot(item)
    if not item or not item.Parent then return end
    local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        local oldHold = prompt.HoldDuration
        prompt.HoldDuration = 0
        prompt:InputHoldBegin()
        task.wait()
        prompt:InputHoldEnd()
        prompt.HoldDuration = oldHold
        return
    end
    -- ClickDetector không thể kích hoạt từ client; cần hệ thống riêng của game.
end

function AutoLoot:start()
    if self.thread then return end
    self.thread = task.spawn(function()
        while self.active do
            local ok, err = pcall(function()
                local tagSet = self.selectedTags
                if not next(tagSet) then
                    lootStatus.Text = "Auto Loot: Chưa chọn loại loot"
                    task.wait(CONFIG.TargetSearchInterval); return
                end
                local item = findNearestLoot(tagSet)
                if not item then
                    lootStatus.Text = "Auto Loot: Đang chờ loot xuất hiện"
                    task.wait(CONFIG.TargetSearchInterval); return
                end
                local pos = getLootPosition(item)
                if not pos then task.wait(0.2); return end
                lootStatus.Text = "Auto Loot: Tiếp cận " .. item.Name
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not myRoot then task.wait(0.2); return end
                local goal = pos + Vector3.new(0, 2, 0)
                local dist = (myRoot.Position - goal).Magnitude
                if dist > CONFIG.LootStopDistance then
                    local dur = dist / CONFIG.TweenSpeed
                    MovementManager:moveTo("AutoLoot", CFrame.new(goal), dur)
                end
                collectLoot(item)
                task.wait(0.2)
            end)
            if not ok then warn("[AutoLoot]", err) end
            task.wait(0.1)
        end
        self.thread = nil
    end)
end

function AutoLoot:enable()
    if self.active then return end
    if not next(self.selectedTags) then
        notify("Hãy chọn ít nhất một loại loot!", true)
        return false
    end
    if AutoFarm.active then
        AutoFarm:disable(); AutoFarmToggle.Set(false)
        notify("Đã tắt Auto Farm (xung đột di chuyển)", false)
    end
    if not MovementManager:acquire("AutoLoot") then
        notify("Movement đang bị chiếm bởi Auto Farm", true)
        return false
    end
    self.active = true
    NoclipManager.request("AutoLoot")
    self:start()
    return true
end

function AutoLoot:disable()
    if not self.active then return end
    self.active = false
    NoclipManager.release("AutoLoot")
    MovementManager:release("AutoLoot")
    lootStatus.Text = "Auto Loot: Tắt"
end

