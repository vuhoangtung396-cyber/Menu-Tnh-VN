    local ESPGui = Instance.new("ScreenGui")
    ESPGui.Name = "TnhVN_ESP"
    ESPGui.ResetOnSpawn = false
    ESPGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ESPGui.Parent = game:GetService("CoreGui")

    local ESPObjects = {}

    local function RemoveESP(obj)

        local data = ESPObjects[obj]

        if data then

            for _,v in pairs(data) do
                pcall(function()
                    v:Destroy()
                end)
            end

            ESPObjects[obj] = nil
        end
    end

    local function ClearAllESP()

        for obj in pairs(ESPObjects) do
            RemoveESP(obj)
        end
    end

    local function CreateESP(obj)

        if ESPObjects[obj] then
            return ESPObjects[obj]
        end

        local box = Instance.new("Frame")
        box.BackgroundTransparency = 1
        box.BorderSizePixel = 0
        box.Visible = false
        box.Parent = ESPGui

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 2
        stroke.Parent = box

        local name = Instance.new("TextLabel")
        name.BackgroundTransparency = 1
        name.TextSize = 12
        name.Font = Enum.Font.GothamBold
        name.TextStrokeTransparency = 0
        name.Visible = false
        name.Parent = ESPGui

        local dist = Instance.new("TextLabel")
        dist.BackgroundTransparency = 1
        dist.TextSize = 11
        dist.Font = Enum.Font.Gotham
        dist.TextStrokeTransparency = 0
        dist.Visible = false
        dist.Parent = ESPGui

        ESPObjects[obj] = {
            box = box,
            stroke = stroke,
            name = name,
            dist = dist
        }

        return ESPObjects[obj]
    end

    local function IsESPObject(obj)

        if not obj:IsA("BasePart") then
            return false
        end

        local n = obj.Name:lower()

        return
            n:find("egg",1,true)
            or n:find("trung",1,true)
            or n:find("pet",1,true)
            or n:find("nest",1,true)

    end

    Connect(RunService.RenderStepped,function()

        if not State.ESP then
            return
        end

        local Camera = Workspace.CurrentCamera

        if not Camera then
            return
        end

        local Seen = {}

        for _,obj in ipairs(Workspace:GetDescendants()) do

            if IsESPObject(obj) then

                Seen[obj] = true

                local data = CreateESP(obj)

                local screenPos,visible =
                    Camera:WorldToViewportPoint(obj.Position)

                if visible then

                    local distance =
                        (Camera.CFrame.Position - obj.Position).Magnitude

                    local size =
                        math.clamp(3000 / math.max(distance,1),35,130)

                    data.box.Position = UDim2.fromOffset(
                        screenPos.X-size/2,
                        screenPos.Y-size/2
                    )

                    data.box.Size =
                        UDim2.fromOffset(size,size)

                    data.stroke.Color = State.ESPColor
                    data.box.Visible = true

                    data.name.Text = obj.Name
                    data.name.TextColor3 = State.ESPColor
                    data.name.Position = UDim2.fromOffset(
                        screenPos.X-size/2,
                        screenPos.Y-size/2-22
                    )
                    data.name.Size = UDim2.fromOffset(size,20)
                    data.name.Visible = State.ESPShowName

                    data.dist.Text =
                        math.floor(distance).." studs"

                    data.dist.TextColor3 = State.ESPColor
                    data.dist.Position = UDim2.fromOffset(
                        screenPos.X-size/2,
                        screenPos.Y+size/2
                    )
                    data.dist.Size =
                        UDim2.fromOffset(size,18)

                    data.dist.Visible = State.ESPShowDist

                else

                    data.box.Visible = false
                    data.name.Visible = false
                    data.dist.Visible = false

                end
            end
        end

        for obj in pairs(ESPObjects) do

            if not Seen[obj]
            or not obj.Parent then

                RemoveESP(obj)
            end
        end

    end)

