RS.RenderStepped:Connect(function()
    local camera = WS.CurrentCamera

    if not S.ESP or not camera then
        for _,obj in pairs(ESPObjects) do
            obj.Box.Visible = false
            obj.Name.Visible = false
        end
        return
    end

    local myCharacter = LP.Character
    local myRoot = myCharacter and
        myCharacter:FindFirstChild("HumanoidRootPart")

    for player,obj in pairs(ESPObjects) do
        local character = player.Character

        if not character then
            obj.Box.Visible = false
            obj.Name.Visible = false
            continue
        end

        local head = character:FindFirstChild("Head")
        local root = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")

        if not head or not root or not humanoid
        or humanoid.Health <= 0 then
            obj.Box.Visible = false
            obj.Name.Visible = false
            continue
        end

        local topPos = head.Position + Vector3.new(0,.6,0)
        local bottomPos = root.Position - Vector3.new(0,2.8,0)

        local top,onTop = camera:WorldToViewportPoint(topPos)
        local bottom,onBottom = camera:WorldToViewportPoint(bottomPos)

        if not onTop or not onBottom
        or top.Z <= 0
        or bottom.Z <= 0 then
            obj.Box.Visible = false
            obj.Name.Visible = false
            continue
        end

        local height = math.abs(bottom.Y-top.Y)
        local width = math.min(height*.62,300)

        if height <= 4 or width <= 4 then
            obj.Box.Visible = false
            obj.Name.Visible = false
            continue
        end

        local centerX = (top.X+bottom.X)/2
        local left = centerX-width/2
        local topY = math.min(top.Y,bottom.Y)

        obj.Box.Position = UDim2.new(0,left,0,topY)
        obj.Box.Size = UDim2.new(0,width,0,height)
        obj.Box.Visible = true

        obj.Stroke.Color = S.ESPColor
        obj.Name.TextColor3 = S.ESPColor

        local distance = 0

        if myRoot then
            distance = math.floor(
                (root.Position-myRoot.Position).Magnitude
            )
        end

        obj.Name.Text =
            player.Name.." ["..distance.."m]"

        obj.Name.Position =
            UDim2.new(0,left-60,0,topY-20)

        obj.Name.Size =
            UDim2.new(0,width+120,0,18)

        obj.Name.Visible = true
    end
end)

