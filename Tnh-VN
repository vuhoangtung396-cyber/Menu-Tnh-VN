local function SLock(eggPart)
    SLk()
    LCk=RS.Heartbeat:Connect(function()
        if not S.AutoSteal then return end
        local c=LP.Character
        if not c then return end
        local r=c:FindFirstChild("HumanoidRootPart")
        if not r then return end
        if eggPart and eggPart.Parent then
            local pos=eggPart.Position+Vector3.new(0,3,0)
            if (r.Position-pos).Magnitude>5 then r.CFrame=CFrame.new(pos) end
            r.AssemblyLinearVelocity=Vector3.zero
            r.AssemblyAngularVelocity=Vector3.zero
        end
    end)
end
local function RSt() SLk();URag();CTg=nil;ATm=0 end
local function SAS()
    S.AutoSteal=true
    StatL.Text=T("stat")..": "..T("on");StatL.TextColor3=P.Success
    FB();Rag=false;FBk=false;CTg=nil;ATm=0;LTP=0
    if ASC then ASC:Disconnect() end
    ASC=RS.Heartbeat:Connect(function()
        if not S.AutoSteal then return end
        if FBk then return end
        local c=LP.Character
        local r=c and c:FindFirstChild("HumanoidRootPart")
        local h=c and c:FindFirstChildOfClass("Humanoid")
        if not r or not h then return end
        if h.Health<=0 then RSt();return end
        if ICE() then
            SLk()
            StatL.Text=T("stat")..": Đang bay về Base...";StatL.TextColor3=P.Gold
            task.spawn(function() FlyB() end)
            return
        end
        if CTg and (tick()-ATm>MAT) then RSt() end
        if CTg and Rag then
            local tp=CTg.part
            if tp and tp.Parent then
                StatL.Text=T("stat")..": Đang nhặt "..(CTg.real or CTg.name)
                StatL.TextColor3=P.Gold
                local pos=tp.Position+Vector3.new(0,3,0)
                r.CFrame=CFrame.new(pos)
                r.AssemblyLinearVelocity=Vector3.zero
                if tick()-LTP>(0.15+math.random(0,10)/100) then
                    LTP=tick()
                    pcall(function() TP(tp) end)
                end
                return
            else RSt() end
        end
        local t=FNE()
        if not t then
            StatL.Text=T("stat")..": Không có trứng match";StatL.TextColor3=P.Danger
            return
        end
        CTg=t;ATm=tick()
        StatL.Text=T("stat")..": → "..(t.real or t.name).." ("..((t.info or {}).income or "?")..")"
        StatL.TextColor3=P.Gold
        TTE(t.part);SLock(t.part)
    end)
end
local function SASstop()
    S.AutoSteal=false
    if ASC then ASC:Disconnect();ASC=nil end
    SLk();URag();CTg=nil;FBk=false;ATm=0
    StatL.Text=T("stat")..": "..T("off");StatL.TextColor3=P.TextMute
end
