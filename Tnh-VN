        for _,o in ipairs(WS:GetDescendants()) do DT(o) end
        ATC=WS.DescendantAdded:Connect(function(o) if S.AntiTrap then DT(o) end end)
    else
        if ATC then ATC:Disconnect();ATC=nil end
        for o,vv in pairs(DTs) do
            if o.Parent then pcall(function() o.CanCollide=vv.CC;o.CanTouch=vv.CT end) end
        end
        DTs={}
    end
end)

