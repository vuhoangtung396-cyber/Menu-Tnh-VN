		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = CONFIG.Esp.HealthHighColor,
		BorderSizePixel = 0,
	}, barBack)
	return billboard, nameLabel, infoLabel, barFill
end

local function removeEspEntry(player)
	local entry = esp.entries[player]
	if entry then
		esp.entries[player] = nil
		entry.maid.clean()
	end
end

local function createEspEntry(player, character, humanoid, head)
	removeEspEntry(player)
	local maid = createMaid()
	local highlight = maid.add(create("Highlight", {
		Name = "EspHighlight",
		Adornee = character,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		FillTransparency = CONFIG.Esp.FillTransparency,
		OutlineTransparency = CONFIG.Esp.OutlineTransparency,
	}, character))
	local billboard, nameLabel, infoLabel, barFill = createEspBillboard(head)
	maid.add(billboard)
	billboard.Parent = ui.gui
	nameLabel.Text = player.DisplayName
	esp.entries[player] = {
		maid = maid,
		highlight = highlight,
		billboard = billboard,
		nameLabel = nameLabel,
		infoLabel = infoLabel,
		barFill = barFill,
		humanoid = humanoid,
		head = head,
	}
end

local function formatEspInfo(humanoid, distance)
	local parts = {}
	if CONFIG.Esp.ShowHealth then
		local health = math.floor(math.clamp(humanoid.Health, 0, 1e9))
		local maxHealth = math.floor(math.clamp(humanoid.MaxHealth, 0, 1e9))
		parts[#parts + 1] = string.format("%d/%d HP", health, maxHealth)
	end
	if CONFIG.Esp.ShowDistance then
		parts[#parts + 1] = string.format("%d studs", math.floor(math.clamp(distance, 0, 1e9)))
	end
	return table.concat(parts, " | ")
end

local function updateEspEntry(player, entry)
	local humanoid = entry.humanoid
	if not humanoid.Parent or not entry.head.Parent then
		removeEspEntry(player)
		return
	end
	local visible = humanoid.Health > 0 and shouldShowEsp(player)
	entry.highlight.Enabled = visible
	entry.billboard.Enabled = visible
	if not visible then
		return
	end
	local color = isSameTeam(player) and CONFIG.Esp.TeamColor or CONFIG.Esp.EnemyColor
	entry.highlight.FillColor = color
	entry.highlight.OutlineColor = color
	entry.nameLabel.TextColor3 = color
	local localRoot = getRootPart()
	local distance = localRoot and (localRoot.Position - entry.head.Position).Magnitude or 0
	entry.infoLabel.Text = formatEspInfo(humanoid, distance)
	local maxHealth = humanoid.MaxHealth
	local ratio = (maxHealth > 0 and maxHealth < 1e9) and math.clamp(humanoid.Health / maxHealth, 0, 1) or 1
	entry.barFill.Size = UDim2.fromScale(ratio, 1)
	entry.barFill.BackgroundColor3 = CONFIG.Esp.HealthLowColor:Lerp(CONFIG.Esp.HealthHighColor, ratio)
end

local function espStep(dt)
	esp.elapsed += dt
	if esp.elapsed < CONFIG.Esp.UpdateInterval then
		return
	end
	esp.elapsed = 0
	for player, entry in pairs(esp.entries) do
		updateEspEntry(player, entry)
	end
end

local function buildEspForCharacter(player, character)
	local generation = esp.generation
	local humanoid = character:WaitForChild("Humanoid", 10)
	local head = character:WaitForChild("Head", 10)
	local stale = generation ~= esp.generation or not esp.enabled or player.Character ~= character
	if stale or not humanoid or not head then
		return
	end
	createEspEntry(player, character, humanoid, head)
end

local function hookEspPlayer(player)
	if player == localPlayer or esp.playerMaids[player] then
		return
	end
	local maid = createMaid()
	esp.playerMaids[player] = maid
	maid.add(player.CharacterAdded:Connect(function(character)
		task.spawn(buildEspForCharacter, player, character)
	end))
	maid.add(player.CharacterRemoving:Connect(function()
		removeEspEntry(player)
	end))
	if player.Character then
		task.spawn(buildEspForCharacter, player, player.Character)
	end
end

local function unhookEspPlayer(player)
	removeEspEntry(player)
	local maid = esp.playerMaids[player]
	if maid then
		esp.playerMaids[player] = nil
		maid.clean()
	end
end

local function enableEsp()
	esp.enabled = true
	esp.generation += 1
	esp.elapsed = 0
	esp.maid = createMaid()
	esp.maid.add(Players.PlayerAdded:Connect(hookEspPlayer))
	esp.maid.add(Players.PlayerRemoving:Connect(unhookEspPlayer))
	esp.maid.add(RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(espStep, dt)
		if not ok then
			handleLoopError("Esp", err)
		end
	end))
	for _, player in ipairs(Players:GetPlayers()) do
		hookEspPlayer(player)
	end
	return true
end

local function disableEsp()
	esp.enabled = false
	esp.generation += 1
	if esp.maid then
		esp.maid.clean()
		esp.maid = nil
	end
	for player in pairs(esp.playerMaids) do
		unhookEspPlayer(player)
	end
	for player in pairs(esp.entries) do
		removeEspEntry(player)
	end
end

