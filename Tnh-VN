  or o:IsA("Fire") or o:IsA("Sparkles") or o:IsA("PointLight")
  or o:IsA("SpotLight") or o:IsA("SurfaceLight") then
    if Saved[o]==nil then Saved[o]=o.Enabled end
    pcall(function() o.Enabled=false end)
  end
  if o:IsA("BasePart") then
    if Saved[o]==nil then Saved[o]={CS=o.CastShadow,MT=o.Material} end
    pcall(function()
      o.CastShadow=false
      if o.Material~=Enum.Material.Water then o.Material=Enum.Material.Plastic end
    end)
  end
end
local function SXF()
  S.FixLag=true
  for _,o in ipairs(WS:GetDescendants()) do DE(o) end
  pcall(function()
    Saved.GS=Lighting.GlobalShadows;Lighting.GlobalShadows=false
    Saved.EDS=Lighting.EnvironmentDiffuseScale;Lighting.EnvironmentDiffuseScale=0
    Saved.ESS=Lighting.EnvironmentSpecularScale;Lighting.EnvironmentSpecularScale=0
    Saved.BR=Lighting.Brightness;Lighting.Brightness=1
  end)
  if WS.Terrain then
    pcall(function()
      Saved.WWS=WS.Terrain.WaterWaveSize;WS.Terrain.WaterWaveSize=0
      Saved.WWP=WS.Terrain.WaterWaveSpeed;WS.Terrain.WaterWaveSpeed=0
      Saved.WR=WS.Terrain.WaterReflectance;WS.Terrain.WaterReflectance=0
    end)
  end
  XC=WS.DescendantAdded:Connect(function(o) if S.FixLag then DE(o) end end)
end
local function SPF()
  S.FixLag=false
  if XC then XC:Disconnect();XC=nil end
  for o,v in pairs(Saved) do
    if typeof(o)=="Instance" and o.Parent then
      pcall(function()
        if type(v)=="table" then
          if v.CS~=nil then o.CastShadow=v.CS end
          if v.MT~=nil then o.Material=v.MT end
        elseif type(v)=="boolean" then o.Enabled=v end
      end)
    end
  end
  pcall(function()
    if Saved.GS~=nil then Lighting.GlobalShadows=Saved.GS end
    if Saved.EDS~=nil then Lighting.EnvironmentDiffuseScale=Saved.EDS end
    if Saved.ESS~=nil then Lighting.EnvironmentSpecularScale=Saved.ESS end
    if Saved.BR~=nil then Lighting.Brightness=Saved.BR end
  end)
  Saved={}
end
