-- AUTO STEAL
--==================================================

local AutoRunning = false

local function IsEggPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then
        return false
    end

    local action = string.lower(tostring(prompt.ActionText or ""))
    local object = string.lower(tostring(prompt.ObjectText or ""))
    local name = string.lower(tostring(prompt.Parent and prompt.Parent.Name or ""))

    local text = action .. " " .. object .. " " .. name

    return
        string.find(text, "egg") ~= nil
        or string.find(text, "steal") ~= nil
        or string.find(text, "take") ~= nil
        or string.find(text, "grab") ~= nil
        or string.find(text, "trung") ~= nil
end

local function GetPromptPosition(prompt)
    if not prompt then
        return nil
    end

    local parent = prompt.Parent

    if parent:IsA("Attachment") then
        return parent.WorldPosition
    end

    if parent:IsA("BasePart") then
        return parent.Position
    end

    if parent:IsA("Model") then
        local part = parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart")
        if part then
            return part.Position
        end
    end

    local ancestor = prompt:FindFirstAncestorOfClass("Model")
    if ancestor then
        local part = ancestor.PrimaryPart or ancestor:FindFirstChildWhichIsA("BasePart")
        if part then
            return part.Position
        end
    end

    return nil
end

local function FindNearestEggPrompt()
    if not Root then
        return nil
    end

    local nearest
    local nearestDistance = math.huge

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and IsEggPrompt(obj) and obj.Enabled then

            local pos = GetPromptPosition(obj)

            if pos then
                local distance = (Root.Position - pos).Magnitude

                if distance < nearestDistance then
                    nearestDistance = distance
                    nearest = obj
                end
            end
        end
    end

    return nearest
end

local function TriggerPrompt(prompt)
    if not prompt then
        return
    end

    pcall(function()
        fireproximityprompt(prompt)
    end)
end

local function MoveToPosition(position)
    if not Root then
        GetCharacter()
    end

    if not Root or not position then
        return false
    end

    local distance = (Root.Position - position).Magnitude

    if distance <= 8 then
        return true
    end

    local speed = math.clamp(State.SpeedValue, 1, 500)

    local duration = math.clamp(distance / speed, 0.15, 3)

    local tween = TweenService:Create(
        Root,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        ),
        {
            CFrame = CFrame.new(position + Vector3.new(0,2.5,0))
        }
    )

    tween:Play()

    local finished = false

    local connection
    connection = tween.Completed:Connect(function()
        finished = true
    end)

    local start = os.clock()

    while not finished and os.clock() - start < duration + 0.5 do
        if not State.AutoSteal or State.Destroyed then
            tween:Cancel()
            break
        end

        task.wait()
    end

    pcall(function()
        connection:Disconnect()
    end)

    return true
end

local function FindBasePosition()
    local keywords = {
        "base",
        "home",
        "plot",
        "pen",
        "island",
        "spawn"
    }

    local best
    local bestDistance = math.huge

    for _, obj in ipairs(Workspace:GetDescendants()) do

        if obj:IsA("BasePart") or obj:IsA("SpawnLocation") then

            local name = string.lower(obj.Name)

            for _, keyword in ipairs(keywords) do
                if string.find(name, keyword) then

                    local distance = Root and
                        (Root.Position - obj.Position).Magnitude
                        or math.huge

                    if distance < bestDistance then
                        bestDistance = distance
                        best = obj
                    end

                    break
                end
            end
        end
    end

    return best
end

local function AutoStealLoop()
    if AutoRunning then
        return
    end

    AutoRunning = true

    task.spawn(function()

        while State.AutoSteal and not State.Destroyed do

            GetCharacter()

            if not Root then
                task.wait(1)
                continue
            end

            local prompt = FindNearestEggPrompt()

            if prompt then

                local position = GetPromptPosition(prompt)

                if position then

                    MoveToPosition(position)

                    if State.AutoSteal then
                        task.wait(0.15)

                        TriggerPrompt(prompt)

                        task.wait(0.5)

                        -- tìm base gần nhất
                        local base = FindBasePosition()

                        if base then
                            MoveToPosition(base.Position)
                        end
                    end
                end
            else
                task.wait(0.5)
            end

            task.wait(0.2)
        end

        AutoRunning = false
    end)
end

