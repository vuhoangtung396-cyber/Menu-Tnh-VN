--==================================================
-- FIX LAG
--==================================================

local function saveVisual(instance, property, value)
	State.OriginalVisuals[instance] =
		State.OriginalVisuals[instance] or {}

	if State.OriginalVisuals[instance][property] == nil then
		State.OriginalVisuals[instance][property] = value
	end
end

local function processVisual(instance)
	if not State.FixLag then
		return
	end

	if instance:IsA("ParticleEmitter")
		or instance:IsA("Trail")
		or instance:IsA("Beam")
		or instance:IsA("Smoke")
		or instance:IsA("Fire")
		or instance:IsA("Sparkles")
		or instance:IsA("PointLight")
		or instance:IsA("SpotLight")
		or instance:IsA("SurfaceLight")
		or instance:IsA("PostEffect") then

		saveVisual(instance, "Enabled", instance.Enabled)
		instance.Enabled = false
	end
end

local function restoreVisuals()
	for instance, properties in pairs(State.OriginalVisuals) do
		if instance and instance.Parent then
			for property, value in pairs(properties) do
				instance[property] = value
			end
		end
	end

	State.OriginalVisuals = {}
end

local function setFixLag(enabled)
	State.FixLag = enabled

	if enabled then
		for _, instance in ipairs(game:GetDescendants()) do
			processVisual(instance)
		end

		disconnect(State.Connections.FixLagAdded)

		State.Connections.FixLagAdded =
			game.DescendantAdded:Connect(function(instance)
				task.defer(processVisual, instance)
			end)

		return
	end

	disconnect(State.Connections.FixLagAdded)
	State.Connections.FixLagAdded = nil

	restoreVisuals()
end

--==================================================
-- NOCLIP
--==================================================

local function noclipRequired()
	return State.Noclip
		or next(State.NoclipRequests) ~= nil
end

local function applyNoclip()
	if not noclipRequired() then
		return
	end

	local character = getCharacter()

	if not character then
		return
	end

	for _, instance in ipairs(character:GetDescendants()) do
		if instance:IsA("BasePart") then
			if State.OriginalCollision[instance] == nil then
				State.OriginalCollision[instance] =
					instance.CanCollide
			end

			instance.CanCollide = false
		end
	end
end

local function restoreNoclip()
	for part, original in pairs(State.OriginalCollision) do
		if part and part.Parent then
			part.CanCollide = original
		end
	end

	State.OriginalCollision = {}
end

local function updateNoclip()
	if noclipRequired() then
		applyNoclip()
	else
		restoreNoclip()
	end
end

local function requestNoclip(source)
	State.NoclipRequests[source] = true
	updateNoclip()
end

local function releaseNoclip(source)
	State.NoclipRequests[source] = nil
	updateNoclip()
end

--==================================================
-- ENEMY DISCOVERY
--==================================================

local function getTaggedEnemies()
	local result = {}

	for _, instance in ipairs(
		CollectionService:GetTagged(CONFIG.Farm.EnemyTag)
	) do
		if instance:IsDescendantOf(workspace) then
			table.insert(result, instance)
		end
	end

	return result
end

local function getFallbackEnemies()
	local folder =
		workspace:FindFirstChild(
			CONFIG.FallbackEnemyFolder
		)

	if not folder then
		return {}
	end

	local result = {}

	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("Model") then
			table.insert(result, child)
		end
	end

	return result
end

local function getEnemyPool()
	local tagged = getTaggedEnemies()

	if #tagged > 0 then
		return tagged
	end

	return getFallbackEnemies()
end

local function getEnemyName(enemy)
	if enemy:IsA("Model") then
		return enemy.Name
	end

	return enemy.Name
end

local function getEnemyTypes()
	local names = {}
	local seen = {}

	for _, enemy in ipairs(getEnemyPool()) do
		local name = getEnemyName(enemy)

		if not seen[name] then
			seen[name] = true
			table.insert(names, name)
		end
	end

	table.sort(names)

	return names
end

local function getEnemyRoot(enemy)
	if not enemy then
		return nil
	end

	if enemy:IsA("Model") then
		return enemy:FindFirstChild("HumanoidRootPart")
			or enemy.PrimaryPart
			or enemy:FindFirstChildWhichIsA("BasePart")
	end

	return enemy:FindFirstChildWhichIsA("BasePart")
end

local function getEnemyHumanoid(enemy)
	if not enemy then
		return nil
	end

	return enemy:FindFirstChildOfClass("Humanoid")
end

local function validEnemy(enemy)
	local humanoid = getEnemyHumanoid(enemy)
	local root = getEnemyRoot(enemy)

	return enemy
		and enemy.Parent
		and enemy:IsDescendantOf(workspace)
		and humanoid
		and humanoid.Health > 0
		and root
end

--==================================================
-- FIND NEAREST ENEMY
--==================================================

local function findNearestEnemy(enemyType)
	local playerRoot = getRoot()

	if not playerRoot or not enemyType then
		return nil
	end

	local nearest = nil
	local nearestDistance = math.huge

	for _, enemy in ipairs(getEnemyPool()) do
		if validEnemy(enemy)
			and getEnemyName(enemy) == enemyType then

			local enemyRoot = getEnemyRoot(enemy)

			local distance =
				(playerRoot.Position - enemyRoot.Position).Magnitude

			if distance < nearestDistance then
				nearest = enemy
				nearestDistance = distance
			end
		end
	end

	return nearest
end

--==================================================
-- FARM MOVEMENT
--==================================================

local function tweenTo(position, speed)
	local root = getRoot()

	if not root then
		return false
	end

	cancelTween()

	local distance = (root.Position - position).Magnitude

	if distance < 1 then
		return true
	end

	local duration = math.max(
		distance / math.max(speed, 1),
		0.05
	)

	local tweenInfo = TweenInfo.new(
		duration,
		Enum.EasingStyle.Linear,
		Enum.EasingDirection.Out
	)

	State.ActiveTween =
		TweenService:Create(
			root,
			tweenInfo,
			{ CFrame = CFrame.new(position) }
		)

	State.ActiveTween:Play()

	local completed = false

	local connection

	connection = State.ActiveTween.Completed:Connect(function()
		completed = true
	end)

	while State.ActiveTween
		and not completed
		and State.AutoFarm do

		task.wait()
	end

	disconnect(connection)

	return completed
end

local function moveAboveEnemy(enemy)
	local root = getEnemyRoot(enemy)

	if not root then
		return false
	end

	local targetPosition =
		root.Position
		+ Vector3.new(0, CONFIG.Farm.Height, 0)

	local targetCFrame =
		CFrame.lookAt(
			targetPosition,
			root.Position
		)

	local characterRoot = getRoot()

	if not characterRoot then
		return false
	end

	cancelTween()

	local distance =
		(characterRoot.Position - targetPosition).Magnitude

	local duration =
		math.max(
			distance / CONFIG.Farm.TweenSpeed,
			0.05
		)

	State.ActiveTween =
		TweenService:Create(
			characterRoot,
			TweenInfo.new(
				duration,
				Enum.EasingStyle.Linear
			),
			{ CFrame = targetCFrame }
		)

	State.ActiveTween:Play()

	return true
end

